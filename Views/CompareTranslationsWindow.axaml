<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="https://github.com/avaloniaui/avaloniaedit"
        x:Class="CbetaTranslator.App.Views.CompareTranslationsWindow"
        Title="Compare Translations"
        Width="1200" Height="700"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    </Window.Styles>
    <Grid RowDefinitions="Auto,*">
        <!-- Header: shows file name -->
        <DockPanel Grid.Row="0" Margin="8">
            <TextBlock Name="TxtHeader" FontWeight="Bold" FontSize="14"
                       Text="Compare Translations" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- 3-pane content -->
        <Grid Grid.Row="1" ColumnDefinitions="1*,Auto,1*,Auto,1*">
            <!-- Pane 1: Original Chinese -->
            <Border Grid.Column="0" Margin="4">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="Original" FontWeight="Bold" Padding="8,4"
                               Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
                    <ae:TextEditor Grid.Row="1" Name="EditorOriginal"
                                   IsReadOnly="True" ShowLineNumbers="False"
                                   WordWrap="True"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns"/>

            <!-- Pane 2: Translation A -->
            <Border Grid.Column="2" Margin="4">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Name="TxtPaneAHeader" Text="Translation A" FontWeight="Bold" Padding="8,4"
                               Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
                    <ae:TextEditor Grid.Row="1" Name="EditorTransA"
                                   IsReadOnly="True" ShowLineNumbers="False"
                                   WordWrap="True"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="6" ResizeDirection="Columns"/>

            <!-- Pane 3: Translation B -->
            <Border Grid.Column="4" Margin="4">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Name="TxtPaneBHeader" Text="Translation B" FontWeight="Bold" Padding="8,4"
                               Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
                    <ae:TextEditor Grid.Row="1" Name="EditorTransB"
                                   IsReadOnly="True" ShowLineNumbers="False"
                                   WordWrap="True"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
