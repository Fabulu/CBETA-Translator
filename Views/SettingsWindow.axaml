<!-- Views/SettingsWindow.axaml -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ReadZen.App.ViewModels"
        x:Class="ReadZen.App.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Width="600" Height="720" MinHeight="500" CanResize="True"
        Background="{DynamicResource AppBg}"
        Title="Settings"
        WindowStartupLocation="CenterOwner">

	<Window.Styles>
		<Style Selector="Button">
			<Setter Property="Background" Value="{DynamicResource BtnBg}"/>
			<Setter Property="Foreground" Value="{DynamicResource BtnFg}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>

		<Style Selector="Button:pointerover">
			<Setter Property="Background" Value="{DynamicResource BtnBgHover}"/>
		</Style>

		<Style Selector="Button:pressed">
			<Setter Property="Background" Value="{DynamicResource BtnBgPressed}"/>
		</Style>

		<Style Selector="Button.primary">
			<Setter Property="Background" Value="{DynamicResource SelectionBg}"/>
			<Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
		</Style>

		<Style Selector="TextBlock.muted">
			<Setter Property="Foreground" Value="{DynamicResource TextMutedFg}"/>
		</Style>

		<Style Selector="RadioButton">
			<Setter Property="Foreground" Value="{DynamicResource TextFg}"/>
		</Style>

		<Style Selector="CheckBox">
			<Setter Property="Foreground" Value="{DynamicResource TextFg}"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="Auto,*,Auto" Margin="20">
		<!-- Header -->
		<StackPanel Grid.Row="0" Margin="0,0,0,16">
			<TextBlock Text="Settings"
			           FontSize="24"
			           FontWeight="Bold"
			           Foreground="{DynamicResource TextFg}"/>
		</StackPanel>

		<!-- Content -->
		<Border Grid.Row="1"
		        Background="{DynamicResource ControlBg}"
		        BorderBrush="{DynamicResource BorderBrush}"
		        BorderThickness="1"
		        CornerRadius="6"
		        Padding="18">
			<ScrollViewer VerticalScrollBarVisibility="Auto"
			              HorizontalScrollBarVisibility="Disabled">
			<StackPanel Spacing="16">

				<!-- Theme -->
				<StackPanel Spacing="8">
					<TextBlock Text="Theme"
					           FontSize="14"
					           FontWeight="SemiBold"
					           Foreground="{DynamicResource TextFg}"/>

					<StackPanel Orientation="Horizontal" Spacing="18">
						<RadioButton Content="Light"
						             VerticalAlignment="Center"
						             IsChecked="{Binding !IsDarkTheme}"/>
						<RadioButton Content="Dark"
						             VerticalAlignment="Center"
						             IsChecked="{Binding IsDarkTheme}"/>
					</StackPanel>
				</StackPanel>

				<!-- Divider -->
				<Border Height="1"
				        Background="{DynamicResource BorderBrush}"
				        Opacity="0.5"
				        Margin="0,2,0,2"/>

				<!-- Hover dictionary checkbox -->
				<CheckBox Content="Enable hover dictionary in reader"
				          VerticalAlignment="Top"
				          IsChecked="{Binding EnableHoverDictionary}"/>

				<!-- Divider -->
				<Border Height="1"
				        Background="{DynamicResource BorderBrush}"
				        Opacity="0.5"
				        Margin="0,2,0,2"/>

				<!-- Username -->
				<StackPanel Spacing="6">
					<TextBlock Text="Your name (used in reviews)"
					           FontSize="14"
					           FontWeight="SemiBold"
					           Foreground="{DynamicResource TextFg}"/>
					<TextBox MaxLength="64"
					         Watermark="Enter your name…"
					         Text="{Binding Username}"/>
					<TextBlock Text="Name cannot be empty."
					           Foreground="{DynamicResource ErrorFg}"
					           FontSize="12"
					           IsVisible="{Binding ShowUsernameError}"/>
				</StackPanel>

				<!-- Divider -->
				<Border Height="1"
				        Background="{DynamicResource BorderBrush}"
				        Opacity="0.5"
				        Margin="0,2,0,2"/>

				<!-- Onboarding tour -->
				<StackPanel Spacing="6">
					<TextBlock Text="Onboarding Tour"
					           FontSize="14"
					           FontWeight="SemiBold"
					           Foreground="{DynamicResource TextFg}"/>
					<CheckBox Content="Restart onboarding tour on next launch"
					          IsChecked="{Binding RestartTourRequested}"/>
				</StackPanel>

				<Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.5"/>

				<StackPanel Spacing="6">
					<TextBlock Text="About &amp; Support"
					           FontSize="14"
					           FontWeight="SemiBold"
					           Foreground="{DynamicResource TextFg}"/>
					<TextBlock Name="TxtAppVersion" Classes="muted" FontSize="11"/>
					<TextBlock Text="ReadZen is free and open-source, built by an independent scholar."
					           Classes="muted" FontSize="12" TextWrapping="Wrap"/>
					<StackPanel Orientation="Horizontal" Spacing="6">
						<TextBlock Text="&#x2665;" FontSize="12"
						           Foreground="{DynamicResource AccentLinkFg}"
						           VerticalAlignment="Center"/>
						<TextBlock Name="BtnSupportSettings"
						           Text="Support ReadZen + OpenZenTexts on Ko-fi"
						           FontSize="12"
						           Foreground="{DynamicResource AccentLinkFg}"
						           Cursor="Hand"
						           TextDecorations="Underline"
						           VerticalAlignment="Center"/>
					</StackPanel>
				</StackPanel>
			</StackPanel>
			</ScrollViewer>
		</Border>

		<!-- Footer buttons -->
		<StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,16,0,0">
			<Button Content="Cancel" Width="90" Height="32"
			        Command="{Binding CancelCommand}"/>
			<Button Content="Apply" Width="90" Height="32" Classes="primary"
			        Command="{Binding ApplyCommand}"/>
		</StackPanel>
	</Grid>

</Window>
