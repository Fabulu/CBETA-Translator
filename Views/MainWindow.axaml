<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ReadZen.App.Views"
        xmlns:models="clr-namespace:ReadZen.App.Models"
        xmlns:vm="using:ReadZen.App.ViewModels"
        x:Class="ReadZen.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1400"
        Height="900"
        Title="Read Zen">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Update notification bar (hidden by default) -->
        <Border Name="UpdateBar" Grid.Row="0" IsVisible="False"
                Background="#DFF0D8" Padding="8,4">
            <DockPanel>
                <Button Name="BtnDismissUpdate" DockPanel.Dock="Right" Content="&#x2715;"
                        Background="Transparent" Foreground="#3C763D" BorderThickness="0" FontSize="12"
                        Padding="4,0" Cursor="Hand"/>
                <Button Name="BtnDownloadUpdate" DockPanel.Dock="Right" Content="Download"
                        FontSize="11" Padding="8,2" Margin="8,0" Cursor="Hand"/>
                <TextBlock Name="TxtUpdateMessage" VerticalAlignment="Center"
                           FontSize="11" Foreground="#3C763D"/>
            </DockPanel>
        </Border>

        <Canvas Name="TourOverlayCanvas"
                Grid.RowSpan="4"
                ZIndex="1000"
                IsVisible="False">
            <views:TourSpotlightOverlay Name="TourSpotlight"/>
            <views:TourTooltipPanel Name="TourTooltip"/>
        </Canvas>

        <Border Grid.Row="1"
                Name="TopBar"
                Background="{DynamicResource BarBg}"
                Padding="8,4,8,4">
            <StackPanel Spacing="0">
                <DockPanel Name="TopBarCommandsHost"
                           LastChildFill="True"
                           Margin="0,0,0,2">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                DockPanel.Dock="Left">
                        <Button Name="BtnOpenRoot" Classes="compact-shell" Width="104" MinHeight="24" Padding="8,2" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="11" Content="Open Folder"
                                ToolTip.Tip="Select the folder containing your text files"/>
                        <Button Name="BtnSettings" Classes="compact-shell" Width="84" MinHeight="24" Padding="8,2" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="11" Content="Settings"
                                ToolTip.Tip="Open application settings"/>
                        <Button Name="BtnLicenses" Classes="compact-shell" Width="84" MinHeight="24" Padding="8,2" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="11" Content="Licenses"
                                ToolTip.Tip="View licenses and attributions"/>
                    </StackPanel>

                    <!-- Right-edge cluster: corpus badge + license chip + current file label.
                         All Dock="Right" so they stack right-to-left from the corner. -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                DockPanel.Dock="Right"
                                VerticalAlignment="Center">
                        <TextBlock Name="TxtCurrentFile"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Classes="muted"/>
                        <Button Name="BtnLicenseChipTopBar"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                IsVisible="False"
                                ToolTip.Tip="License and attribution for the current file">
                            <Border Name="LicenseChipBorderTopBar"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Name="TxtLicenseChipTopBar"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <views:LicenseDetailsView Name="LicenseDetailsTopBar"
                                                              MinWidth="560"
                                                              MaxWidth="800"/>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Name="BtnCorpusBadge"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                IsVisible="False"
                                ToolTip.Tip="Active corpus — click to switch">
                            <Border Name="CorpusBadge"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Name="TxtCorpusBadge"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Name="CorpusSwitcherPanel"
                                                Margin="12"
                                                Spacing="6"
                                                MinWidth="240"/>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,2,0,0">
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="4">
                        <Button Name="BtnToggleNav"
                                Grid.Column="0"
                                Width="28"
                                Height="22"
                                FontSize="12"
                                Content="&#x2630;"
                                ToolTip.Tip="Toggle sidebar"/>

                        <Button Name="BtnToggleTopBar"
                                Grid.Column="1"
                                Width="28"
                                Height="22"
                                FontSize="10"
                                Content="&#x25B2;"
                                ToolTip.Tip="Collapse command bar"/>

                        <TabStrip Name="MainTabs" Grid.Column="2" SelectedIndex="0" Height="22" PointerWheelChanged="MainTabs_OnPointerWheelChanged">
                            <TabStrip.Styles>
                                <Style Selector="TabStrip#MainTabs">
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="Height" Value="22"/>
                                </Style>
                                <Style Selector="TabStrip#MainTabs TabItem">
                                    <Setter Property="Padding" Value="6,0"/>
                                    <Setter Property="Margin" Value="0,0,1,0"/>
                                    <Setter Property="MinHeight" Value="20"/>
                                    <Setter Property="Height" Value="22"/>
                                </Style>
                            </TabStrip.Styles>
                            <TabItem ToolTip.Tip="Side-by-side Chinese/English reader">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Width="12" Height="12"
                                                  Data="M21 5V18.5C19.9 18.15 18.7 18 17.5 18C15.8 18 13.35 18.65 12 19.5V6C10.55 4.9 8.45 4.5 6.5 4.5C4.55 4.5 2.45 4.9 1 6V20.65C1 20.9 1.25 21.15 1.5 21.15C1.6 21.15 1.65 21.1 1.75 21.1C3.1 20.45 5.05 19.5 6.5 19.5C8.45 19.5 10.55 20.4 12 21.5C13.35 20.65 15.8 19.5 17.5 19.5C19.15 19.5 20.85 20.3 21.75 21.1C21.85 21.1 21.9 21.15 22 21.15C22.25 21.15 22.5 20.9 22.5 20.65V6C22.35 5.65 21.7 5.3 21 5Z"
                                                  Foreground="{Binding $parent[TabItem].Foreground}"/>
                                        <TextBlock Text="Read" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem ToolTip.Tip="Markdown translation editor">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Width="12" Height="12"
                                                  Data="M12.87 15.07L10.33 12.56L10.36 12.53C12.1 10.59 13.34 8.36 14.07 6H17V4H10V2H8V4H1V6H12.17C11.5 7.92 10.44 9.75 9 11.35C8.07 10.32 7.3 9.19 6.69 8H4.69C5.42 9.63 6.42 11.17 7.67 12.56L2.58 17.58L4 19L9 14L12.11 17.11L12.87 15.07M18.5 10H16.5L12 22H14L15.12 19H19.87L21 22H23L18.5 10M15.88 17L17.5 12.67L19.12 17H15.88Z"
                                                  Foreground="{Binding $parent[TabItem].Foreground}"/>
                                        <TextBlock Text="Translate" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem ToolTip.Tip="Full-text corpus search">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Width="12" Height="12"
                                                  Data="M9.5 3A6.5 6.5 0 0 1 16 9.5C16 11.11 15.41 12.59 14.44 13.73L14.71 14H15.5L20.5 19L19 20.5L14 15.5V14.71L13.73 14.44C12.59 15.41 11.11 16 9.5 16A6.5 6.5 0 0 1 3 9.5A6.5 6.5 0 0 1 9.5 3M9.5 5C7 5 5 7 5 9.5S7 14 9.5 14 14 12 14 9.5 12 5 9.5 5Z"
                                                  Foreground="{Binding $parent[TabItem].Foreground}"/>
                                        <TextBlock Text="Search" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem ToolTip.Tip="Git sync: share and receive translations">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Width="12" Height="12"
                                                  Data="M12 4V1L8 5L12 9V6C15.31 6 18 8.69 18 12C18 13.01 17.75 13.97 17.3 14.8L18.76 16.26C19.54 15.03 20 13.57 20 12C20 7.58 16.42 4 12 4M12 18C8.69 18 6 15.31 6 12C6 10.99 6.25 10.03 6.7 9.2L5.24 7.74C4.46 8.97 4 10.43 4 12C4 16.42 7.58 20 12 20V23L16 19L12 15V18Z"
                                                  Foreground="{Binding $parent[TabItem].Foreground}"/>
                                        <TextBlock Text="Sync" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem ToolTip.Tip="Passage collections for research">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Width="12" Height="12"
                                                  Data="M4 6H2V20C2 21.1 2.9 22 4 22H18V20H4V6M20 2H8C6.9 2 6 2.9 6 4V16C6 17.1 6.9 18 8 18H20C21.1 18 22 17.1 22 16V4C22 2.9 21.1 2 20 2M20 16H8V4H20V16M10 9H18V11H10V9M10 12H14V14H10V12M10 6H18V8H10V6Z"
                                                  Foreground="{Binding $parent[TabItem].Foreground}"/>
                                        <TextBlock Text="Collect" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem ToolTip.Tip="Zen master lineage explorer">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Width="12" Height="12"
                                                  Data="M12 5.5A3.5 3.5 0 0 1 15.5 9A3.5 3.5 0 0 1 12 12.5A3.5 3.5 0 0 1 8.5 9A3.5 3.5 0 0 1 12 5.5M5 8C5.56 8 6.08 8.15 6.53 8.42C6.38 9.85 6.8 11.27 7.66 12.38C7.16 13.34 6.16 14 5 14A3 3 0 0 1 2 11A3 3 0 0 1 5 8M19 8A3 3 0 0 1 22 11A3 3 0 0 1 19 14C17.84 14 16.84 13.34 16.34 12.38C17.2 11.27 17.62 9.85 17.47 8.42C17.92 8.15 18.44 8 19 8M5.5 18.25C5.5 16.18 8.41 14.5 12 14.5S18.5 16.18 18.5 18.25V20H5.5V18.25Z"
                                                  Foreground="{Binding $parent[TabItem].Foreground}"/>
                                        <TextBlock Text="Lineage" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                        </TabStrip>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
            <Border Name="NavPanel"
                    Grid.Column="0"
                    Background="{DynamicResource NavBg}"
                    Width="260">
                <Grid Margin="6"
                      RowDefinitions="Auto,Auto,Auto,*"
                      RowSpacing="6">

                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBlock Text="Files"
                                   FontWeight="Bold"
                                   Classes="muted"
                                   VerticalAlignment="Center"/>

                        <ComboBox Name="CmbStatusFilter"
                                  Grid.Column="1"
                                  SelectedIndex="0"
                                  MinWidth="132"
                                  FontSize="11"
                                  ToolTip.Tip="Filter files by translation status">
                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="Translated (Green)"/>
                            <ComboBoxItem Content="Partially translated (Yellow)"/>
                            <ComboBoxItem Content="Untranslated (Red)"/>
                        </ComboBox>
                    </Grid>

                    <TextBox Name="NavSearch"
                             Grid.Row="1"
                             FontSize="11"
                             Watermark="Search (filename or title)..."
                             ToolTip.Tip="Filter by filename or title"/>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Spacing="8">
                        <CheckBox Name="ChkShowFilenames"
                                  FontSize="11"
                                  Content="Show filenames"
                                  ToolTip.Tip="Show technical filenames instead of titles"/>
                        <CheckBox Name="ChkZenOnly"
                                  FontSize="11"
                                  Content="Zen texts"
                                  ToolTip.Tip="Show only texts flagged as Zen/Chan"/>
                    </StackPanel>

                    <ListBox Name="FilesList"
                             Grid.Row="3"
                             Background="{DynamicResource ControlBg}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource SelectionBg}"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected Border">
                                <Setter Property="BorderBrush" Value="#FFD700"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#20FFFFFF"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Name="MnuLinkToPassage" Header="Link to selected passage"
                                          ToolTip.Tip="Add this text to the selected scholar passage's linked texts"/>
                                <MenuItem Name="MnuCopyLink" Header="Copy Link"
                                          ToolTip.Tip="Copy a zen:// link for this file to the clipboard"/>
                                <MenuItem Name="MnuCopyRedditLink" Header="Copy Reddit Link"
                                          ToolTip.Tip="Copy a shareable HTTPS link for this file to the clipboard"/>
                                <Separator/>
                                <MenuItem Name="MnuAddBookToCollection" Header="Add to Collection"
                                          ToolTip.Tip="Add this text as a book entry to a Scholar collection"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:FileNavItem">
                                <Border CornerRadius="6"
                                        Padding="4"
                                        Margin="2"
                                        BorderThickness="1.5"
                                        BorderBrush="Transparent"
                                        Background="{Binding Status, Converter={x:Static views:NavStatusToBrushConverter.Instance}}">
                                    <TextBlock Text="{Binding DisplayShort}"
                                               ToolTip.Tip="{Binding Tooltip}"
                                               TextWrapping="NoWrap"
                                               FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="8,0,8,8">
                <Grid>
                    <Carousel Name="MainTabContent"
                              SelectedIndex="{Binding ElementName=MainTabs, Path=SelectedIndex, Mode=TwoWay}"
                              PointerWheelChanged="MainTabContent_OnPointerWheelChanged">
                        <views:ReadableTabView Name="ReadableView"/>
                        <views:TranslationTabView Name="TranslationView"/>
                        <views:SearchTabView Name="SearchView"/>
                        <views:GitTabView Name="GitView"/>
                        <views:ScholarTabView Name="ScholarView"/>

                        <!-- Masters tab: lightweight launcher for ZenMasterManagerWindow -->
                        <Border Name="MastersTabPanel" Padding="16">
                          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="500">
                            <TextBlock Text="Zen Masters" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Name="TxtMastersStatus" Text="Loading masters..."
                                       HorizontalAlignment="Center" FontSize="13" Opacity="0.7"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,8,0,0">
                              <Button Name="BtnOpenMasters" Content="Explore Zen Masters" MinWidth="200" Padding="12,8"
                                      HorizontalContentAlignment="Center"/>
                              <Button Name="BtnBuildMasterIndex" Content="Scan Texts for Masters" MinWidth="200" Padding="12,8"
                                      HorizontalContentAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Name="TxtMastersCorpusInfo" Text="" HorizontalAlignment="Center"
                                       FontSize="11" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center"/>
                          </StackPanel>
                        </Border>
                    </Carousel>

                    <Border Name="EmptyStateOverlay" IsVisible="True"
                            Background="{DynamicResource AppBg}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="16" MaxWidth="400">
                            <TextBlock Text="Welcome to Read Zen"
                                       FontSize="20" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFg}"/>
                            <TextBlock Text="Get started with the guided tour, or open an existing folder if you already have texts."
                                       TextWrapping="Wrap" HorizontalAlignment="Center"
                                       TextAlignment="Center" Classes="muted"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="12">
                                <Button Name="BtnGetStarted"
                                        Content="Get Started"
                                        Width="140" Height="36"
                                        FontSize="14" FontWeight="SemiBold"
                                        Background="{DynamicResource SelectionBg}"
                                        Foreground="{DynamicResource SelectionFg}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"/>
                                <Button Name="BtnOpenRootAlt"
                                        Content="Open Folder"
                                        Width="140" Height="36"
                                        FontSize="14"
                                        Background="{DynamicResource BtnBg}"
                                        Foreground="{DynamicResource BtnFg}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="{DynamicResource BarBg}"
                Padding="8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="&#x2665;" FontSize="10"
                               Foreground="{DynamicResource AccentLinkFg}"
                               VerticalAlignment="Center"/>
                    <TextBlock Name="BtnSupportStatusBar"
                               Text="Support" FontSize="10"
                               Foreground="{DynamicResource AccentLinkFg}"
                               VerticalAlignment="Center"
                               Cursor="Hand"
                               TextDecorations="Underline"
                               ToolTip.Tip="Support ReadZen + OpenZen on Ko-fi"/>
                </StackPanel>
                <TextBlock Name="TxtStatus" Classes="muted"/>
            </DockPanel>
        </Border>

        <!-- Toast notification container -->
        <StackPanel Name="ToastContainer"
                    Grid.Row="0" Grid.RowSpan="4"
                    ZIndex="500"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,48"
                    Spacing="4"/>

        <!-- Command Palette scrim (click-outside-to-dismiss) -->
        <Panel Name="CommandPaletteScrim"
               Grid.Row="0" Grid.RowSpan="4"
               IsVisible="False"
               ZIndex="599"
               Background="Transparent"/>

        <!-- Command Palette Overlay (Ctrl+Shift+P) -->
        <Border Name="CommandPaletteOverlay"
                Grid.Row="0" Grid.RowSpan="4"
                IsVisible="False"
                ZIndex="600"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,60,0,0"
                Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0"
                Width="500"
                BoxShadow="0 8 24 0 #40000000">
            <StackPanel>
                <TextBox Name="CommandPaletteInput"
                         Watermark="Type a command..."
                         FontSize="14"
                         Padding="12,10"
                         BorderThickness="0,0,0,1"
                         BorderBrush="{DynamicResource BorderBrush}"/>
                <ListBox Name="CommandPaletteList"
                         MaxHeight="300"
                         Background="Transparent"
                         BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

