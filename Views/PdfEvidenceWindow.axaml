<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ReadZen.App.Views.PdfEvidenceWindow"
        Width="850"
        Height="750"
        Title="Witness Evidence"
        Background="{DynamicResource AppBg}"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">

    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,8">
      <DockPanel>
        <ComboBox Name="CbWitness" DockPanel.Dock="Right"
                  MinWidth="140" FontSize="12"
                  VerticalAlignment="Center"
                  IsVisible="False"
                  ToolTip.Tip="Switch witness"/>
        <TextBlock Name="TxtTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock Name="TxtMeta" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
    </StackPanel>

    <!-- Status banner -->
    <Border Grid.Row="1"
            Name="StatusBanner"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10,6"
            Margin="0,0,0,8"
            IsVisible="False">
      <StackPanel Spacing="4">
        <TextBlock Name="TxtStatus" FontSize="11" TextWrapping="Wrap"/>
        <ProgressBar Name="DownloadProgress" IsVisible="False"
                     Minimum="0" Maximum="100" Height="4"/>
      </StackPanel>
    </Border>

    <!-- Image viewer + OCR side panel -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">

      <!-- Image viewer with highlight overlay -->
      <Border Grid.Column="0"
              Background="{DynamicResource ControlBg}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="6"
              ClipToBounds="True">
        <ScrollViewer Name="ImageScroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
          <Panel Name="ImageHost">
            <Image Name="PageImage"
                   Stretch="Uniform"
                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
            <!-- Highlight overlay for the evidence region -->
            <Canvas Name="HighlightCanvas" IsHitTestVisible="False"/>
          </Panel>
        </ScrollViewer>
      </Border>

      <!-- OCR Readings side panel (hidden by default) -->
      <Border Grid.Column="1"
              Name="OcrPanel"
              IsVisible="False"
              Width="300"
              Background="{DynamicResource ControlBg}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1,1,1,1"
              CornerRadius="6"
              Margin="4,0,0,0">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="OCR Readings"
                     FontSize="13" FontWeight="SemiBold"
                     Margin="8,6,8,4"/>
          <ScrollViewer Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        Margin="0,0,0,4">
            <StackPanel Name="OcrContent" Spacing="4" Margin="8,0,8,4"/>
          </ScrollViewer>
        </Grid>
      </Border>

    </Grid>

    <!-- Bottom buttons -->
    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,8,0,0">
      <Button Name="BtnToggleOcr" Content="No OCR data" MinWidth="90"
              FontSize="11" ToolTip.Tip="Toggle OCR readings panel"
              IsEnabled="False"/>
      <TextBlock Name="TxtZoom" FontSize="11" Opacity="0.7"
                 VerticalAlignment="Center" Margin="0,0,8,0"/>
      <Button Name="BtnZoomIn" Content="+" MinWidth="36"
              ToolTip.Tip="Zoom in (Ctrl+Scroll)"/>
      <Button Name="BtnZoomOut" Content="-" MinWidth="36"
              ToolTip.Tip="Zoom out (Ctrl+Scroll)"/>
      <Button Name="BtnZoomFit" Content="Fit" MinWidth="60"
              ToolTip.Tip="Fit to window"/>
      <Button Name="BtnDownload" Content="Download PDF" MinWidth="140"
              IsVisible="False"/>
      <Button Name="BtnClose" Content="Close" MinWidth="100"/>
    </StackPanel>
  </Grid>
</Window>
