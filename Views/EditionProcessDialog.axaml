<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="https://github.com/avaloniaui/avaloniaedit"
        x:Class="ReadZen.App.Views.EditionProcessDialog"
        Title="Edition Details"
        Width="920" Height="700"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
    <Window.Styles>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    </Window.Styles>
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="16,12" Background="{DynamicResource BarBg}">
            <StackPanel Spacing="2">
                <TextBlock Name="TxtDialogTitle" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>
                <TextBlock Name="TxtDialogSubtitle" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Tab control -->
        <TabControl Name="TabMain" Margin="8">

            <!-- Sources tab -->
            <TabItem Header="Sources">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="SourcesHost" Spacing="8" Margin="8"/>
                </ScrollViewer>
            </TabItem>

            <!-- Timeline tab -->
            <TabItem Header="Timeline">
                <Grid RowDefinitions="Auto,Auto,*">
                    <!-- Slider + controls -->
                    <DockPanel Grid.Row="0" Margin="8,8,8,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                            <Button Name="BtnBack50" Content="-50" Padding="4,2" FontSize="9"
                                    ToolTip.Tip="Back 50 events" Opacity="0.7"/>
                            <Button Name="BtnBack10" Content="-10" Padding="4,2" FontSize="9"
                                    ToolTip.Tip="Back 10 events" Opacity="0.7"/>
                            <Button Name="BtnBack5" Content="-5" Padding="4,2" FontSize="9"
                                    ToolTip.Tip="Back 5 events" Opacity="0.7"/>
                            <Button Name="BtnTimelinePrev" Content="&#x25C0;" Padding="6,2" FontSize="11"
                                    ToolTip.Tip="Previous event"/>
                            <Button Name="BtnTimelineNext" Content="&#x25B6;" Padding="6,2" FontSize="11"
                                    ToolTip.Tip="Next event"/>
                            <Button Name="BtnFwd5" Content="+5" Padding="4,2" FontSize="9"
                                    ToolTip.Tip="Forward 5 events" Opacity="0.7"/>
                            <Button Name="BtnFwd10" Content="+10" Padding="4,2" FontSize="9"
                                    ToolTip.Tip="Forward 10 events" Opacity="0.7"/>
                            <Button Name="BtnFwd50" Content="+50" Padding="4,2" FontSize="9"
                                    ToolTip.Tip="Forward 50 events" Opacity="0.7"/>
                            <ComboBox Name="CmbTimelineStage" MinWidth="130" FontSize="11"
                                      ToolTip.Tip="Jump to stage" Margin="4,0,0,0"/>
                            <CheckBox Name="ChkTextChangesOnly" Content="Text changes only"
                                      FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                        <Slider Name="SliderTimeline" Minimum="0" Maximum="1"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                    </DockPanel>

                    <!-- Event summary -->
                    <Border Grid.Row="1" Background="{DynamicResource BarBg}" CornerRadius="6"
                            Padding="10" Margin="8,4">
                        <StackPanel Spacing="2">
                            <TextBlock Name="TxtEventSummary" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Name="TxtEventMeta" FontSize="10" Opacity="0.7" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Main content: text preview (left) + event details (right) -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,6,300" Margin="8,4,8,8">
                        <!-- Text preview pane with AvaloniaEdit -->
                        <Border Grid.Column="0" CornerRadius="6" BorderThickness="1" Padding="2">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Name="TxtTextPreviewHeader"
                                           Text="Edition text at this point"
                                           FontWeight="SemiBold" FontSize="11"
                                           Margin="6,4,6,4" Opacity="0.7"/>
                                <ae:TextEditor Name="EditorTimelinePreview"
                                               IsReadOnly="True"
                                               ShowLineNumbers="False"
                                               WordWrap="True"
                                               FontFamily="Consolas, Menlo, 'Noto Sans CJK SC', monospace"
                                               FontSize="12"/>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Column="1" ResizeDirection="Columns"
                                      Background="Transparent" Width="6"/>

                        <!-- Event details + state panel -->
                        <ScrollViewer Grid.Column="2"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Name="TimelineDetailsHost" Spacing="8"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Corrections tab (CE time-travel) -->
            <TabItem Header="Corrections" Name="TabCorrections">
                <Grid RowDefinitions="Auto,Auto,*" Margin="8">
                    <!-- Scrubber -->
                    <DockPanel Grid.Row="0">
                        <TextBlock DockPanel.Dock="Right" Name="TxtCorrectionProgress"
                                   FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7"/>
                        <Slider Name="SliderCorrections" Minimum="0" Maximum="1"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Scrub through correction history. Left = raw OCR, right = fully corrected."/>
                    </DockPanel>

                    <!-- Current correction info -->
                    <Border Grid.Row="1" Background="{DynamicResource BarBg}" CornerRadius="6"
                            Padding="10" Margin="0,4">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Name="BtnViewEvidence"
                                    Content="View Evidence" MinWidth="120"
                                    VerticalAlignment="Center" Margin="8,0,0,0"
                                    IsVisible="False"
                                    ToolTip.Tip="View the PDF page image that supports this correction"/>
                            <StackPanel Spacing="2">
                                <TextBlock Name="TxtCorrectionInfo" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Name="TxtCorrectionBasis" FontSize="10" Opacity="0.7" TextWrapping="Wrap"/>
                                <TextBlock Name="TxtCorrectionReasoning" FontSize="10" Opacity="0.75"
                                           TextWrapping="Wrap" IsVisible="False"
                                           Margin="0,4,0,0" FontStyle="Italic"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Text view -->
                    <ae:TextEditor Grid.Row="2" Name="EditorCorrectionPreview"
                                   IsReadOnly="True"
                                   ShowLineNumbers="True"
                                   WordWrap="True"
                                   FontFamily="Consolas, Menlo, 'Noto Sans CJK SC', monospace"
                                   FontSize="13"/>
                </Grid>
            </TabItem>

            <!-- Log tab -->
            <TabItem Header="Log">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="LogHost" Spacing="8" Margin="8"/>
                </ScrollViewer>
            </TabItem>

            <!-- Process tab -->
            <TabItem Header="Editorial Process">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="ProcessHost" Spacing="8" Margin="8"/>
                </ScrollViewer>
            </TabItem>

            <!-- Apparatus tab -->
            <TabItem Header="Apparatus">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="ApparatusHost" Spacing="8" Margin="8"/>
                </ScrollViewer>
            </TabItem>

            <!-- Stats tab -->
            <TabItem Header="Statistics">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="StatsHost" Spacing="8" Margin="8"/>
                </ScrollViewer>
            </TabItem>

            <!-- Documents tab -->
            <TabItem Header="Documents">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="DocumentsHost" Spacing="8" Margin="8"/>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
