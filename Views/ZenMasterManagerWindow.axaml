<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ReadZen.App.Views"
        x:Class="ReadZen.App.Views.ZenMasterManagerWindow"
        Width="960"
        Height="680"
        Title="Zen Masters"
        Background="{DynamicResource AppBg}"
        WindowStartupLocation="CenterOwner">

  <!-- Thin host: the real content is the reusable ZenMasterManagerView, constructed
       with its roots in code-behind and inserted here. The same control also backs the
       embedded Lineage tab in MainWindow (the default path); this window remains for
       deep-links / a future pop-out. -->
  <ContentControl Name="Host"/>
</Window>
