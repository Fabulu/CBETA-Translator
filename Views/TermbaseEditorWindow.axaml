<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ReadZen.App.Models"
        xmlns:vm="using:ReadZen.App.ViewModels"
        x:Class="ReadZen.App.Views.TermbaseEditorWindow"
        x:DataType="vm:TermbaseEditorWindowViewModel"
        Width="980"
        Height="640"
        Title="Zen Dictionary"
        WindowStartupLocation="CenterOwner">

	<Grid RowDefinitions="*,Auto" ColumnDefinitions="320,12,*" Margin="12">

		<!-- Left: list -->
		<Border Grid.Row="0"
				Grid.Column="0"
				Background="{DynamicResource ControlBg}"
				BorderBrush="{DynamicResource BorderBrush}"
				BorderThickness="1"
				CornerRadius="6"
				Padding="8">
			<Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" RowSpacing="8">
				<TextBlock Text="Terms" FontWeight="Bold"/>

				<TextBox Grid.Row="1"
						 Text="{Binding SearchQuery}"
						 Watermark="Search source / preferred / note..."/>

				<ListBox Grid.Row="2"
						 ItemsSource="{Binding FilteredEntries}"
						 SelectedItem="{Binding SelectedEntry}">
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="models:TermbaseEntry">
							<Border Padding="6" Margin="0,0,0,4">
								<StackPanel Spacing="2">
									<TextBlock Text="{Binding SourceTerm}" FontWeight="Bold"/>
									<TextBlock Text="{Binding PreferredTarget}"
											   Opacity="0.85"
											   TextWrapping="Wrap"/>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<!-- Community termbases separator -->
				<Border Grid.Row="3"
						IsVisible="{Binding HasCommunityEntries}"
						Height="1"
						Background="{DynamicResource BorderBrush}"
						Margin="0,4"/>

				<StackPanel Grid.Row="4"
							IsVisible="{Binding HasCommunityEntries}"
							Orientation="Horizontal"
							Spacing="8">
					<TextBlock Text="Community Termbases"
							   FontWeight="Bold"
							   Foreground="{DynamicResource AccentLinkFg}"/>
					<Button Content="Adopt Term"
							Command="{Binding AdoptSelectedTermCommand}"
							FontSize="11"
							Padding="8,2"/>
				</StackPanel>

				<StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="4"
						   IsVisible="{Binding HasCommunityEntries}">
					<ComboBox ItemsSource="{Binding CommunityUsernames}"
							  SelectedIndex="{Binding SelectedCommunityUserIndex}"
							  MinWidth="100" FontSize="11"
							  ToolTip.Tip="Filter by community user"/>
					<TextBox Text="{Binding CommunityFilter}"
							 Watermark="Filter..." MinWidth="80"/>
				</StackPanel>

				<ListBox Grid.Row="6"
						 IsVisible="{Binding HasCommunityEntries}"
						 ItemsSource="{Binding CommunityEntries}"
						 SelectedItem="{Binding SelectedCommunityEntry}"
						 MaxHeight="250">
					<ListBox.ContextMenu>
						<ContextMenu>
							<MenuItem Header="Adopt Term" Command="{Binding AdoptSelectedTermCommand}"/>
						</ContextMenu>
					</ListBox.ContextMenu>
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="models:TermbaseEntry">
							<Border Padding="6" Margin="0,0,0,4">
								<StackPanel Spacing="2">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<TextBlock Text="{Binding SourceTerm}" FontWeight="Bold"/>
										<TextBlock Text="\u2192" Opacity="0.5"/>
										<TextBlock Text="{Binding PreferredTarget}"
												   Opacity="0.85"
												   TextWrapping="Wrap"/>
									</StackPanel>
									<TextBlock Foreground="{DynamicResource AccentLinkFg}"
											   FontSize="11"
											   Opacity="0.9">
										<TextBlock.Text>
											<MultiBinding StringFormat="by {0}">
												<Binding Path="CreatedBy"/>
											</MultiBinding>
										</TextBlock.Text>
									</TextBlock>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>
		</Border>

		<GridSplitter Grid.Row="0"
					  Grid.Column="1"
					  Width="12"
					  ResizeDirection="Columns"
					  Background="Transparent"/>

		<!-- Right: editor + corpus usage -->
		<Border Grid.Row="0"
				Grid.Column="2"
				Background="{DynamicResource ControlBg}"
				BorderBrush="{DynamicResource BorderBrush}"
				BorderThickness="1"
				CornerRadius="6"
				Padding="4">
			<TabControl Name="MainTabControl">
				<TabItem Header="Edit Term">
					<Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10" Margin="8">
						<TextBlock Text="Edit Term" FontWeight="Bold"/>

						<Grid Grid.Row="1" ColumnDefinitions="140,*" ColumnSpacing="10">
							<TextBlock Text="Source term"
									   VerticalAlignment="Center"/>
							<TextBox Name="TxtSourceTerm"
									 Grid.Column="1"
									 Text="{Binding SourceTerm}"/>
						</Grid>

						<Grid Grid.Row="2" ColumnDefinitions="140,*" ColumnSpacing="10">
							<TextBlock Text="Preferred target"
									   VerticalAlignment="Center"/>
							<TextBox Grid.Column="1"
									 Text="{Binding PreferredTarget}"/>
						</Grid>

						<Grid Grid.Row="3" ColumnDefinitions="140,220,*" ColumnSpacing="10">
							<TextBlock Text="Status"
									   VerticalAlignment="Center"/>
							<ComboBox Grid.Column="1"
									  SelectedIndex="{Binding SelectedStatusIndex}">
								<ComboBoxItem Content="preferred"/>
								<ComboBoxItem Content="allowed"/>
								<ComboBoxItem Content="deprecated"/>
								<ComboBoxItem Content="forbidden"/>
							</ComboBox>
						</Grid>

						<Grid Grid.Row="4" RowDefinitions="Auto,Auto,*" RowSpacing="10">
							<Grid ColumnDefinitions="140,*" ColumnSpacing="10">
								<TextBlock Text="Alternates"
										   VerticalAlignment="Top"/>
								<TextBox Grid.Column="1"
										 Text="{Binding AlternatesText}"
										 AcceptsReturn="True"
										 TextWrapping="Wrap"
										 MinHeight="90"
										 Watermark="One alternate per line"/>
							</Grid>

							<Grid Grid.Row="1" ColumnDefinitions="140,*" ColumnSpacing="10">
								<TextBlock Text="Note"
										   VerticalAlignment="Top"/>
								<TextBox Grid.Column="1"
										 Text="{Binding NoteText}"
										 AcceptsReturn="True"
										 TextWrapping="Wrap"
										 MinHeight="90"/>
							</Grid>
						</Grid>

						<TextBlock Grid.Row="5"
								   Text="{Binding StatusMessage}"
								   Opacity="0.8"/>
					</Grid>
				</TabItem>

				<TabItem Header="Corpus Usage">
					<Grid RowDefinitions="Auto,*" Margin="4">
						<TextBlock Grid.Row="0" Text="{Binding CorpusStatusText}" Classes="muted" Margin="4"/>
						<ListBox Grid.Row="1" Name="CorpusHitsList" ItemsSource="{Binding CorpusUsageHits}">
							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="models:CorpusUsageHit">
									<Border Padding="6" Margin="0,0,0,4">
										<StackPanel Spacing="2">
											<TextBlock Text="{Binding ZhSnippet}" TextWrapping="Wrap" FontWeight="SemiBold"/>
											<TextBlock Text="{Binding DisplayName}" Opacity="0.7" FontSize="11"/>
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="{Binding MasterName}" FontSize="11"
														   Foreground="{DynamicResource AccentLinkFg}"
														   IsVisible="{Binding MasterName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
												<TextBlock Text="{Binding DateDisplay}" FontSize="11" Opacity="0.6"
														   IsVisible="{Binding DateDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
											</StackPanel>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ListBox.ItemTemplate>
							<ListBox.ContextMenu>
								<ContextMenu>
									<MenuItem Name="MnuNavigateToHit" Header="Navigate to Source"/>
									<MenuItem Name="MnuAddToScholar" Header="Add to Scholar"/>
								</ContextMenu>
							</ListBox.ContextMenu>
						</ListBox>
					</Grid>
				</TabItem>
			</TabControl>
		</Border>

		<!-- Bottom buttons -->
		<Border Grid.Row="1"
				Grid.ColumnSpan="3"
				Margin="0,12,0,0"
				Background="{DynamicResource BarBg}"
				BorderBrush="{DynamicResource BorderBrush}"
				BorderThickness="1"
				CornerRadius="6"
				Padding="10">
			<Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
				<Button Content="New"
						Command="{Binding NewTermCommand}"/>
				<Button Grid.Column="1"
						Content="Delete"
						Command="{Binding DeleteTermCommand}"/>
				<Button Grid.Column="2"
						Content="Duplicate"
						Command="{Binding DuplicateTermCommand}"/>

				<Button Grid.Column="4"
						Content="Close"
						MinWidth="100"
						Command="{Binding CloseWindowCommand}"/>
				<Button Grid.Column="5"
						Content="Save"
						MinWidth="100"
						Command="{Binding SaveCommand}"/>
			</Grid>
		</Border>

	</Grid>
</Window>
