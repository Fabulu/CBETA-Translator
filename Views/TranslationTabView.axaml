<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:vm="using:CbetaTranslator.App.ViewModels"
             x:Class="CbetaTranslator.App.Views.TranslationTabView"
             x:DataType="vm:TranslationTabViewModel">

	<UserControl.Styles>
		<StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

		<Style Selector="ae|TextEditor">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource TextFg}"/>
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,*">

		<Border Grid.Row="0"
				Background="{DynamicResource BarBg}"
				BorderBrush="{DynamicResource BorderBrush}"
				BorderThickness="1"
				Padding="8"
				CornerRadius="6">

			<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">

				<!-- Row 0: toolbar groups + right-side checkboxes -->
				<Grid Grid.Row="0" ColumnDefinitions="*,Auto">

					<WrapPanel Grid.Column="0"
							   Orientation="Horizontal"
							   ItemSpacing="8"
							   LineSpacing="8">

						<!-- Group 1: Mode -->
						<Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock Text="Mode" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
								<Button Name="BtnModeHead" Content="Head of File" ToolTip.Tip="Switch to header projection (Ctrl+1)"/>
								<Button Name="BtnModeBody" Content="Body of File" ToolTip.Tip="Switch to body projection (Ctrl+2)"/>
								<Button Name="BtnModeNotes" Content="Notes" ToolTip.Tip="Switch to notes projection (Ctrl+3)"/>
							</StackPanel>
						</Border>

						<!-- Group 2: AI Translation -->
						<Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock Text="AI Translation" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
								<Button Name="BtnCopyChunkPrompt"
										Content="Copy for AI"
										ToolTip.Tip="Copy up to N valid untranslated blocks from the caret (Ctrl+Shift+C)"/>
								<Button Name="BtnPasteByNumber"
										Content="Paste from AI"
										ToolTip.Tip="Paste clipboard blocks and replace EN lines by matching block number (Ctrl+Shift+V)"/>
								<TextBlock Text="Blocks:" VerticalAlignment="Center"/>
								<ComboBox Name="CmbChunkSize" Width="72" SelectedIndex="4" ToolTip.Tip="How many blocks max to copy">
									<ComboBoxItem Content="1"/>
									<ComboBoxItem Content="10"/>
									<ComboBoxItem Content="25"/>
									<ComboBoxItem Content="50"/>
									<ComboBoxItem Content="100"/>
									<ComboBoxItem Content="150"/>
								</ComboBox>
								<Button Name="BtnNextUntranslated"
										Content="Next untranslated"
										ToolTip.Tip="Jump to next block with empty EN (F8). Alt+Right / Alt+Left navigate any block."/>
								<TextBlock Text="Copy blocks -> paste in LLM -> copy response -> Paste from AI"
										   VerticalAlignment="Center" Opacity="0.5" FontSize="11" Classes="muted"/>
							</StackPanel>
						</Border>

						<!-- Group 3: Review -->
						<Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock Text="Review" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
								<Button Name="BtnApproveSegment"
										Content="Approve segment"
										ToolTip.Tip="Mark approved and advance to next unreviewed (Alt+A / F9)"/>
								<Button Name="BtnNeedsWorkSegment"
										Content="Needs work"
										ToolTip.Tip="Flag as needing more work (Alt+N / F10)"/>
								<Button Name="BtnRejectSegment"
										Content="Reject"
										ToolTip.Tip="Mark the current segment as rejected (F11)"/>
								<Button Name="BtnNextUnapproved"
										Content="Next unapproved"
										ToolTip.Tip="Jump to next segment that has not been approved yet"/>
								<TextBlock Name="TxtReviewState"
										   Text="Unreviewed"
										   VerticalAlignment="Center"
										   FontWeight="SemiBold"
										   Margin="4,0,0,0"/>
							</StackPanel>
						</Border>

						<!-- Group 4: File -->
						<Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock Text="File" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
								<Button Name="BtnSave" Content="Save XML" ToolTip.Tip="Apply projection edits and save XML (Ctrl+S)"/>
								<Button Name="BtnRevert" Content="Revert from XML" ToolTip.Tip="Reload projection from XML (Ctrl+R)"/>
								<Button Name="BtnUndo" Content="Undo" ToolTip.Tip="Undo (Ctrl+Z)"/>
								<Button Name="BtnRedo" Content="Redo" ToolTip.Tip="Redo (Ctrl+Y)"/>
							</StackPanel>
						</Border>

						<!-- Group 5: Tools -->
						<Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock Text="Tools" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
								<Button Name="BtnBuildReferenceTm"
										Content="Build Ref TM"
										ToolTip.Tip="Build translation memory reference from Zen-flagged translated texts"/>
								<Button Name="BtnManageTerms"
										Content="Manage Terms"
										ToolTip.Tip="Open the termbase editor"/>
								<Button Name="BtnFindChineseInEn"
										Content="Find Chinese in EN"
										ToolTip.Tip="Find Chinese characters in EN lines and select the EN text (Ctrl+Shift+F). Use this to find the last Chinese characters that prevent your translation from registering as complete."/>
							</StackPanel>
						</Border>

					</WrapPanel>

					<StackPanel Grid.Column="1"
								Orientation="Horizontal"
								Spacing="12"
								VerticalAlignment="Top"
								Margin="8,0,0,0">
						<CheckBox Name="ChkWrap"
								  Content="Wrap"
								  IsChecked="True"
								  ToolTip.Tip="Toggle line wrapping"/>
						<CheckBox Name="ChkAssistantVisible"
								  Content="Assistant"
								  IsChecked="True"
								  ToolTip.Tip="Show or hide the translation assistant pane"/>
					</StackPanel>

				</Grid>

				<!-- Row 1: quick info -->
				<TextBlock Grid.Row="1"
						   Name="TxtQuickInfo"
						   Text=""
						   Opacity="0.8"
						   TextTrimming="CharacterEllipsis"/>

				<!-- Row 2: progress stats -->
				<TextBlock Name="TxtProgress"
						   Grid.Row="2"
						   Text=""
						   Opacity="0.75"
						   Classes="muted"
						   FontSize="12"/>

			</Grid>
		</Border>

		<Grid Grid.Row="1" Margin="0,8,0,0">
			<!-- Empty-state overlay -->
			<Border Name="TranslationEmptyState"
					IsVisible="True"
					Background="{DynamicResource AppBg}"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					ZIndex="10">
				<TextBlock Text="Select a file from the sidebar to begin translating."
						   HorizontalAlignment="Center"
						   VerticalAlignment="Center"
						   Opacity="0.5"
						   Classes="muted"/>
			</Border>

			<Border Background="{DynamicResource XmlViewerBg}"
					BorderBrush="{DynamicResource XmlViewerBorder}"
					BorderThickness="1"
					CornerRadius="6">

				<Grid RowDefinitions="Auto,*">
					<Border Grid.Row="0"
							BorderThickness="0,0,0,1"
							BorderBrush="{DynamicResource XmlViewerBorder}"
							Padding="8">
						<TextBlock Name="TxtModeInfo" Text="Translation Editor"/>
					</Border>

					<Grid Grid.Row="1" Name="EditorAssistantGrid" ColumnDefinitions="*,8,360">

						<Border Grid.Column="0" Padding="0">
							<ae:TextEditor Name="EditorProjection"
										   FontFamily="Consolas"
										   ShowLineNumbers="False"
										   WordWrap="True"
										   HorizontalScrollBarVisibility="Auto"
										   VerticalScrollBarVisibility="Auto"/>
						</Border>

						<GridSplitter Name="AssistantSplitter"
									  Grid.Column="1"
									  Width="8"
									  ResizeDirection="Columns"
									  ResizeBehavior="PreviousAndNext"
									  Background="Transparent"/>

						<Border Name="AssistantPane"
								Grid.Column="2"
								Padding="8"
								Background="{DynamicResource ControlBg}"
								BorderBrush="{DynamicResource XmlViewerBorder}"
								BorderThickness="1,0,0,0">
							<ScrollViewer HorizontalScrollBarVisibility="Disabled"
										  VerticalScrollBarVisibility="Auto">
								<StackPanel Spacing="10">

									<TextBlock Text="Assistant" FontWeight="Bold"/>

									<Border Padding="8"
											CornerRadius="6"
											BorderThickness="1"
											BorderBrush="{DynamicResource BorderBrush}">
										<StackPanel Spacing="6">
											<TextBlock Text="Warnings / QA" FontWeight="Bold"/>
											<StackPanel Name="QaHost" Spacing="10"/>
										</StackPanel>
									</Border>

									<Border Padding="8"
											CornerRadius="6"
											BorderThickness="1"
											BorderBrush="{DynamicResource BorderBrush}">
										<StackPanel Spacing="6">
											<TextBlock Text="Recognized Terms" FontWeight="Bold"/>
											<StackPanel Name="TermHost" Spacing="10"/>
										</StackPanel>
									</Border>

									<Border Padding="8"
											CornerRadius="6"
											BorderThickness="1"
											BorderBrush="{DynamicResource BorderBrush}">
										<StackPanel Spacing="6">
											<TextBlock Text="Approved TM" FontWeight="Bold"/>
											<StackPanel Name="ApprovedTmHost" Spacing="10"/>
										</StackPanel>
									</Border>

									<Border Padding="8"
											CornerRadius="6"
											BorderThickness="1"
											BorderBrush="{DynamicResource BorderBrush}">
										<StackPanel Spacing="6">
											<TextBlock Text="Reference / AI" FontWeight="Bold"/>
											<StackPanel Name="ReferenceTmHost" Spacing="10"/>
										</StackPanel>
									</Border>

								</StackPanel>
							</ScrollViewer>
						</Border>
					</Grid>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</UserControl>
