<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ReadZen.App.Models"
             xmlns:vm="using:ReadZen.App.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="ReadZen.App.Views.SearchTabView"
             x:DataType="vm:SearchTabViewModel">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="4">

        <Border Grid.Row="0"
                Background="{DynamicResource PanelAltBg}"
                Padding="6"
                CornerRadius="8">

            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="*,Auto,Auto,Auto"
                  RowSpacing="4"
                  ColumnSpacing="4">

                <TextBox Name="TxtQuery"
                         Grid.Row="0"
                         Grid.Column="0"
                         HorizontalAlignment="Stretch"
                         Text="{Binding Query}"
                         Watermark="Search Chinese text&#x2026;"
                         ToolTip.Tip="Enter Chinese characters or phrases to search"/>

                <Button Grid.Row="0" Grid.Column="1"
                        MinWidth="64"
                        Padding="8,3"
                        Content="Search"
                        Command="{Binding SearchCommand}"
                        ToolTip.Tip="Search the corpus"/>
                <Button Grid.Row="0" Grid.Column="2"
                        MinWidth="60"
                        Padding="8,3"
                        Content="Cancel"
                        IsEnabled="{Binding IsCancelEnabled}"
                        Command="{Binding CancelSearchCommand}"
                        ToolTip.Tip="Cancel current search"/>

                <StackPanel Grid.Row="0"
                            Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="4">
                    <Button Name="BtnBuildIndex"
                            MinWidth="52"
                            Padding="5,2"
                            FontSize="10.5"
                            Content="Update Index"
                            Command="{Binding BuildIndexCommand}"
                            ToolTip.Tip="Update the search index. Hold Shift to rebuild from scratch."/>
                    <Button Name="BtnExport"
                            MinWidth="52"
                            Padding="5,2"
                            FontSize="10.5"
                            Content="Export"
                            IsEnabled="{Binding IsExportEnabled}"
                            ToolTip.Tip="Export search results in a selectable format"/>
                    <Button Name="BtnCopySearchLink"
                            MinWidth="58"
                            Padding="5,2"
                            FontSize="10.5"
                            Content="Copy Link"
                            ToolTip.Tip="Copy a shareable link for the current search state"/>
                </StackPanel>

                <Grid Grid.Row="1"
                      Grid.Column="0"
                      Grid.ColumnSpan="4"
                      ColumnDefinitions="*,260"
                      ColumnSpacing="10">
                    <WrapPanel Grid.Column="0"
                               Orientation="Horizontal"
                               ItemWidth="NaN">
                        <CheckBox Content="Original"
                                  Margin="0,0,8,0"
                                  IsChecked="{Binding SearchOriginal}"
                                  ToolTip.Tip="Search in original Chinese texts"/>
                        <CheckBox Content="Translated"
                                  Margin="0,0,8,0"
                                  IsChecked="{Binding SearchTranslated}"
                                  ToolTip.Tip="Search in translated English texts"/>
                        <ComboBox Width="124"
                                  Margin="0,0,8,0"
                                  ItemsSource="{Binding StatusItems}"
                                  SelectedIndex="{Binding SelectedStatusIndex}"
                                  ToolTip.Tip="Filter by translation status"/>
                        <ComboBox Name="CmbTagFilter"
                                  MinWidth="120"
                                  MaxWidth="160"
                                  Margin="0,0,8,0"
                                  ItemsSource="{Binding TagFilterItems}"
                                  SelectedIndex="{Binding SelectedTagFilterIndex}"
                                  ToolTip.Tip="Filter to files tagged with a specific tag"/>
                        <ComboBox Width="92"
                                  Margin="0,0,8,0"
                                  ItemsSource="{Binding ContextItems}"
                                  SelectedIndex="{Binding SelectedContextIndex}"
                                  ToolTip.Tip="How much surrounding text to show"/>
                        <CheckBox Content="Zen only"
                                  IsChecked="{Binding ZenOnly}"
                                  ToolTip.Tip="Search only texts flagged as Zen/Chan Buddhist texts"/>
                    </WrapPanel>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Spacing="2">
                        <TextBlock Text="{Binding SummaryText}"
                                   HorizontalAlignment="Stretch"
                                   TextAlignment="Right"
                                   Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   MaxLines="2"/>
                        <ProgressBar Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding SearchProgressPercent}"
                                     IsIndeterminate="{Binding IsSearchProgressIndeterminate}"
                                     IsVisible="{Binding IsSearchProgressVisible}"/>
                        <TextBlock Text="{Binding ProgressText}"
                                   HorizontalAlignment="Stretch"
                                   TextAlignment="Right"
                                   Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   MaxLines="2"
                                   IsVisible="{Binding IsSearchProgressVisible}"/>
                        <TextBlock Text="{Binding ValidationMessage}"
                                   Foreground="{DynamicResource ErrorFg}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   MaxLines="2"
                                   IsVisible="{Binding HasValidationError}"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="4">

            <Grid>
                <TreeView Name="ResultsTree"
                          ItemsSource="{Binding ResultGroups}"
                          Background="{DynamicResource ControlBg}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1">

                    <TreeView.DataTemplates>

                        <TreeDataTemplate DataType="models:SearchResultGroup"
                                          ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding HeaderText}"
                                       ToolTip.Tip="{Binding Tooltip}"
                                       TextWrapping="NoWrap"/>
                        </TreeDataTemplate>

                        <DataTemplate DataType="models:SearchResultChild">
                            <StackPanel Orientation="Vertical" Spacing="2">
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="6"
                                      IsVisible="{Binding HasPrimaryStructuredDisplay}">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SideLabel}"
                                               Classes="muted"
                                               TextWrapping="NoWrap"
                                               VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1"
                                               TextWrapping="Wrap">
                                        <Run Text="{Binding LeftText}"/>
                                        <Run Text="{Binding MatchText}"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource NoteMarkerCommunityFg}"/>
                                        <Run Text="{Binding RightText}"/>
                                    </TextBlock>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="6"
                                      IsVisible="{Binding HasPrimaryContextOnlyDisplay}">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SideLabel}"
                                               Classes="muted"
                                               TextWrapping="NoWrap"
                                               VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding PrimarySnippetText}"
                                               TextWrapping="Wrap"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="6"
                                      Margin="0,1,0,0"
                                      IsVisible="{Binding HasSecondaryStructuredDisplay}">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SecondarySideLabel}"
                                               Classes="muted"
                                               TextWrapping="NoWrap"
                                               VerticalAlignment="Top"
                                               FontSize="11"/>
                                    <TextBlock Grid.Column="1"
                                               TextWrapping="Wrap"
                                               FontSize="11">
                                        <Run Text="{Binding SecondaryLeftText}"/>
                                        <Run Text="{Binding SecondaryMatchText}"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource NoteMarkerCommunityFg}"/>
                                        <Run Text="{Binding SecondaryRightText}"/>
                                    </TextBlock>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="6"
                                      Margin="0,1,0,0"
                                      IsVisible="{Binding HasSecondaryContextOnlyDisplay}">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SecondarySideLabel}"
                                               Classes="muted"
                                               TextWrapping="NoWrap"
                                               VerticalAlignment="Top"
                                               FontSize="11"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SecondarySnippetText}"
                                               TextWrapping="Wrap"
                                               FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>

                    </TreeView.DataTemplates>

                </TreeView>

                <Border IsVisible="{Binding IsSearchLoadingPlaceholderVisible}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="14"
                        Background="{DynamicResource PanelAltBg}"
                        BorderBrush="{DynamicResource PanelBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        IsHitTestVisible="False"
                        MaxWidth="320">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding ResultsLoadingText}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                        <ProgressBar Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding SearchProgressPercent}"
                                     IsIndeterminate="{Binding IsSearchProgressIndeterminate}"
                                     IsVisible="{Binding IsSearchProgressVisible}"/>
                        <TextBlock Text="{Binding ProgressText}"
                                   Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   IsVisible="{Binding IsSearchProgressVisible}"/>
                    </StackPanel>
                </Border>

                <Border Name="SearchEmptyState" IsVisible="{Binding IsEmptyStateVisible}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="20">
                    <TextBlock Text="Enter a search query above and press Search to find text across the corpus.&#x0a;Right-click result rows for passage links, search links, and Scholar actions."
                               TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                               Classes="muted"/>
                </Border>
            </Grid>

        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="4,2">

            <Expander IsExpanded="False">

                <Expander.Header>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                          ColumnSpacing="8">
                        <TextBlock Grid.Column="0"
                                   Text="Insights"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CoocSummaryText}"
                                   Classes="muted"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="2"
                                  Width="150"
                                  ItemsSource="{Binding AnalyticsScopeItems}"
                                  SelectedIndex="{Binding SelectedAnalyticsScopeIndex}"
                                  ToolTip.Tip="Choose whether insights use current search results or scan all texts"/>
                        <ComboBox Grid.Column="3"
                                  Width="220"
                                  ItemsSource="{Binding CoocMetricItems}"
                                  SelectedIndex="{Binding SelectedCoocMetricIndex}"
                                  ToolTip.Tip="Choose how to measure word associations"/>
                    </Grid>
                </Expander.Header>

                <Grid MaxHeight="700" Margin="0,6,0,0" RowDefinitions="Auto,Auto,*" RowSpacing="6">
                    <StackPanel Grid.Row="0" Spacing="2">
                        <ProgressBar Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding AnalyticsProgressPercent}"
                                     IsVisible="{Binding IsAnalyticsProgressVisible}"/>
                        <TextBlock Text="{Binding ZipfText}"
                                   Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Grid.Column="0"
                                Background="{DynamicResource PanelAltBg}"
                                CornerRadius="6"
                                Padding="6">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding LeftTitle}" Classes="muted"/>
                                <ItemsControl ItemsSource="{Binding CoocCharVisuals}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:AnalyticsBubbleItem">
                                            <Border Background="{DynamicResource PanelAltBg}"
                                                    BorderBrush="{DynamicResource PanelBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="8,4"
                                                    Margin="0,0,6,6"
                                                    MinHeight="24"
                                                    MinWidth="48"
                                                    Width="{Binding Width}"
                                                    Height="{Binding Height}"
                                                    ToolTip.Tip="{Binding Tooltip}">
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="{Binding FontSize}"
                                                           FontWeight="SemiBold"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1"
                                Background="{DynamicResource PanelAltBg}"
                                CornerRadius="6"
                                Padding="6">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding RightTitle}" Classes="muted"/>
                                <ItemsControl ItemsSource="{Binding CoocNgramVisuals}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:AnalyticsBubbleItem">
                                            <Border Background="{DynamicResource PanelAltBg}"
                                                    BorderBrush="{DynamicResource PanelBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="8,4"
                                                    Margin="0,0,6,6"
                                                    MinHeight="24"
                                                    MinWidth="48"
                                                    Width="{Binding Width}"
                                                    Height="{Binding Height}"
                                                    ToolTip.Tip="{Binding Tooltip}">
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="{Binding FontSize}"
                                                           FontWeight="SemiBold"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" IsVisible="{Binding IsMetricViewVisible}" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="10">
                        <!-- Charts row -->
                        <lvc:CartesianChart Grid.Row="0" Grid.Column="0"
                                            Series="{Binding CharChartSeries}"
                                            YAxes="{Binding CharChartYAxes}"
                                            Height="300"
                                            TooltipPosition="Center"
                                            ZoomMode="X"/>

                        <lvc:CartesianChart Grid.Row="0" Grid.Column="1"
                                            Series="{Binding NgramChartSeries}"
                                            YAxes="{Binding NgramChartYAxes}"
                                            Height="300"
                                            TooltipPosition="Center"
                                            ZoomMode="X"/>

                        <!-- Data table row -->
                        <Border Grid.Row="1" Grid.Column="0"
                                Background="{DynamicResource PanelAltBg}"
                                CornerRadius="6"
                                Padding="6">
                            <ListBox ItemsSource="{Binding CoocChars}" Height="100">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="models:CoocRow">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,4">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Key}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Column="1"
                                                         Height="8"
                                                         Minimum="0"
                                                         Maximum="1"
                                                         Value="{Binding BarRatio}"
                                                         VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Freq}"
                                                       Classes="muted"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Assoc, StringFormat={}{0:0.###}}"
                                                       Classes="muted"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1"
                                Background="{DynamicResource PanelAltBg}"
                                CornerRadius="6"
                                Padding="6">
                            <ListBox ItemsSource="{Binding CoocNgrams}" Height="100">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="models:CoocRow">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,4">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Key}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Column="1"
                                                         Height="8"
                                                         Minimum="0"
                                                         Maximum="1"
                                                         Value="{Binding BarRatio}"
                                                         VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Freq}"
                                                       Classes="muted"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Assoc, StringFormat={}{0:0.###}}"
                                                       Classes="muted"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="2"
                                  IsVisible="{Binding IsMetricGuideVisible}"
                                  MaxHeight="220"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Border Background="{DynamicResource PanelAltBg}"
                                CornerRadius="6"
                                Padding="10">
                            <TextBlock Text="{Binding MetricGuideText}"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </ScrollViewer>
                </Grid>

            </Expander>

        </Border>

    </Grid>
</UserControl>






