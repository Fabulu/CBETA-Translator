<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:CbetaTranslator.App.Models"
             xmlns:vm="using:CbetaTranslator.App.ViewModels"
             x:Class="CbetaTranslator.App.Views.SearchTabView"
             x:DataType="vm:SearchTabViewModel">

	<Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">

		<!-- ===================== -->
		<!-- SEARCH BAR -->
		<!-- ===================== -->
		<Border Grid.Row="0"
                Background="{DynamicResource PanelAltBg}"
                Padding="10"
                CornerRadius="8">

			<Grid RowDefinitions="Auto,Auto,Auto"
                  ColumnDefinitions="*,Auto,Auto,Auto"
                  RowSpacing="8"
                  ColumnSpacing="8">

				<TextBox Name="TxtQuery"
                         Grid.Row="0"
                         Grid.Column="0"
                         HorizontalAlignment="Stretch"
                         Text="{Binding Query}"
                         Watermark="Search (CJK phrases, substrings)&#x2026;"
                         ToolTip.Tip="Enter Chinese characters or phrases to search"/>

				<Button Grid.Row="0" Grid.Column="1"
                        Content="Search"
                        Command="{Binding SearchCommand}"
                        ToolTip.Tip="Search the corpus"/>
				<Button Grid.Row="0" Grid.Column="2"
                        Content="Cancel"
                        IsEnabled="{Binding IsCancelEnabled}"
                        Command="{Binding CancelSearchCommand}"
                        ToolTip.Tip="Cancel current search"/>
				<Button Name="BtnBuildIndex" Grid.Row="0" Grid.Column="3"
                        Content="Force Rebuild Index"
                        Command="{Binding BuildIndexCommand}"
                        ToolTip.Tip="Force a full rebuild of the search index. The index is auto-built when the corpus changes."/>

				<!-- Row 1 -->
				<Grid Grid.Row="1"
                      Grid.Column="0"
                      Grid.ColumnSpan="4"
                      ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*"
                      ColumnSpacing="14">

					<!-- Left cluster -->
					<CheckBox Grid.Column="0"
                              Content="Original"
                              IsChecked="{Binding SearchOriginal}"
                              ToolTip.Tip="Search in original Chinese texts"/>

					<CheckBox Grid.Column="1"
                              Content="Translated"
                              IsChecked="{Binding SearchTranslated}"
                              ToolTip.Tip="Search in translated English texts"/>

					<TextBlock Grid.Column="2"
                               Text="Status:"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Classes="muted"/>

					<ComboBox Grid.Column="3"
                              Width="160"
                              ItemsSource="{Binding StatusItems}"
                              SelectedIndex="{Binding SelectedStatusIndex}"
                              ToolTip.Tip="Filter results by translation status"/>

					<TextBlock Grid.Column="4"
                               Text="Tag:"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Classes="muted"/>

					<ComboBox Grid.Column="5"
                              Name="CmbTagFilter"
                              MinWidth="120"
                              ItemsSource="{Binding TagFilterItems}"
                              SelectedIndex="{Binding SelectedTagFilterIndex}"
                              ToolTip.Tip="Filter results to files tagged with a specific tag"/>

					<TextBlock Grid.Column="6"
                               Text="Context:"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Classes="muted"/>

					<ComboBox Grid.Column="7"
                              Width="120"
                              ItemsSource="{Binding ContextItems}"
                              SelectedIndex="{Binding SelectedContextIndex}"
                              ToolTip.Tip="Number of surrounding characters to show in results"/>

					<!-- Right cluster (Zen-only) -->
					<CheckBox Grid.Column="10"
                              Content="Zen Texts Only"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right"
                              IsChecked="{Binding ZenOnly}"
                              ToolTip.Tip="Search only in texts flagged as Zen/Chan Buddhist texts"/>
				</Grid>

				<!-- Validation message -->
				<TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                           Text="{Binding ValidationMessage}"
                           Foreground="{DynamicResource ErrorFg}"
                           FontSize="12"
                           IsVisible="{Binding HasValidationError}"
                           Margin="0,4,0,0"
                           VerticalAlignment="Bottom"/>

			</Grid>
		</Border>

		<!-- ===================== -->
		<!-- SUMMARY + PROGRESS -->
		<!-- ===================== -->
		<Border Grid.Row="1"
                Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">

			<DockPanel LastChildFill="True">

				<!-- Left -->
				<TextBlock DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Text="{Binding SummaryText}"
                           Classes="muted"/>

				<!-- Right -->
				<Button DockPanel.Dock="Right"
                        Name="BtnExportTsv"
                        Content="Export Results"
                        IsEnabled="{Binding IsExportEnabled}"
                        ToolTip.Tip="Export search results as a tab-separated values (.tsv) file"/>

				<!-- Center (fills space) -->
				<TextBlock Margin="20,0,20,0"
                           VerticalAlignment="Center"
                           Text="{Binding ProgressText}"
                           TextWrapping="Wrap"
                           Classes="muted"/>

			</DockPanel>
		</Border>

		<!-- ===================== -->
		<!-- CO-OCCURRENCE PANEL -->
		<!-- ===================== -->
		<Border Grid.Row="2"
                Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">

			<Expander IsExpanded="False">

				<Expander.Header>
					<DockPanel LastChildFill="True">
						<TextBlock Text="Co-occurrence Analysis" DockPanel.Dock="Left" FontWeight="SemiBold"/>
						<ComboBox DockPanel.Dock="Right"
                                  Width="220"
                                  ItemsSource="{Binding CoocMetricItems}"
                                  SelectedIndex="{Binding SelectedCoocMetricIndex}"
                                  ToolTip.Tip="Select statistical metric for co-occurrence analysis"/>
					</DockPanel>
				</Expander.Header>

				<Grid MaxHeight="360">

					<Grid IsVisible="{Binding IsMetricViewVisible}"
                          ColumnDefinitions="*,*"
                          RowDefinitions="Auto,*"
                          ColumnSpacing="10"
                          RowSpacing="8">

						<StackPanel Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Spacing="12">
							<TextBlock Text="{Binding CoocSummaryText}"
                                       Classes="muted"/>
						</StackPanel>

						<!-- LEFT PANEL -->
						<Border Grid.Row="1" Grid.Column="0"
                                Background="{DynamicResource PanelAltBg}"
                                CornerRadius="6"
                                Padding="8">
							<StackPanel Spacing="6">
								<TextBlock Text="{Binding LeftTitle}"
                                           Classes="muted"/>
								<ListBox ItemsSource="{Binding CoocChars}" Height="220"/>
							</StackPanel>
						</Border>

						<!-- RIGHT PANEL -->
						<Border Grid.Row="1" Grid.Column="1"
                                Background="{DynamicResource PanelAltBg}"
                                CornerRadius="6"
                                Padding="8">
							<StackPanel Spacing="6">
								<TextBlock Text="{Binding RightTitle}"
                                           Classes="muted"/>
								<ListBox ItemsSource="{Binding CoocNgrams}" Height="220"/>
								<TextBlock Text="{Binding ZipfText}"
                                           TextWrapping="Wrap"
                                           Classes="muted"/>
							</StackPanel>
						</Border>

					</Grid>

					<!-- Metric guide -->
					<ScrollViewer IsVisible="{Binding IsMetricGuideVisible}"
                                  MaxHeight="360"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

						<Border Background="{DynamicResource PanelAltBg}"
                                CornerRadius="6"
                                Padding="10">
							<TextBlock Text="{Binding MetricGuideText}"
                                       TextWrapping="Wrap"/>
						</Border>

					</ScrollViewer>

				</Grid>

			</Expander>

		</Border>

		<!-- ===================== -->
		<!-- RESULTS TREE -->
		<!-- ===================== -->
		<Border Grid.Row="3"
                Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">

			<Grid>
				<TreeView Name="ResultsTree"
                          ItemsSource="{Binding ResultGroups}"
                          Background="{DynamicResource ControlBg}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1">

					<TreeView.DataTemplates>

						<TreeDataTemplate DataType="models:SearchResultGroup"
                                          ItemsSource="{Binding Children}">
							<TextBlock Text="{Binding HeaderText}"
                                       ToolTip.Tip="{Binding Tooltip}"
                                       TextWrapping="NoWrap"/>
						</TreeDataTemplate>

						<DataTemplate DataType="models:SearchResultChild">
							<StackPanel Orientation="Vertical" Spacing="0">
								<StackPanel Orientation="Horizontal" Spacing="0">
									<TextBlock Text="{Binding SideLabel}"
                                               Classes="muted"
                                               TextWrapping="NoWrap"/>
									<TextBlock Text="{Binding LeftText}"
                                               TextWrapping="NoWrap"/>
									<TextBlock Text="{Binding MatchText}"
                                               TextWrapping="NoWrap"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource NoteMarkerCommunityFg}"/>
									<TextBlock Text="{Binding RightText}"
                                               TextWrapping="NoWrap"/>
								</StackPanel>
								<StackPanel Orientation="Horizontal" Spacing="0"
                                               IsVisible="{Binding HasSecondaryDisplayText}">
									<TextBlock Text="{Binding SecondarySideLabel}"
                                               Classes="muted"
                                               TextWrapping="NoWrap"/>
									<TextBlock Text="{Binding SecondaryLeftText}"
                                               TextWrapping="NoWrap"/>
									<TextBlock Text="{Binding SecondaryMatchText}"
                                               TextWrapping="NoWrap"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource NoteMarkerCommunityFg}"/>
									<TextBlock Text="{Binding SecondaryRightText}"
                                               TextWrapping="NoWrap"/>
								</StackPanel>
							</StackPanel>
						</DataTemplate>

					</TreeView.DataTemplates>

				</TreeView>

				<Border Name="SearchEmptyState" IsVisible="{Binding IsEmptyStateVisible}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="20">
					<TextBlock Text="Enter a search query above and press Search to find text across the corpus.&#x0a;The search index is built automatically when you open a corpus."
                               TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                               Classes="muted"/>
				</Border>
			</Grid>

		</Border>

	</Grid>
</UserControl>
