<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ReadZen.App.Models"
             xmlns:vm="using:ReadZen.App.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="ReadZen.App.Views.SearchTabView"
             x:DataType="vm:SearchTabViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="4">

        <Border Grid.Row="0"
                Background="{DynamicResource PanelAltBg}"
                Padding="6"
                CornerRadius="8">

            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="*,Auto,Auto,Auto"
                  RowSpacing="4"
                  ColumnSpacing="4">

                <TextBox Name="TxtQuery"
                         Grid.Row="0"
                         Grid.Column="0"
                         HorizontalAlignment="Stretch"
                         Text="{Binding Query}"
                         Watermark="Search Chinese text&#x2026;"
                         AutomationProperties.Name="Search query"
                         ToolTip.Tip="Enter Chinese characters or phrases to search"/>

                <Button Grid.Row="0" Grid.Column="1"
                        MinWidth="64"
                        Padding="8,3"
                        Content="Search"
                        Command="{Binding SearchCommand}"
                        AutomationProperties.Name="Search"
                        ToolTip.Tip="Search the corpus"/>
                <Button Grid.Row="0" Grid.Column="2"
                        MinWidth="60"
                        Padding="8,3"
                        Content="Cancel"
                        IsEnabled="{Binding IsCancelEnabled}"
                        Command="{Binding CancelSearchCommand}"
                        AutomationProperties.Name="Cancel search"
                        ToolTip.Tip="Cancel current search"/>

                <StackPanel Grid.Row="0"
                            Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="4">
                    <Button Name="BtnBuildIndex"
                            MinWidth="52"
                            Padding="5,2"
                            FontSize="10.5"
                            Content="Update Index"
                            Command="{Binding BuildIndexCommand}"
                            AutomationProperties.Name="Build search index"
                            ToolTip.Tip="Update the search index. Hold Shift to rebuild from scratch."/>
                    <Button Name="BtnExport"
                            MinWidth="52"
                            Padding="5,2"
                            FontSize="10.5"
                            Content="Export"
                            IsEnabled="{Binding IsExportEnabled}"
                            AutomationProperties.Name="Export results"
                            ToolTip.Tip="Export search results in a selectable format"/>
                    <Button Name="BtnCopySearchLink"
                            MinWidth="58"
                            Padding="5,2"
                            FontSize="10.5"
                            Content="Copy Link"
                            ToolTip.Tip="Copy a shareable link for the current search state"/>
                </StackPanel>

                <Grid Grid.Row="1"
                      Grid.Column="0"
                      Grid.ColumnSpan="4"
                      ColumnDefinitions="*,260"
                      ColumnSpacing="10">
                    <WrapPanel Grid.Column="0"
                               Orientation="Horizontal"
                               ItemWidth="NaN">
                        <CheckBox Content="Original"
                                  Margin="0,0,8,0"
                                  IsChecked="{Binding SearchOriginal}"
                                  ToolTip.Tip="Search in original Chinese texts"/>
                        <CheckBox Content="Translated"
                                  Margin="0,0,8,0"
                                  IsChecked="{Binding SearchTranslated}"
                                  ToolTip.Tip="Search in translated English texts"/>
                        <ComboBox Width="124"
                                  Margin="0,0,8,0"
                                  ItemsSource="{Binding StatusItems}"
                                  SelectedIndex="{Binding SelectedStatusIndex}"
                                  ToolTip.Tip="Filter by translation status"/>
                        <ComboBox Name="CmbTagFilter"
                                  MinWidth="120"
                                  MaxWidth="160"
                                  Margin="0,0,8,0"
                                  ItemsSource="{Binding TagFilterItems}"
                                  SelectedIndex="{Binding SelectedTagFilterIndex}"
                                  ToolTip.Tip="Filter to files tagged with a specific tag"/>
                        <ComboBox Width="92"
                                  Margin="0,0,8,0"
                                  ItemsSource="{Binding ContextItems}"
                                  SelectedIndex="{Binding SelectedContextIndex}"
                                  ToolTip.Tip="How much surrounding text to show"/>
                        <CheckBox Content="Zen only"
                                  IsChecked="{Binding ZenOnly}"
                                  AutomationProperties.Name="Restrict to Zen texts only"
                                  ToolTip.Tip="Search only texts flagged as Zen/Chan Buddhist texts"/>
                    </WrapPanel>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Spacing="2">
                        <TextBlock Text="{Binding SummaryText}"
                                   HorizontalAlignment="Stretch"
                                   TextAlignment="Right"
                                   Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   MaxLines="2"/>
                        <ProgressBar Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding SearchProgressPercent}"
                                     IsIndeterminate="{Binding IsSearchProgressIndeterminate}"
                                     IsVisible="{Binding IsSearchProgressVisible}"/>
                        <TextBlock Text="{Binding ProgressText}"
                                   HorizontalAlignment="Stretch"
                                   TextAlignment="Right"
                                   Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   MaxLines="2"
                                   IsVisible="{Binding IsSearchProgressVisible}"/>
                        <TextBlock Text="{Binding ValidationMessage}"
                                   Foreground="{DynamicResource ErrorFg}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   MaxLines="2"
                                   IsVisible="{Binding HasValidationError}"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedSearchSubTabIndex}"
                    AutomationProperties.Name="Search results and analytics">

            <TabItem Header="Results">
                <Border Background="{DynamicResource PanelBg}"
                        BorderBrush="{DynamicResource PanelBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="4">

                    <Grid RowDefinitions="Auto,*">
                        <!-- Filter indicator when co-occurrence bar is clicked -->
                        <Border Grid.Row="0"
                                IsVisible="{Binding IsCoocFilterActive}"
                                Background="#33457B9D"
                                CornerRadius="4"
                                Padding="8,4"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding CoocFilterTerm, StringFormat='Filtered by: {0}'}"
                                           FontSize="12"/>
                                <Button Content="&#x2715; Clear"
                                        Command="{Binding ClearCoocFilterCommand}"
                                        Padding="4,2"
                                        FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <TreeView Grid.Row="1"
                                  Name="ResultsTree"
                                  ItemsSource="{Binding ResultGroups}"
                                  Background="{DynamicResource ControlBg}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="1">

                            <TreeView.DataTemplates>

                                <TreeDataTemplate DataType="models:SearchResultGroup"
                                                  ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding HeaderText}"
                                               ToolTip.Tip="{Binding Tooltip}"
                                               TextWrapping="NoWrap"/>
                                </TreeDataTemplate>

                                <DataTemplate DataType="models:SearchResultChild">
                                    <StackPanel Orientation="Vertical" Spacing="2">
                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="6"
                                              IsVisible="{Binding HasPrimaryStructuredDisplay}">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding SideLabel}"
                                                       Classes="muted"
                                                       TextWrapping="NoWrap"
                                                       VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="1"
                                                       TextWrapping="Wrap">
                                                <Run Text="{Binding LeftText}"/>
                                                <Run Text="{Binding MatchText}"
                                                     FontWeight="SemiBold"
                                                     Foreground="{DynamicResource NoteMarkerCommunityFg}"/>
                                                <Run Text="{Binding RightText}"/>
                                            </TextBlock>
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="6"
                                              IsVisible="{Binding HasPrimaryContextOnlyDisplay}">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding SideLabel}"
                                                       Classes="muted"
                                                       TextWrapping="NoWrap"
                                                       VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PrimarySnippetText}"
                                                       TextWrapping="Wrap"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="6"
                                              Margin="0,1,0,0"
                                              IsVisible="{Binding HasSecondaryStructuredDisplay}">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding SecondarySideLabel}"
                                                       Classes="muted"
                                                       TextWrapping="NoWrap"
                                                       VerticalAlignment="Top"
                                                       FontSize="11"/>
                                            <TextBlock Grid.Column="1"
                                                       TextWrapping="Wrap"
                                                       FontSize="11">
                                                <Run Text="{Binding SecondaryLeftText}"/>
                                                <Run Text="{Binding SecondaryMatchText}"
                                                     FontWeight="SemiBold"
                                                     Foreground="{DynamicResource NoteMarkerCommunityFg}"/>
                                                <Run Text="{Binding SecondaryRightText}"/>
                                            </TextBlock>
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="6"
                                              Margin="0,1,0,0"
                                              IsVisible="{Binding HasSecondaryContextOnlyDisplay}">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding SecondarySideLabel}"
                                                       Classes="muted"
                                                       TextWrapping="NoWrap"
                                                       VerticalAlignment="Top"
                                                       FontSize="11"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SecondarySnippetText}"
                                                       TextWrapping="Wrap"
                                                       FontSize="11"/>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>

                            </TreeView.DataTemplates>

                        </TreeView>

                        <Border IsVisible="{Binding IsSearchLoadingPlaceholderVisible}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Padding="14"
                                Background="{DynamicResource PanelAltBg}"
                                BorderBrush="{DynamicResource PanelBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                IsHitTestVisible="False"
                                MaxWidth="320">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding ResultsLoadingText}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                                <ProgressBar Height="8"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding SearchProgressPercent}"
                                             IsIndeterminate="{Binding IsSearchProgressIndeterminate}"
                                             IsVisible="{Binding IsSearchProgressVisible}"/>
                                <TextBlock Text="{Binding ProgressText}"
                                           Classes="muted"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           IsVisible="{Binding IsSearchProgressVisible}"/>
                            </StackPanel>
                        </Border>

                        <Border Name="SearchEmptyState" IsVisible="{Binding IsEmptyStateVisible}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Padding="20">
                            <TextBlock Text="Enter a search query above and press Search to find text across the corpus.&#x0a;Right-click result rows for passage links, search links, and Scholar actions."
                                       TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                                       Classes="muted"/>
                        </Border>
                    </Grid>

                </Border>
            </TabItem>

            <TabItem Header="Insights">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,6,0,0" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <ComboBox Width="150"
                                  ItemsSource="{Binding AnalyticsScopeItems}"
                                  SelectedIndex="{Binding SelectedAnalyticsScopeIndex}"
                                  AutomationProperties.Name="Analytics scope"
                                  ToolTip.Tip="Current Results: only your search hits. Zen Corpus: the 8 canonical Zen texts. Full Corpus: all ~5000 CBETA texts."/>
                        <ComboBox Width="220"
                                  ItemsSource="{Binding CoocMetricItems}"
                                  SelectedIndex="{Binding SelectedCoocMetricIndex}"
                                  AutomationProperties.Name="Co-occurrence metric"
                                  ToolTip.Tip="{Binding MetricTooltip}"/>
                        <TextBlock Text="{Binding CoocSummaryText}"
                                   Classes="muted"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <Button Content="Copy TSV"
                                Command="{Binding ExportAnalyticsTsvCommand}"
                                ToolTip.Tip="Copy co-occurrence data to clipboard as TSV"
                                Padding="6,3"
                                FontSize="11"
                                Margin="8,0,0,0"/>
                        <Button Content="Save TSV"
                                Command="{Binding SaveAnalyticsTsvCommand}"
                                ToolTip.Tip="Save co-occurrence data to a TSV file"
                                Padding="6,3"
                                FontSize="11"
                                Margin="4,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="2">
                        <ProgressBar Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding AnalyticsProgressPercent}"
                                     IsVisible="{Binding IsAnalyticsProgressVisible}"/>
                        <TextBlock Text="{Binding ZipfText}"
                                   Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Grid.Column="0"
                                Background="{DynamicResource PanelAltBg}"
                                CornerRadius="6"
                                Padding="6">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding LeftTitle}" Classes="muted"/>
                                <ItemsControl ItemsSource="{Binding CoocCharVisuals}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:AnalyticsBubbleItem">
                                            <Border Background="{DynamicResource PanelAltBg}"
                                                    BorderBrush="{DynamicResource PanelBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="8,4"
                                                    Margin="0,0,6,6"
                                                    MinHeight="24"
                                                    MinWidth="48"
                                                    Width="{Binding Width}"
                                                    Height="{Binding Height}"
                                                    ToolTip.Tip="{Binding Tooltip}">
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="{Binding FontSize}"
                                                           FontWeight="SemiBold"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1"
                                Background="{DynamicResource PanelAltBg}"
                                CornerRadius="6"
                                Padding="6">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding RightTitle}" Classes="muted"/>
                                <ItemsControl ItemsSource="{Binding CoocNgramVisuals}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:AnalyticsBubbleItem">
                                            <Border Background="{DynamicResource PanelAltBg}"
                                                    BorderBrush="{DynamicResource PanelBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="8,4"
                                                    Margin="0,0,6,6"
                                                    MinHeight="24"
                                                    MinWidth="48"
                                                    Width="{Binding Width}"
                                                    Height="{Binding Height}"
                                                    ToolTip.Tip="{Binding Tooltip}">
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="{Binding FontSize}"
                                                           FontWeight="SemiBold"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" IsVisible="{Binding IsMetricViewVisible}" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="10">
                        <!-- Chart titles -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,4">
                            <TextBlock Text="Common Neighbors" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Characters that appear most often alongside your search term, ranked by association strength."
                                       Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,4">
                            <TextBlock Text="Common Phrases" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Multi-character expressions clustered around your search term — compound words, technical terms, and stock phrases."
                                       Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Charts row -->
                        <lvc:CartesianChart Grid.Row="1" Grid.Column="0"
                                            Series="{Binding CharChartSeries}"
                                            YAxes="{Binding CharChartYAxes}"
                                            Height="300"
                                            TooltipPosition="Center"
                                            ZoomMode="X"
                                            AutomationProperties.Name="Character co-occurrences"
                                            ToolTip.Tip="Longer bars = stronger association with your search term. High-ranking characters appear near your search term more than expected by chance. Look for surprises — these reveal thematic connections."/>

                        <lvc:CartesianChart Grid.Row="1" Grid.Column="1"
                                            Series="{Binding NgramChartSeries}"
                                            YAxes="{Binding NgramChartYAxes}"
                                            Height="300"
                                            TooltipPosition="Center"
                                            ZoomMode="X"
                                            AutomationProperties.Name="N-gram co-occurrences"
                                            ToolTip.Tip="Each bar is a multi-character phrase found near your search term. Phrases you don't recognize are worth looking up — they may be technical vocabulary specific to this genre."/>

                        <!-- Scatter plot title -->
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,4">
                            <TextBlock Text="Frequency vs. Association" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Every co-occurring term mapped by how often it appears (horizontal) vs. how strongly it's linked to your search (vertical). Top-right = frequent AND distinctively associated."
                                       Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Scatter plot: collocational landscape -->
                        <lvc:CartesianChart Grid.Row="3" Grid.ColumnSpan="2"
                                            Series="{Binding ScatterSeries}"
                                            XAxes="{Binding ScatterXAxes}"
                                            YAxes="{Binding ScatterYAxes}"
                                            Height="250"
                                            TooltipPosition="Center"
                                            ZoomMode="Both"
                                            AutomationProperties.Name="Collocational landscape scatter plot"
                                            ToolTip.Tip="Horizontal: frequency (each step doubles). Vertical: association strength. Blue = characters, Gold = phrases. Top-right = highest priority vocabulary (frequent AND linked). Top-left = rare but specific. Bottom-right = common but generic."/>

                        <!-- Data table title -->
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,4">
                            <TextBlock Text="Detailed Data" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Full numbers behind the charts. High dominance (&#x26A0;) means occurrences concentrated in one text."
                                       Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Data table row -->
                        <Border Grid.Row="5" Grid.Column="0"
                                Background="{DynamicResource PanelAltBg}"
                                CornerRadius="6"
                                Padding="6">
                            <ListBox ItemsSource="{Binding CoocChars}" MaxHeight="250">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="models:CoocRow">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,4">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Key}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="&#x26A0;"
                                                       FontSize="10"
                                                       Foreground="#FFE57373"
                                                       IsVisible="{Binding IsDominanceHigh}"
                                                       ToolTip.Tip="Single-text artifact: &gt;80% from one file"
                                                       VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Column="2"
                                                         Height="8"
                                                         Minimum="0"
                                                         Maximum="1"
                                                         Value="{Binding BarRatio}"
                                                         VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Freq}"
                                                       Classes="muted"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding Assoc, StringFormat={}{0:0.###}}"
                                                       Classes="muted"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <Border Grid.Row="5" Grid.Column="1"
                                Background="{DynamicResource PanelAltBg}"
                                CornerRadius="6"
                                Padding="6">
                            <ListBox ItemsSource="{Binding CoocNgrams}" MaxHeight="250">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="models:CoocRow">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,4">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Key}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="&#x26A0;"
                                                       FontSize="10"
                                                       Foreground="#FFE57373"
                                                       IsVisible="{Binding IsDominanceHigh}"
                                                       ToolTip.Tip="Single-text artifact: &gt;80% from one file"
                                                       VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Column="2"
                                                         Height="8"
                                                         Minimum="0"
                                                         Maximum="1"
                                                         Value="{Binding BarRatio}"
                                                         VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Freq}"
                                                       Classes="muted"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding Assoc, StringFormat={}{0:0.###}}"
                                                       Classes="muted"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="3"
                                  IsVisible="{Binding IsMetricGuideVisible}"
                                  MaxHeight="220"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Border Background="{DynamicResource PanelAltBg}"
                                CornerRadius="6"
                                Padding="10">
                            <TextBlock Text="{Binding MetricGuideText}"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </ScrollViewer>
                </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>

    </Grid>
</UserControl>






