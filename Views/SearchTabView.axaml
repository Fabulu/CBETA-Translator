<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:CbetaTranslator.App.Models"
             xmlns:vm="using:CbetaTranslator.App.ViewModels"
             x:Class="CbetaTranslator.App.Views.SearchTabView"
             x:DataType="vm:SearchTabViewModel">

	<Grid RowDefinitions="Auto,Auto,*" RowSpacing="4">

		<!-- ===================== -->
		<!-- SEARCH HEADER -->
		<!-- ===================== -->
		<Border Grid.Row="0"
                Background="{DynamicResource PanelAltBg}"
                Padding="6"
                CornerRadius="8">

			<Grid RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnDefinitions="*,Auto,Auto,Auto"
                  RowSpacing="4"
                  ColumnSpacing="4">

				<TextBox Name="TxtQuery"
                         Grid.Row="0"
                         Grid.Column="0"
                         HorizontalAlignment="Stretch"
                         Text="{Binding Query}"
                         Watermark="Search CJK phrases or substrings&#x2026;"
                         ToolTip.Tip="Enter Chinese characters or phrases to search"/>

				<Button Grid.Row="0" Grid.Column="1"
                        MinWidth="64"
                        Padding="8,3"
                        Content="Search"
                        Command="{Binding SearchCommand}"
                        ToolTip.Tip="Search the corpus"/>
				<Button Grid.Row="0" Grid.Column="2"
                        MinWidth="60"
                        Padding="8,3"
                        Content="Cancel"
                        IsEnabled="{Binding IsCancelEnabled}"
                        Command="{Binding CancelSearchCommand}"
                        ToolTip.Tip="Cancel current search"/>


				<StackPanel Grid.Row="0"
                            Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="4">
					<Button Name="BtnBuildIndex"
                            MinWidth="64"
                            Padding="6,3"
                            FontSize="11"
                            Content="Rebuild"
                            Command="{Binding BuildIndexCommand}"
                            ToolTip.Tip="Force a full rebuild of the search index. Hold Shift when clicking for a forced rebuild."/>
					<Button Name="BtnExport"
                            MinWidth="60"
                            Padding="6,3"
                            FontSize="11"
                            Content="Export"
                            IsEnabled="{Binding IsExportEnabled}"
                            ToolTip.Tip="Export search results in a selectable format"/>
                    <Button Name="BtnCopySearchLink"
                            MinWidth="72"
                            Padding="6,3"
                            FontSize="11"
                            Content="Copy Link"
                            ToolTip.Tip="Copy a deep link for the current search state"/>
				</StackPanel>

				<WrapPanel Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="4"
                           Orientation="Horizontal"
                           ItemWidth="NaN">
					<CheckBox Content="Original"
                              Margin="0,0,10,0"
                              IsChecked="{Binding SearchOriginal}"
                              ToolTip.Tip="Search in original Chinese texts"/>
					<CheckBox Content="Translated"
                              Margin="0,0,10,0"
                              IsChecked="{Binding SearchTranslated}"
                              ToolTip.Tip="Search in translated English texts"/>
					<TextBlock Text="Status"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Classes="muted"/>
					<ComboBox Width="132"
                              Margin="0,0,10,0"
                              ItemsSource="{Binding StatusItems}"
                              SelectedIndex="{Binding SelectedStatusIndex}"
                              ToolTip.Tip="Filter results by translation status"/>
					<TextBlock Text="Tag"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Classes="muted"/>
					<ComboBox Name="CmbTagFilter"
                              MinWidth="120"
                              Margin="0,0,10,0"
                              ItemsSource="{Binding TagFilterItems}"
                              SelectedIndex="{Binding SelectedTagFilterIndex}"
                              ToolTip.Tip="Filter results to files tagged with a specific tag"/>
					<TextBlock Text="Context"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Classes="muted"/>
					<ComboBox Width="88"
                              Margin="0,0,10,0"
                              ItemsSource="{Binding ContextItems}"
                              SelectedIndex="{Binding SelectedContextIndex}"
                              ToolTip.Tip="Number of surrounding characters to show in results"/>
					<CheckBox Content="Zen only"
                              IsChecked="{Binding ZenOnly}"
                              ToolTip.Tip="Search only texts flagged as Zen/Chan Buddhist texts"/>
				</WrapPanel>

				<Grid Grid.Row="2"
                      Grid.Column="0"
                      Grid.ColumnSpan="4"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
					<TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{Binding SummaryText}"
                           Classes="muted"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"/>
					<TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="{Binding ProgressText}"
                           Classes="muted"
                           FontSize="11"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="240"/>
				</Grid>

				<TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
                           Text="{Binding ValidationMessage}"
                           Foreground="{DynamicResource ErrorFg}"
                           FontSize="12"
                           IsVisible="{Binding HasValidationError}"
                           Margin="0,2,0,0"
                           VerticalAlignment="Bottom"/>

			</Grid>
		</Border>

		<!-- ===================== -->
		<!-- CO-OCCURRENCE PANEL -->
		<!-- ===================== -->
		<Border Grid.Row="1"
                Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6">

			<Expander IsExpanded="False">

				<Expander.Header>
					<DockPanel LastChildFill="True">
						<TextBlock Text="Co-occurrence Analysis" DockPanel.Dock="Left" FontWeight="SemiBold"/>
						<ComboBox DockPanel.Dock="Right"
                                  Width="220"
                                  ItemsSource="{Binding CoocMetricItems}"
                                  SelectedIndex="{Binding SelectedCoocMetricIndex}"
                                  ToolTip.Tip="Select statistical metric for co-occurrence analysis"/>
					</DockPanel>
				</Expander.Header>

				<Grid MaxHeight="360">

					<Grid IsVisible="{Binding IsMetricViewVisible}"
                          ColumnDefinitions="*,*"
                          RowDefinitions="Auto,*,Auto,*"
                          ColumnSpacing="10"
                          RowSpacing="4">

						<StackPanel Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Spacing="12">
							<TextBlock Text="{Binding CoocSummaryText}"
                                       Classes="muted"/>
						</StackPanel>

						<!-- LEFT PANEL -->
						<Border Grid.Row="1" Grid.Column="0"
                                Background="{DynamicResource PanelAltBg}"
                                CornerRadius="6"
                                Padding="6">
							<StackPanel Spacing="6">
								<TextBlock Text="{Binding LeftTitle}"
                                           Classes="muted"/>
								<ListBox ItemsSource="{Binding CoocChars}" Height="220"/>
							</StackPanel>
						</Border>

						<!-- RIGHT PANEL -->
						<Border Grid.Row="1" Grid.Column="1"
                                Background="{DynamicResource PanelAltBg}"
                                CornerRadius="6"
                                Padding="6">
							<StackPanel Spacing="6">
								<TextBlock Text="{Binding RightTitle}"
                                           Classes="muted"/>
								<ListBox ItemsSource="{Binding CoocNgrams}" Height="220"/>
								<TextBlock Text="{Binding ZipfText}"
                                           TextWrapping="Wrap"
                                           Classes="muted"/>
							</StackPanel>
						</Border>

					</Grid>

					<!-- Metric guide -->
					<ScrollViewer IsVisible="{Binding IsMetricGuideVisible}"
                                  MaxHeight="360"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

						<Border Background="{DynamicResource PanelAltBg}"
                                CornerRadius="6"
                                Padding="10">
							<TextBlock Text="{Binding MetricGuideText}"
                                       TextWrapping="Wrap"/>
						</Border>

					</ScrollViewer>

				</Grid>

			</Expander>

		</Border>

		<!-- ===================== -->
		<!-- RESULTS TREE -->
		<!-- ===================== -->
		<Border Grid.Row="2"
                Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6">

			<Grid RowDefinitions="Auto,*">
                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,4">
                    <TextBlock Text="Use Copy Link for the current search, or right-click a result row for passage and search links." Classes="muted" FontSize="11"/>
                </DockPanel>
				<TreeView Grid.Row="1" Name="ResultsTree"
                          ItemsSource="{Binding ResultGroups}"
                          Background="{DynamicResource ControlBg}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1">

					<TreeView.DataTemplates>

						<TreeDataTemplate DataType="models:SearchResultGroup"
                                          ItemsSource="{Binding Children}">
							<TextBlock Text="{Binding HeaderText}"
                                       ToolTip.Tip="{Binding Tooltip}"
                                       TextWrapping="NoWrap"/>
						</TreeDataTemplate>

						<DataTemplate DataType="models:SearchResultChild">
							<StackPanel Orientation="Vertical" Spacing="0">
								<StackPanel Orientation="Horizontal" Spacing="0"
								            IsVisible="{Binding HasPrimaryStructuredDisplay}">
									<TextBlock Text="{Binding SideLabel}"
									           Classes="muted"
									           TextWrapping="NoWrap"/>
									<TextBlock Text="{Binding LeftText}"
									           TextWrapping="NoWrap"/>
									<TextBlock Text="{Binding MatchText}"
									           TextWrapping="NoWrap"
									           FontWeight="SemiBold"
									           Foreground="{DynamicResource NoteMarkerCommunityFg}"/>
									<TextBlock Text="{Binding RightText}"
									           TextWrapping="NoWrap"/>
								</StackPanel>
								<StackPanel Orientation="Horizontal" Spacing="0"
								            IsVisible="{Binding HasPrimaryContextOnlyDisplay}">
									<TextBlock Text="{Binding SideLabel}"
									           Classes="muted"
									           TextWrapping="NoWrap"/>
									<TextBlock Text="{Binding PrimarySnippetText}"
									           TextWrapping="NoWrap"/>
								</StackPanel>
								<StackPanel Orientation="Horizontal" Spacing="0"
								            IsVisible="{Binding HasSecondaryStructuredDisplay}">
									<TextBlock Text="{Binding SecondarySideLabel}"
									           Classes="muted"
									           TextWrapping="NoWrap"
									           FontSize="11"/>
									<TextBlock Text="{Binding SecondaryLeftText}"
									           TextWrapping="NoWrap"
									           FontSize="11"/>
									<TextBlock Text="{Binding SecondaryMatchText}"
									           TextWrapping="NoWrap"
									           FontSize="11"
									           FontWeight="SemiBold"
									           Foreground="{DynamicResource NoteMarkerCommunityFg}"/>
									<TextBlock Text="{Binding SecondaryRightText}"
									           TextWrapping="NoWrap"
									           FontSize="11"/>
								</StackPanel>
								<StackPanel Orientation="Horizontal" Spacing="0"
								            IsVisible="{Binding HasSecondaryContextOnlyDisplay}">
									<TextBlock Text="{Binding SecondaryDisplayText}"
									           TextWrapping="NoWrap"
									           FontSize="11"/>
								</StackPanel>
							</StackPanel>
						</DataTemplate>

					</TreeView.DataTemplates>

				</TreeView>

				<Border Name="SearchEmptyState" IsVisible="{Binding IsEmptyStateVisible}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="20">
					<TextBlock Text="Enter a search query above and press Search to find text across the corpus.&#x0a;The search index is built automatically when you open a corpus."
                               TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                               Classes="muted"/>
				</Border>
			</Grid>

		</Border>

	</Grid>
</UserControl>










