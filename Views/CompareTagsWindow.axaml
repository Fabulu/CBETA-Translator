<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="https://github.com/avaloniaui/avaloniaedit"
        x:Class="CbetaTranslator.App.Views.CompareTagsWindow"
        Title="Compare Tags"
        Width="1200" Height="700"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*">
        <!-- Header: shows file name and user names -->
        <DockPanel Grid.Row="0" Margin="8">
            <TextBlock Name="TxtHeader" FontWeight="Bold" FontSize="14"
                       Text="Compare Tags" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- 3-pane content -->
        <Grid Grid.Row="1" ColumnDefinitions="1*,Auto,1*,Auto,1*">
            <!-- Pane 1: Original -->
            <Border Grid.Column="0" Margin="4">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="Original" FontWeight="Bold" Padding="8,4"
                               Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
                    <ae:TextEditor Grid.Row="1" Name="EditorOriginal"
                                   IsReadOnly="True" ShowLineNumbers="False"
                                   WordWrap="True"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns"/>

            <!-- Pane 2: Your tags -->
            <Border Grid.Column="2" Margin="4">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Name="TxtPane2Header" Text="My Tags" FontWeight="Bold" Padding="8,4"
                               Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
                    <ae:TextEditor Grid.Row="1" Name="EditorMyTags"
                                   IsReadOnly="True" ShowLineNumbers="False"
                                   WordWrap="True"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="6" ResizeDirection="Columns"/>

            <!-- Pane 3: Other user's tags -->
            <Border Grid.Column="4" Margin="4">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Name="TxtPane3Header" Text="Compare" FontWeight="Bold" Padding="8,4"
                               Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
                    <ae:TextEditor Grid.Row="1" Name="EditorOtherTags"
                                   IsReadOnly="True" ShowLineNumbers="False"
                                   WordWrap="True"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
