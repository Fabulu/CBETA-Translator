<!-- Views/EdgeTypePickerPopup.axaml -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ReadZen.App.Views"
        x:Class="ReadZen.App.Views.EdgeTypePickerPopup"
        Width="280" Height="520"
        MaxWidth="280" MaxHeight="520"
        Background="{DynamicResource AppBg}"
        Title="Select Edge Type"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

	<Window.Styles>
		<Style Selector="ListBoxItem">
			<Setter Property="Padding" Value="8,6"/>
		</Style>
		<Style Selector="ListBoxItem:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SelectionBg}"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">

		<!-- Header -->
		<TextBlock Grid.Row="0"
		           Text="Choose relationship type:"
		           FontSize="13"
		           FontWeight="SemiBold"
		           Foreground="{DynamicResource TextFg}"
		           Margin="0,0,0,8"/>

		<!-- Preview -->
		<Border Grid.Row="1" Padding="8" Margin="0,0,0,8"
		        Background="#2A2A35" CornerRadius="6" MinHeight="60">
		  <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto">
		    <!-- From node -->
		    <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2">
		      <Ellipse Width="28" Height="28" Name="PreviewFromDot" Fill="#6EAFF8"/>
		      <TextBlock Name="PreviewFromLabel" Text="Source" FontSize="10"
		                 HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedFg}"/>
		    </StackPanel>
		    <!-- Edge line + label -->
		    <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2" Margin="8,0">
		      <Border Name="PreviewEdgeLine" Height="3" Width="60" CornerRadius="1" Background="#9E9E9E"/>
		      <TextBlock Name="PreviewEdgeLabel" Text="" FontSize="10"
		                 HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedFg}"/>
		    </StackPanel>
		    <!-- To node -->
		    <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
		      <Ellipse Width="28" Height="28" Name="PreviewToDot" Fill="#FF8A65"/>
		      <TextBlock Name="PreviewToLabel" Text="Target" FontSize="10"
		                 HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedFg}"/>
		    </StackPanel>
		    <!-- Direction radio buttons -->
		    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal"
		                HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,0">
		      <RadioButton Name="RbForward" Content="&#x2192;" GroupName="Dir" IsChecked="True"
		                   ToolTip.Tip="Forward" FontSize="14" Padding="4,2"/>
		      <RadioButton Name="RbReverse" Content="&#x2190;" GroupName="Dir"
		                   ToolTip.Tip="Reverse" FontSize="14" Padding="4,2"/>
		      <RadioButton Name="RbBidirectional" Content="&#x2194;" GroupName="Dir"
		                   ToolTip.Tip="Bidirectional" FontSize="14" Padding="4,2"/>
		      <RadioButton Name="RbUndirected" Content="&#x2014;" GroupName="Dir"
		                   ToolTip.Tip="Undirected" FontSize="14" Padding="4,2"/>
		    </StackPanel>
		  </Grid>
		</Border>

		<!-- Edge type list -->
		<ListBox Grid.Row="2"
		         Name="TypeList"
		         SelectionMode="Single"
		         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="local:EdgeTypeItemVm">
					<Grid ColumnDefinitions="14,*" ColumnSpacing="8">
						<!-- Color dot -->
						<Ellipse Grid.Column="0"
						         Width="10" Height="10"
						         VerticalAlignment="Center"
						         Fill="{Binding ColorHex}"/>
						<!-- Name + description -->
						<StackPanel Grid.Column="1" Spacing="1">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock Text="{Binding DisplayName}"
								           FontSize="13"
								           FontWeight="Medium"
								           Foreground="{DynamicResource TextFg}"/>
								<TextBlock Text="{Binding ShortcutHint}"
								           FontSize="11"
								           Foreground="{DynamicResource TextMutedFg}"
								           VerticalAlignment="Center"/>
							</StackPanel>
							<TextBlock Text="{Binding Description}"
							           FontSize="11"
							           Foreground="{DynamicResource TextMutedFg}"
							           TextWrapping="Wrap"/>
						</StackPanel>
					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<!-- Footer hint -->
		<TextBlock Grid.Row="3"
		           Text="1-9 quick-select | Enter confirm | Esc cancel"
		           FontSize="11"
		           Foreground="{DynamicResource TextMutedFg}"
		           HorizontalAlignment="Center"
		           Margin="0,8,0,0"/>
	</Grid>

</Window>
