<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ReadZen.App.Views.TranslationHistoryDialog"
        Title="Translation History"
        Width="780" Height="560"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Padding="12,8" Background="{DynamicResource BarBg}">
            <StackPanel Spacing="2">
                <TextBlock Name="TxtFileName" FontWeight="Bold" FontSize="14"/>
                <TextBlock Name="TxtFileInfo" FontSize="11" Opacity="0.7"/>
            </StackPanel>
        </Border>

        <!-- Main content: commit list + preview -->
        <Grid Grid.Row="1" ColumnDefinitions="280,6,*" Margin="8">

            <!-- Commit list -->
            <Border Grid.Column="0" CornerRadius="6" BorderThickness="1" Padding="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Versions" FontWeight="SemiBold"
                               FontSize="12" Margin="4,4,4,6"/>
                    <ListBox Name="LstCommits"
                             SelectionMode="Single"
                             FontSize="11"/>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" ResizeDirection="Columns"
                          Background="Transparent" Width="6"/>

            <!-- Preview -->
            <Border Grid.Column="2" CornerRadius="6" BorderThickness="1" Padding="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Name="TxtPreviewHeader"
                               Text="Select a version to preview"
                               FontWeight="SemiBold" FontSize="12" Margin="4,4,4,6"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock Name="TxtPreview"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Opacity="0.85"
                                   Margin="4"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="12,8">
            <Button Name="BtnRestore" Content="Restore This Version"
                    IsEnabled="False" FontSize="12" Padding="12,6"/>
            <Button Name="BtnClose" Content="Close"
                    FontSize="12" Padding="12,6"/>
        </StackPanel>
    </Grid>
</Window>
