<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CbetaTranslator.App.ViewModels"
             xmlns:models="using:CbetaTranslator.App.Models"
             xmlns:local="using:CbetaTranslator.App.Views"
             x:DataType="vm:ScholarTabViewModel"
             x:Class="CbetaTranslator.App.Views.ScholarTabView">

  <Grid ColumnDefinitions="300,Auto,*">

    <!-- Left: Collections + Passages + Community -->
    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,*,Auto" MinHeight="400">

      <!-- Collections header -->
      <DockPanel Grid.Row="0" Margin="4">
        <Button Content="+" DockPanel.Dock="Right" Command="{Binding AddCollectionCommand}"
                ToolTip.Tip="Create new collection" Padding="8,3"/>
        <Button Content="&#x2212;" DockPanel.Dock="Right" Command="{Binding DeleteCollectionCommand}"
                ToolTip.Tip="Delete selected collection" Padding="8,3" Margin="0,0,4,0"/>
        <Button Content="Import" DockPanel.Dock="Right" Command="{Binding ImportCollectionsCommand}"
                ToolTip.Tip="Import collections from file" Padding="6,2" Margin="0,0,4,0"/>
        <Button Content="Export" DockPanel.Dock="Right" Command="{Binding ExportCollectionsCommand}"
                ToolTip.Tip="Export collections to file" Padding="6,2" Margin="0,0,4,0"/>
        <Button Content="Dict" DockPanel.Dock="Right" Name="BtnDictionary"
                ToolTip.Tip="Open the Zen Dictionary (Ctrl+D)" Padding="6,2" Margin="0,0,4,0"/>
        <Button Content="Vocab" DockPanel.Dock="Right" Name="BtnVocabulary"
                ToolTip.Tip="Vocabulary frequency analysis" Padding="6,2" Margin="0,0,4,0"/>
        <TextBlock Text="Collections" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>

      <!-- Collections filter -->
      <TextBox Grid.Row="1" Watermark="Filter collections..."
               Text="{Binding CollectionFilter}" Margin="4,2"/>

      <!-- Collections list -->
      <ListBox Grid.Row="2" ItemsSource="{Binding Collections}"
               SelectedItem="{Binding SelectedCollection}" Margin="4,0" MaxHeight="200">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="models:ScholarCollection">
            <StackPanel>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Description}" Classes="muted" FontSize="11"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding CreatedBy}" Classes="muted" FontSize="10"
                         IsVisible="{Binding CreatedBy, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Passages header -->
      <DockPanel Grid.Row="3" Margin="4">
        <Button Content="&#x2212;" DockPanel.Dock="Right" Command="{Binding DeletePassageCommand}"
                ToolTip.Tip="Remove selected passage" Padding="8,3"/>
        <Button Content="Compare" DockPanel.Dock="Right" Name="BtnCompare"
                ToolTip.Tip="Select 2-4 passages (Ctrl+click), then Compare (Ctrl+Shift+C)" Padding="6,2" Margin="0,0,4,0"/>
        <TextBlock Text="Passages" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>

      <!-- Passages filter -->
      <DockPanel Grid.Row="4" Margin="4,2">
        <ComboBox DockPanel.Dock="Right" Width="80" Padding="4,2" Margin="2,0,0,0"
                  ItemsSource="{Binding SearchFilterModes}"
                  SelectedItem="{Binding SearchFilterMode}"
                  ToolTip.Tip="Filter scope"/>
        <Button DockPanel.Dock="Right" Name="BtnEditMasterDates" Content="&#x270E;"
                ToolTip.Tip="Edit master dates for chronological sort" Padding="6,2" Margin="2,0,0,0"/>
        <ComboBox DockPanel.Dock="Right" Width="90" Padding="4,2" Margin="2,0,0,0"
                  ItemsSource="{Binding SortModes}"
                  SelectedItem="{Binding SortMode}"
                  ToolTip.Tip="Sort order"/>
        <TextBox Watermark="Filter passages..."
                 Text="{Binding SearchFilter}"/>
      </DockPanel>

      <!-- Passages list (single-select; checkboxes for Compare) -->
      <ListBox Grid.Row="5" Name="PassagesList" Margin="4,0" MaxHeight="250"
               ItemsSource="{Binding Passages}"
               SelectedItem="{Binding SelectedPassage}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="models:ScholarPassage">
            <DockPanel Margin="2">
              <CheckBox DockPanel.Dock="Left" Name="CompareCheck"
                        VerticalAlignment="Top" Margin="0,2,4,0"
                        IsVisible="{Binding #PassagesList.Tag, FallbackValue=False}"
                        ToolTip.Tip="Check to include in comparison"/>
              <StackPanel>
                <TextBlock Text="{Binding ZhText}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                <TextBlock Text="{Binding EnText}" Classes="muted" FontSize="11"
                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                <TextBlock Text="{Binding SourceRelPath}" Opacity="0.4" FontSize="10"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourceRelPath}"/>
                <TextBlock Text="{Binding TagsSummary}" FontSize="10" Opacity="0.6"
                           IsVisible="{Binding HasTags}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding MasterNamesSummary}" FontSize="10" Opacity="0.6"
                           IsVisible="{Binding HasMasterNames}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding LinkedTextsSummary}" FontSize="10" Opacity="0.6"
                           IsVisible="{Binding HasLinkedTexts}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Community Collections (collapsed by default) -->
      <Expander Grid.Row="6" IsExpanded="False" Margin="4,8,4,2"
                IsVisible="{Binding HasCommunityCollections}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Community Collections" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentLinkFg}"/>
            <Border Background="{DynamicResource AccentLinkFg}" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
              <TextBlock Text="{Binding CommunityCollections.Count}" FontSize="10" FontWeight="Bold"
                         Foreground="{DynamicResource AppBg}"/>
            </Border>
          </StackPanel>
        </Expander.Header>
        <StackPanel Spacing="4">
          <!-- Community user picker + filter -->
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2">
            <ComboBox ItemsSource="{Binding CommunityUsernames}"
                      SelectedIndex="{Binding SelectedCommunityUserIndex}"
                      MinWidth="100" FontSize="11"
                      ToolTip.Tip="Filter by community user"/>
            <TextBox Watermark="Filter..."
                     Text="{Binding CommunityFilter}"
                     MinWidth="80"/>
          </StackPanel>

          <!-- Community collections list -->
          <ListBox Name="CommunityCollectionsList" Margin="0" MaxHeight="180"
                   ItemsSource="{Binding CommunityCollections}"
                   SelectedItem="{Binding SelectedCommunityCollection}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:ScholarCollection">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Description}" Classes="muted" FontSize="11"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock FontSize="10" Foreground="{DynamicResource AccentLinkFg}"
                             IsVisible="{Binding CreatedBy, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="by {0}">
                        <Binding Path="CreatedBy"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Community passages list -->
          <ListBox Name="CommunityPassagesList" Margin="0" MaxHeight="150"
                   ItemsSource="{Binding CommunityPassages}"
                   SelectedItem="{Binding SelectedCommunityPassage}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:ScholarPassage">
                <StackPanel Margin="2">
                  <TextBlock Text="{Binding ZhText}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" MaxLines="1"/>
                  <TextBlock Text="{Binding EnText}" Classes="muted" FontSize="11"
                             TextTrimming="CharacterEllipsis" MaxLines="1"/>
                  <TextBlock Text="{Binding SourceRelPath}" Opacity="0.4" FontSize="10"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourceRelPath}"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Adopt passage panel -->
          <DockPanel Margin="0,4,0,2"
                     IsVisible="{Binding SelectedCommunityPassage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Button Content="Adopt" DockPanel.Dock="Right" Command="{Binding AdoptSelectedPassageCommand}"
                    ToolTip.Tip="Copy this passage into the selected local collection" Padding="8,3"/>
            <ComboBox ItemsSource="{Binding Collections}"
                      SelectedItem="{Binding AdoptTargetCollection}"
                      Margin="0,0,4,0" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:ScholarCollection">
                  <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </DockPanel>
        </StackPanel>
      </Expander>
    </Grid>
    </ScrollViewer>

    <!-- Splitter -->
    <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns"/>

    <!-- Right: Detail editor -->
    <Border Grid.Column="2" CornerRadius="6" Padding="12" Margin="4">
      <Grid RowDefinitions="*,Auto">
        <!-- Dictionary hover overlay (hit-test-invisible Canvas prevents flicker) -->
        <Canvas Name="DictOverlayCanvas" IsHitTestVisible="False" ZIndex="500" Grid.RowSpan="2"/>
        <!-- Tab area -->
        <TabControl Grid.Row="0">
          <TabItem Header="Detail">
            <ScrollViewer>
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="4">

                <TextBlock Grid.Row="0" Text="Passage Detail" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>

                <!-- Source file -->
                <TextBlock Grid.Row="1" Name="TxtSourcePath" Text="" Classes="muted" FontSize="11" Margin="0,0,0,4"/>

                <!-- Linked Texts -->
                <ItemsControl Name="PnlLinkedTexts" Grid.Row="2" Margin="0,0,0,4"
                              IsVisible="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Chinese text (TextBox for hover dictionary support) -->
                <Border Grid.Row="3" CornerRadius="4" Padding="8" Margin="0,0,0,4">
                  <ScrollViewer MaxHeight="200">
                    <TextBox Name="TxtZhText" Text="" TextWrapping="Wrap" FontSize="14"
                             IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             Cursor="Arrow"
                             Padding="0" Margin="0"/>
                  </ScrollViewer>
                </Border>

                <!-- Termbase hits for current passage -->
                <ItemsControl Name="PnlTermbaseHits" Grid.Row="4" Margin="8,0,0,8"
                              IsVisible="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- English text -->
                <Border Grid.Row="5" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                  <ScrollViewer MaxHeight="200">
                    <TextBlock Name="TxtEnText" Text="" TextWrapping="Wrap" FontSize="14"/>
                  </ScrollViewer>
                </Border>

                <!-- Tags (bubble chips) -->
                <StackPanel Grid.Row="6" Margin="0,0,0,4" Spacing="4"
                            IsEnabled="{Binding IsEditorEnabled}">
                  <TextBlock Text="Tags:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>
                  <ItemsControl Name="TagBubblesHost" ItemsSource="{Binding TagBubbles}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Border Background="{DynamicResource SystemAccentColorLight2}" CornerRadius="10"
                                Padding="8,3" Margin="0,0,4,4" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="White"/>
                            <Button Content="&#x2715;" Padding="2,0" FontSize="10"
                                    Background="Transparent" Foreground="White"
                                    Name="BtnRemoveTag" Tag="{Binding}"
                                    ToolTip.Tip="Remove tag"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBox Name="TxtAddTag" Watermark="Add tag (Enter to add)..."
                           ToolTip.Tip="Type a tag and press Enter"/>
                </StackPanel>

                <!-- Master Names (bubble chips + autocomplete) -->
                <StackPanel Grid.Row="7" Margin="0,0,0,4" Spacing="4"
                            IsEnabled="{Binding IsEditorEnabled}">
                  <TextBlock Text="Masters:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>
                  <ItemsControl Name="MasterBubblesHost" ItemsSource="{Binding MasterBubbles}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="10"
                                Padding="8,3" Margin="0,0,4,4" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="White"/>
                            <Button Content="&#x2715;" Padding="2,0" FontSize="10"
                                    Background="Transparent" Foreground="White"
                                    Name="BtnRemoveMaster" Tag="{Binding}"
                                    ToolTip.Tip="Remove master"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <AutoCompleteBox Name="AcbAddMaster" Watermark="Add master (type to search)..."
                                   FilterMode="Contains" MinimumPrefixLength="1"
                                   ToolTip.Tip="Type to search the 156 Zen masters database"/>
                </StackPanel>

                <!-- Notes -->
                <DockPanel Grid.Row="8" Margin="0,0,0,4">
                  <TextBlock Text="Notes:" Width="100" VerticalAlignment="Top"/>
                  <TextBox Text="{Binding PassageNotes}" Watermark="Personal notes..."
                           AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                           IsEnabled="{Binding IsEditorEnabled}"
                           ToolTip.Tip="Your personal notes about this passage"/>
                </DockPanel>

                <!-- Actions -->
                <StackPanel Grid.Row="9" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
                  <Button Name="BtnFindParallels" Content="Find Parallels" IsVisible="False"
                          ToolTip.Tip="Search the corpus for parallel passages (Ctrl+Shift+P)" Padding="12,4"/>
                  <Button Content="Navigate to Source" Command="{Binding NavigateToPassageCommand}"
                          ToolTip.Tip="Open this passage in the Reader tab" Padding="12,4"/>
                  <Button Content="Save" Command="{Binding SaveCommand}" Padding="12,4"
                          IsEnabled="{Binding IsEditorEnabled}" ToolTip.Tip="Save passage edits"/>
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Categories">
            <ScrollViewer>
              <StackPanel Spacing="12" Margin="8">
                <TextBlock Name="TxtCategoriesEmpty"
                           Text="Select a passage to assign categories."
                           TextWrapping="Wrap" Classes="muted" FontSize="11"
                           IsVisible="True"/>
                <DockPanel>
                  <TextBlock Text="Doctrinal Topic" Width="130" VerticalAlignment="Center"/>
                  <ComboBox IsEditable="True" ItemsSource="{Binding DoctrinalTopicOptions}"
                            Text="{Binding DoctrinalTopic}" HorizontalAlignment="Stretch"
                            IsEnabled="{Binding IsEditorEnabled}"
                            ToolTip.Tip="Classify the primary doctrinal topic of this passage"/>
                </DockPanel>
                <DockPanel>
                  <TextBlock Text="Literary Form" Width="130" VerticalAlignment="Center"/>
                  <ComboBox IsEditable="True" ItemsSource="{Binding LiteraryFormOptions}"
                            Text="{Binding LiteraryForm}" HorizontalAlignment="Stretch"
                            IsEnabled="{Binding IsEditorEnabled}"
                            ToolTip.Tip="Classify the literary form of this passage"/>
                </DockPanel>
                <DockPanel>
                  <TextBlock Text="Lineage" Width="130" VerticalAlignment="Center"/>
                  <ComboBox IsEditable="True" ItemsSource="{Binding LineageOptions}"
                            Text="{Binding Lineage}" HorizontalAlignment="Stretch"
                            IsEnabled="{Binding IsEditorEnabled}"
                            ToolTip.Tip="Specify the Zen lineage associated with this passage"/>
                </DockPanel>
                <DockPanel>
                  <TextBlock Text="Rhetorical Function" Width="130" VerticalAlignment="Center"/>
                  <ComboBox IsEditable="True" ItemsSource="{Binding RhetoricalFunctionOptions}"
                            Text="{Binding RhetoricalFunction}" HorizontalAlignment="Stretch"
                            IsEnabled="{Binding IsEditorEnabled}"
                            ToolTip.Tip="Describe the rhetorical function of this passage"/>
                </DockPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem>
            <TabItem.Header>
              <TextBlock Name="TxtLinksTabHeader" Text="Links"/>
            </TabItem.Header>
            <ScrollViewer>
              <StackPanel Margin="8">
                <!-- Link Statistics -->
                <Expander Header="Statistics" IsExpanded="True" Margin="0,0,0,8">
                    <StackPanel Spacing="6">
                        <StackPanel Name="PnlLinkStats" Spacing="3"/>
                        <TextBlock Name="TxtLinkCoverage" FontSize="11" Classes="muted"/>
                    </StackPanel>
                </Expander>
                <Button Name="BtnAddLink" Content="+ Link" Padding="8,3" FontSize="11"
                        IsEnabled="{Binding IsEditorEnabled}" Margin="0,0,0,4"/>
                <TextBlock Name="TxtLinksEmpty"
                           Text="No links yet. Right-click a passage and choose 'Link to...' to connect related passages."
                           TextWrapping="Wrap" Classes="muted" FontSize="11"
                           IsVisible="True"/>
                <ItemsControl Name="PnlLinks">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="4"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Graph">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8,4">
                    <Button Name="BtnGraphRelayout" Content="Re-layout" Padding="8,3" FontSize="11"/>
                    <TextBlock Name="TxtGraphInfo" VerticalAlignment="Center" Classes="muted" FontSize="11"/>
                </StackPanel>
                <local:LinkNetworkGraphControl Grid.Row="1" Name="GraphControl"
                    ClipToBounds="True" Margin="4"/>
            </Grid>
          </TabItem>

          <TabItem Header="Notes">
            <Grid RowDefinitions="Auto,*" Margin="8">
              <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <Button Name="BtnInsertReference" Content="Insert Reference"
                        ToolTip.Tip="Insert a [[passage-id]] reference at cursor position" Padding="8,4">
                  <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                      <ListBox Name="ReferencePassageList" MaxHeight="300" MinWidth="300">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="models:ScholarPassage">
                            <TextBlock Text="{Binding ZhText}" TextTrimming="CharacterEllipsis"
                                       MaxLines="1" MaxWidth="280"/>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
              <TextBox Grid.Row="1" Name="TxtStudyNotes" Text="{Binding StudyNotes}"
                       AcceptsReturn="True" TextWrapping="Wrap"
                       Watermark="Collection study notes... Use Insert Reference to embed [[passage-id]] links."
                       VerticalAlignment="Stretch"/>
            </Grid>
          </TabItem>
        </TabControl>

        <!-- Scholar Assistant stays outside TabControl, always visible -->
        <Expander Grid.Row="1" Header="Scholar Assistant" IsExpanded="False" Margin="0,8,0,0">
          <ScrollViewer MaxHeight="500">
            <StackPanel Spacing="8" Margin="4">
              <Border CornerRadius="4" Padding="6">
                <StackPanel>
                  <TextBlock Text="Warnings / QA" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                  <StackPanel Name="ScholarQaHost"/>
                </StackPanel>
              </Border>
              <Border CornerRadius="4" Padding="6">
                <StackPanel>
                  <TextBlock Text="Recognized Terms" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                  <StackPanel Name="ScholarTermHost"/>
                </StackPanel>
              </Border>
              <Border CornerRadius="4" Padding="6">
                <StackPanel>
                  <TextBlock Text="Approved TM" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                  <StackPanel Name="ScholarApprovedTmHost"/>
                </StackPanel>
              </Border>
              <Border CornerRadius="4" Padding="6">
                <StackPanel>
                  <TextBlock Text="Reference / AI" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                  <StackPanel Name="ScholarReferenceTmHost"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Expander>
      </Grid>
    </Border>

    <!-- Empty state overlay -->
    <Border Grid.ColumnSpan="3" Name="ScholarEmptyState" IsVisible="{Binding IsEmptyState}"
            Background="{DynamicResource AppBg}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Text="Scholar's Collections" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="Right-click text in the Reader, Translation, or Search tabs to add passages to collections."
                   TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Classes="muted"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
