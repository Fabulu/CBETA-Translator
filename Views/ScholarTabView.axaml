<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ReadZen.App.ViewModels"
             xmlns:models="using:ReadZen.App.Models"
             xmlns:local="using:ReadZen.App.Views"
             x:DataType="vm:ScholarTabViewModel"
             x:Class="ReadZen.App.Views.ScholarTabView">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ROW 0: Slim Toolbar -->
    <Border Grid.Row="0" Padding="8,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}">
      <DockPanel LastChildFill="False">
        <!-- LEFT side -->
        <Button DockPanel.Dock="Left" Name="BtnToggleTree" Content="&#x2630;" ToolTip.Tip="Toggle tree panel" Padding="6,4" Margin="0,0,8,0"/>
        <ComboBox DockPanel.Dock="Left" Name="CmbCollections" MinWidth="180" Margin="0,0,8,0"
                  ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection}"/>
        <TextBox DockPanel.Dock="Left" Name="TxtFilter" Watermark="Filter passages..." Width="160" Margin="0,0,8,0"
                 Text="{Binding SearchFilter, Mode=TwoWay}"/>
        <ComboBox DockPanel.Dock="Left" Name="CmbSort" Width="100" Margin="0,0,8,0"
                  ItemsSource="{Binding SortModes}" SelectedIndex="{Binding SortModeIndex}"/>

        <!-- RIGHT side -->
        <Button DockPanel.Dock="Right" Name="BtnOverflow" Content="&#x22EF;" ToolTip.Tip="More tools" Padding="8,4"/>
        <Button DockPanel.Dock="Right" Name="BtnAddCollection" Content="+" ToolTip.Tip="New collection" Padding="8,4" Margin="0,0,4,0"/>
        <Button DockPanel.Dock="Right" Name="BtnExport" Content="Export" ToolTip.Tip="Export collection" Padding="8,4" Margin="0,0,4,0"/>
        <Button DockPanel.Dock="Right" Name="BtnOpenInReader" Content="Open in Reader" ToolTip.Tip="View in Reader tab" Padding="8,4" Margin="0,0,4,0"/>
      </DockPanel>
    </Border>

    <!-- ROW 1: Main Content (Tree + Splitter + Detail) -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*">

      <!-- LEFT: Collections Tree Panel -->
      <Border Grid.Column="0" Name="TreePanel" Width="240" BorderThickness="0,0,1,0"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}">
        <Grid RowDefinitions="Auto,*">
          <TextBox Grid.Row="0" Name="TxtTreeFilter" Watermark="Search collections..." Margin="4"/>
          <TreeView Grid.Row="1" Name="CollectionsTree" Margin="4"
                    ItemsSource="{Binding CollectionTreeNodes}">
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding ItemCount, StringFormat='({0})'}" FontSize="10" Opacity="0.6"
                             IsVisible="{Binding ItemCount}"/>
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Grid>
      </Border>

      <!-- SPLITTER -->
      <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns"/>

      <!-- RIGHT: Scrollable Detail Panel -->
      <ScrollViewer Grid.Column="2" Name="DetailScroller" Padding="12">
        <StackPanel Spacing="12" Name="DetailPanel">

          <!-- EMPTY STATE (shown when no passage selected) -->
          <Border Name="EmptyState" IsVisible="True" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="16" MaxWidth="500" HorizontalAlignment="Center">
              <TextBlock Text="Scholar Workspace" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock Text="Build a research collection of Zen passages with annotations, links, and visualization."
                         TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7"/>
              <StackPanel Spacing="8" Margin="0,12,0,0">
                <TextBlock Text="1. Create a collection to organize passages by theme" Opacity="0.8"/>
                <TextBlock Text="2. Add passages from Reader, Translate, or Search" Opacity="0.8"/>
                <TextBlock Text="3. Annotate, link, and visualize relationships" Opacity="0.8"/>
              </StackPanel>
              <Button Name="BtnCreateFirst" Content="Create First Collection" HorizontalAlignment="Center" Padding="16,8" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

          <!-- PASSAGE DETAIL (shown when passage is selected) -->
          <StackPanel Name="PassageDetail" IsVisible="False" Spacing="12">

            <!-- Section 1: Summary + Core Texts (always visible) -->
            <StackPanel Spacing="8">
              <TextBox Name="TxtSummary" Watermark="Summary (your paraphrase of this passage)..."
                       FontWeight="SemiBold" FontSize="15" MaxLength="120"/>
              <TextBlock Name="TxtSourcePath" FontSize="11" Opacity="0.5"/>

              <!-- Chinese text -->
              <Border CornerRadius="4" Padding="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <ScrollViewer MaxHeight="300">
                  <TextBox Name="TxtZhText" IsReadOnly="True" TextWrapping="Wrap" FontSize="14"
                           BorderThickness="0" Background="Transparent"/>
                </ScrollViewer>
              </Border>

              <!-- Termbase hits -->
              <ItemsControl Name="PnlTermbaseHits"/>

              <!-- English text -->
              <Border CornerRadius="4" Padding="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <ScrollViewer MaxHeight="300">
                  <TextBlock Name="TxtEnText" TextWrapping="Wrap" FontSize="14"/>
                </ScrollViewer>
              </Border>
            </StackPanel>

            <!-- Section 2: Keywords & Metadata (expanded by default) -->
            <Expander Header="Keywords &amp; Metadata" IsExpanded="True" Name="ExpanderMetadata">
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <!-- Tags -->
                <StackPanel Spacing="4">
                  <TextBlock Text="Tags" FontWeight="SemiBold" FontSize="12"/>
                  <WrapPanel Name="PnlTags" Orientation="Horizontal"/>
                  <TextBox Name="TxtAddTag" Watermark="Add tag (Enter)..." FontSize="11"/>
                </StackPanel>
                <!-- Masters -->
                <StackPanel Spacing="4">
                  <TextBlock Text="Masters" FontWeight="SemiBold" FontSize="12"/>
                  <WrapPanel Name="PnlMasters" Orientation="Horizontal"/>
                  <TextBox Name="TxtAddMaster" Watermark="Add master (Enter)..." FontSize="11"/>
                </StackPanel>
                <!-- Linked Texts -->
                <StackPanel Spacing="4" Name="PnlLinkedTexts">
                  <TextBlock Text="Linked Texts" FontWeight="SemiBold" FontSize="12"/>
                </StackPanel>
              </StackPanel>
            </Expander>

            <!-- Section 3: Categorization (collapsed by default) -->
            <Expander Header="Categorization" IsExpanded="False" Name="ExpanderCategories">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="130,*" Margin="0,8,0,0" RowSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Doctrinal Topic" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Name="CmbDoctrinalTopic" HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Literary Form" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Name="CmbLiteraryForm" HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Lineage" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Name="CmbLineage" HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Rhetorical Function" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="3" Grid.Column="1" Name="CmbRhetoricalFunction" HorizontalAlignment="Stretch"/>
              </Grid>
            </Expander>

            <!-- Section 4: Connections + Backlinks (collapsed by default) -->
            <Expander Header="Connections" IsExpanded="False" Name="ExpanderConnections">
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="Outgoing Links" FontWeight="SemiBold" FontSize="12"/>
                <ItemsControl Name="PnlOutgoingLinks"/>
                <Button Name="BtnAddLink" Content="+ Add Link" Padding="8,3" FontSize="11"/>
                <TextBlock Text="Referenced By (Backlinks)" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0"/>
                <ItemsControl Name="PnlBacklinks"/>
                <TextBlock Name="TxtNoBacklinks" Text="No incoming references yet." FontSize="11" Opacity="0.5"/>
              </StackPanel>
            </Expander>

            <!-- Section 5: Research Notes (collapsed by default) -->
            <Expander Header="Research Notes" IsExpanded="False" Name="ExpanderNotes">
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBox Name="TxtPassageNotes" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="100" Watermark="Personal notes... Use [[passage-id]] for references"/>
                <DockPanel>
                  <Button Name="BtnInsertReference" Content="Insert Reference" DockPanel.Dock="Left" Padding="8,4" FontSize="11"/>
                </DockPanel>
              </StackPanel>
            </Expander>

            <!-- Section 6: Scholar Assistant (collapsed by default) -->
            <Expander Header="Scholar Assistant" IsExpanded="False" Name="ScholarAssistantExpander">
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <Expander Header="Quality Checks" IsExpanded="False" Name="ExpanderQA">
                  <StackPanel Name="PnlQualityChecks" Spacing="4"/>
                </Expander>
                <Expander Header="Glossary" IsExpanded="False" Name="ExpanderGlossary">
                  <StackPanel Name="PnlGlossary" Spacing="4"/>
                </Expander>
                <Expander Header="Approved Matches" IsExpanded="False" Name="ExpanderApprovedTm">
                  <StackPanel Name="PnlApprovedTm" Spacing="4"/>
                </Expander>
                <Expander Header="Reference Translations" IsExpanded="False" Name="ExpanderRefTm">
                  <StackPanel Name="PnlRefTm" Spacing="4"/>
                </Expander>
              </StackPanel>
            </Expander>

            <!-- Bottom action bar -->
            <DockPanel Margin="0,16,0,0">
              <Button Name="BtnShowGraph" Content="Show Graph" DockPanel.Dock="Right" Padding="8,4"/>
              <Button Name="BtnDeletePassage" Content="Delete" DockPanel.Dock="Right" Padding="8,4" Margin="0,0,8,0"/>
            </DockPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ROW 2: Bottom Drawer (Graph) - initially hidden -->
    <Border Grid.Row="2" Name="BottomDrawer" Height="0" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}">
      <Grid RowDefinitions="Auto,*">
        <DockPanel Grid.Row="0" Margin="8,4">
          <TextBlock Text="Graph" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
          <Button DockPanel.Dock="Right" Name="BtnCloseDrawer" Content="&#x2715;" Padding="6,2"/>
          <Button DockPanel.Dock="Right" Name="BtnOpenGraphWindow" Content="Open in Window" ToolTip.Tip="Open Research Graph in separate window" Padding="6,2" Margin="0,0,4,0"/>
          <Button DockPanel.Dock="Right" Name="BtnGraphFullScreen" Content="&#x26F6;" ToolTip.Tip="Full screen" Padding="6,2" Margin="0,0,4,0"/>
          <Button DockPanel.Dock="Right" Name="BtnGraphRelayout" Content="Rearrange" Padding="6,2" Margin="0,0,4,0"/>
          <!-- Color mode dropdown -->
          <ComboBox DockPanel.Dock="Right" Name="CmbGraphColorMode" MinWidth="120" Margin="0,0,8,0"/>
        </DockPanel>
        <local:LinkNetworkGraphControl Grid.Row="1" Name="GraphControl" ClipToBounds="True" Margin="4"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
