<!-- Views/UsernamePromptWindow.axaml -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CbetaTranslator.App.Views.UsernamePromptWindow"
        Width="400" Height="230"
        Background="{DynamicResource AppBg}"
        Title="Set Your Name"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

	<Window.Styles>
		<Style Selector="Button.primary">
			<Setter Property="Background" Value="{DynamicResource SelectionBg}"/>
			<Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
		</Style>
		<Style Selector="Button">
			<Setter Property="Background" Value="{DynamicResource BtnBg}"/>
			<Setter Property="Foreground" Value="{DynamicResource BtnFg}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="*,Auto" Margin="24">

		<StackPanel Grid.Row="0" Spacing="12" VerticalAlignment="Center">
			<TextBlock Text="Welcome! Please enter your name."
			           FontSize="16"
			           FontWeight="SemiBold"
			           Foreground="{DynamicResource TextFg}"
			           TextWrapping="Wrap"/>
			<TextBlock Text="Your name is recorded in translation reviews. It cannot be left empty."
			           FontSize="12"
			           Foreground="{DynamicResource TextMutedFg}"
			           TextWrapping="Wrap"/>
			<TextBox Name="TxtUsername"
			         MaxLength="64"
			         Watermark="Your name…"/>
			<TextBlock Name="TxtError"
			           Text="Please enter at least one character."
			           Foreground="#E05555"
			           FontSize="12"
			           IsVisible="False"/>
		</StackPanel>

		<Button Grid.Row="1"
		        Name="BtnOk"
		        Content="Continue"
		        Width="120" Height="32"
		        Classes="primary"
		        HorizontalAlignment="Right"/>
	</Grid>

</Window>
