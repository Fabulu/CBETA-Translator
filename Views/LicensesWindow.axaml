<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CbetaTranslator.App.ViewModels"
        x:Class="CbetaTranslator.App.Views.LicensesWindow"
        x:DataType="vm:LicensesWindowViewModel"
        Width="980" Height="720"
        Background="{DynamicResource AppBg}"
        Title="Licenses &amp; Attributions"
        WindowStartupLocation="CenterOwner">

	<Grid RowDefinitions="Auto,*,Auto" Margin="12" RowSpacing="10">

		<StackPanel Spacing="6">
			<TextBlock Text="Licenses &amp; Attributions"
					   FontSize="20"
					   FontWeight="SemiBold"/>

			<TextBlock Text="Shows app license, third-party notices, CC-CEDICT attribution, and bundled Git for Windows notices (when present)."
					   Classes="muted"
					   TextWrapping="Wrap"/>
		</StackPanel>

		<Border Grid.Row="1"
				Background="{DynamicResource PanelBg}"
				BorderBrush="{DynamicResource PanelBorder}"
				BorderThickness="1"
				CornerRadius="8"
				Padding="10">

			<TextBox IsReadOnly="True"
					 AcceptsReturn="True"
					 TextWrapping="Wrap"
					 Background="Transparent"
					 BorderThickness="0"
					 FontFamily="Consolas"
					 ScrollViewer.VerticalScrollBarVisibility="Auto"
					 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					 Text="{Binding LicensesText}"/>
		</Border>

		<DockPanel Grid.Row="2" LastChildFill="False">
			<TextBlock DockPanel.Dock="Left"
					   Classes="muted"
					   VerticalAlignment="Center"
					   Text="{Binding HintText}"/>

			<Button DockPanel.Dock="Right"
					Width="120"
					Height="34"
					Content="Close"
					Command="{Binding CloseWindowCommand}"/>
		</DockPanel>

	</Grid>
</Window>
