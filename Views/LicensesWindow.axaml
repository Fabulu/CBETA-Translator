<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ReadZen.App.ViewModels"
        x:Class="ReadZen.App.Views.LicensesWindow"
        x:DataType="vm:LicensesWindowViewModel"
        Width="980" Height="720"
        Background="{DynamicResource AppBg}"
        Title="Licenses &amp; Attributions"
        WindowStartupLocation="CenterOwner">

	<Grid RowDefinitions="Auto,*,Auto" Margin="12" RowSpacing="10">

		<StackPanel Spacing="6">
			<TextBlock Text="Licenses &amp; Attributions"
					   FontSize="20"
					   FontWeight="SemiBold"/>

			<TextBlock Text="Shows app license, third-party notices, CC-CEDICT attribution, and bundled Git for Windows notices (when present)."
					   Classes="muted"
					   TextWrapping="Wrap"/>
			<StackPanel Orientation="Horizontal" Spacing="4" Margin="0,6,0,0">
				<TextBlock Text="&#x2665;" FontSize="12"
						   Foreground="{DynamicResource AccentLinkFg}"
						   VerticalAlignment="Center"/>
				<TextBlock Name="BtnSupportLicenses"
						   Text="ReadZen is free and open-source. Support this project on Ko-fi"
						   FontSize="12"
						   Foreground="{DynamicResource AccentLinkFg}"
						   Cursor="Hand"
						   TextDecorations="Underline"
						   VerticalAlignment="Center"/>
				<TextBlock Name="BtnContact"
						   Text="Contact the developer"
						   FontSize="12"
						   Foreground="{DynamicResource AccentLinkFg}"
						   Cursor="Hand"
						   TextDecorations="Underline"
						   Margin="12,0,0,0"
						   VerticalAlignment="Center"/>
			</StackPanel>
		</StackPanel>

		<Border Grid.Row="1"
				Background="{DynamicResource PanelBg}"
				BorderBrush="{DynamicResource PanelBorder}"
				BorderThickness="1"
				CornerRadius="8"
				Padding="10">

			<TextBox IsReadOnly="True"
					 AcceptsReturn="True"
					 TextWrapping="Wrap"
					 Background="Transparent"
					 BorderThickness="0"
					 FontFamily="Consolas, Menlo, 'DejaVu Sans Mono', 'Liberation Mono', monospace"
					 ScrollViewer.VerticalScrollBarVisibility="Auto"
					 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					 Text="{Binding LicensesText}"/>
		</Border>

		<DockPanel Grid.Row="2" LastChildFill="False">
			<TextBlock DockPanel.Dock="Left"
					   Classes="muted"
					   VerticalAlignment="Center"
					   Text="{Binding HintText}"/>

			<Button DockPanel.Dock="Right"
					Width="120"
					Height="34"
					Content="Close"
					Command="{Binding CloseWindowCommand}"/>
		</DockPanel>

	</Grid>
</Window>
