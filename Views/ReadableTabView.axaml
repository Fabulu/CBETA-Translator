<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CbetaTranslator.App.Views"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:vm="using:CbetaTranslator.App.ViewModels"
             x:DataType="vm:ReadableTabViewModel"
             x:Class="CbetaTranslator.App.Views.ReadableTabView">

	<!-- Only local fallback keys that DON'T collide with your global theme tokens -->
	<UserControl.Resources>
		<SolidColorBrush x:Key="SplitterBrush" Color="#FFD1D1D1"/>
		<SolidColorBrush x:Key="PanelBorderFallback" Color="#FFE8E8E8"/>
	</UserControl.Resources>

	<UserControl.Styles>
		<!-- Keep AvaloniaEdit theme include -->
		<StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

		<!-- Inner AvaloniaEdit (inside your wrapper) must use global dynamic tokens -->
		<Style Selector="local|AnnotatedTextEditor ae|TextEditor">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource TextFg}"/>
			<Setter Property="FontFamily" Value="Consolas, Menlo, 'DejaVu Sans Mono', 'Noto Sans CJK SC', 'Source Han Sans SC', monospace"/>
			<Setter Property="WordWrap" Value="True"/>
			<Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
			<Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
		</Style>
	</UserControl.Styles>

	<!-- Find bar row removed -->
	<Grid RowDefinitions="Auto,*,Auto">

		<!-- Row 0: top action bar -->
		<DockPanel Grid.Row="0"
				   Margin="0,0,0,8"
				   LastChildFill="True">

			<StackPanel Orientation="Horizontal"
						Spacing="8"
						DockPanel.Dock="Left">
				<Button Name="BtnAddCommunityNote"
						Content="Add community note"
						Focusable="False"
						ToolTip.Tip="Add a community note at the current cursor position"/>
			</StackPanel>

			<CheckBox Name="ChkZenText"
					  DockPanel.Dock="Right"
					  Content="Zen Texts Only"
					  VerticalAlignment="Center"
					  Focusable="False"
					  ToolTip.Tip="Flag this text as Zen/Chan (affects filtering and translation memory)"/>

			<!-- Annotation legend -->
			<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="16,0,0,0">
				<TextBlock Text="Markers:" Classes="muted" VerticalAlignment="Center" FontSize="11"/>
				<Border Background="Gray" Width="10" Height="10" CornerRadius="2"/>
				<TextBlock Text="CBETA" FontSize="11" Classes="muted" VerticalAlignment="Center"/>
				<Border Background="DarkOrange" Width="10" Height="10" CornerRadius="2" Margin="6,0,0,0"/>
				<TextBlock Text="Footnote" FontSize="11" Classes="muted" VerticalAlignment="Center"/>
				<Border Background="DodgerBlue" Width="10" Height="10" CornerRadius="2" Margin="6,0,0,0"/>
				<TextBlock Text="Community" FontSize="11" Classes="muted" VerticalAlignment="Center"/>
			</StackPanel>

			<!-- Hover dictionary hint -->
			<TextBlock Text="Hover over Chinese for dictionary"
					   VerticalAlignment="Center" Opacity="0.4" FontSize="11"
					   Classes="muted" Margin="16,0,0,0"
					   ToolTip.Tip="Hover over Chinese characters in the original pane to see CC-CEDICT dictionary entries"/>

			<Border/>
		</DockPanel>

		<!-- Row 1: two readable panes + empty state overlay -->
		<Grid Grid.Row="1">
			<Grid Name="TwoPaneGrid" ColumnDefinitions="1*,Auto,2*" Margin="0">

				<Border Grid.Column="0"
						Background="{DynamicResource XmlViewerBg}"
						BorderBrush="{DynamicResource XmlViewerBorder}"
						BorderThickness="1"
						CornerRadius="6">
					<Grid RowDefinitions="Auto,*">
						<Border Background="{DynamicResource XmlViewerBg}" Padding="8">
							<TextBlock Text="Original (read-only)" Classes="muted"/>
						</Border>

						<local:AnnotatedTextEditor Name="EditorOriginal"
												   Grid.Row="1"/>
					</Grid>
				</Border>

				<GridSplitter Grid.Column="1"
							  Width="6"
							  Background="{DynamicResource SplitterBrush}"
							  ResizeDirection="Columns"
							  ResizeBehavior="PreviousAndNext"/>

				<Border Grid.Column="2"
						Background="{DynamicResource XmlViewerBg}"
						BorderBrush="{DynamicResource XmlViewerBorder}"
						BorderThickness="1"
						CornerRadius="6">
					<Grid RowDefinitions="Auto,*">
						<Border Background="{DynamicResource XmlViewerBg}" Padding="8">
							<TextBlock Text="Translated (readable view)" Classes="muted"/>
						</Border>

						<local:AnnotatedTextEditor Name="EditorTranslated"
												   Grid.Row="1"/>
					</Grid>
				</Border>

			</Grid>

			<!-- Empty state overlay -->
			<Border Name="ReadableEmptyState" IsVisible="True"
					Background="{DynamicResource AppBg}"
					HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
					<TextBlock Text="No file loaded" FontSize="18" FontWeight="SemiBold"
							   HorizontalAlignment="Center"/>
					<TextBlock Text="Select a file from the sidebar to begin reading."
							   TextWrapping="Wrap" HorizontalAlignment="Center"
							   TextAlignment="Center" Classes="muted"/>
				</StackPanel>
			</Border>

			<!-- Dictionary hover overlay (hit-test-invisible Canvas prevents flicker) -->
			<Canvas Name="DictOverlayCanvas" IsHitTestVisible="False" ZIndex="500"/>
		</Grid>

		<!-- Row 2: coding mode bar + notes panel -->

		<!-- Coding Mode toggle button - always visible -->
		<StackPanel Grid.Row="2" Orientation="Vertical" Spacing="0">

			<!-- Code bar - visible only in coding mode -->
			<Border Name="CodeBarPanel" IsVisible="False"
					Background="{DynamicResource ControlBg}"
					BorderBrush="{DynamicResource BorderBrush}"
					BorderThickness="1"
					CornerRadius="6"
					Padding="6,5"
					Margin="0,4,0,0">
				<DockPanel LastChildFill="True">
					<TextBlock Name="TxtCodeBarPage" Text="Page 1"
							   DockPanel.Dock="Left"
							   VerticalAlignment="Center"
							   FontSize="11" FontWeight="SemiBold"
							   Margin="0,0,10,0"
							   Opacity="0.7"/>
					<TextBlock Name="TxtCodeBarStatus" Text=""
							   DockPanel.Dock="Right"
							   VerticalAlignment="Center"
							   FontSize="11"
							   Opacity="0.6"
							   Margin="10,0,0,0"/>
					<Button Name="BtnEditTags"
								Content="&#x270E; Edit Tags"
								DockPanel.Dock="Right"
								Padding="6,2"
								FontSize="11"
								Focusable="False"
								Margin="6,0,0,0"
								ToolTip.Tip="Open tag vocabulary editor to create, edit, and assign tags to code bar slots"/>
					<ToggleButton Name="BtnCodingMode"
								  Content="Coding (F2)"
								  DockPanel.Dock="Right"
								  Padding="8,2"
								  FontSize="11"
								  Focusable="False"
								  Margin="6,0,0,0"
								  ToolTip.Tip="Toggle coding mode (F2). Keys: W=select block, 1-9=apply tag, E=expand, Q=shrink, Tab=next untagged, hold Space+number=multi-tag"/>
					<ComboBox Name="CmbTagUser"
							  DockPanel.Dock="Right"
							  MinWidth="120" Padding="4,2"
							  FontSize="11"
							  Focusable="False"
							  Margin="6,0,0,0"
							  ToolTip.Tip="Whose tags to display"/>
					<StackPanel Name="CodeBarSlots" Orientation="Horizontal" Spacing="4"
								VerticalAlignment="Center"/>
				</DockPanel>
			</Border>

			<!-- Coding Mode toggle when NOT in coding mode (compact) -->
			<StackPanel Name="CodingToggleRow" Orientation="Horizontal" Margin="0,4,0,0"
						HorizontalAlignment="Left">
				<ToggleButton Name="BtnCodingModeCompact"
							  Content="Coding (F2)"
							  Padding="8,2"
							  FontSize="11"
							  Focusable="False"
							  ToolTip.Tip="Toggle coding mode (F2). Keys: W=select block, 1-9=apply tag, E=expand, Q=shrink, Tab=next untagged, hold Space+number=multi-tag"/>
			</StackPanel>

		<!-- Notes panel -->
		<Border Name="NotesPanel"
				IsVisible="False"
				Background="{DynamicResource ControlBg}"
				BorderBrush="{DynamicResource BorderBrush}"
				BorderThickness="1"
				CornerRadius="8"
				Margin="0,8,0,0"
				Padding="10">

			<!-- Added a 3rd row for footer buttons -->
			<Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto">
				<TextBlock Name="NotesHeader"
						   Grid.Row="0"
						   Grid.Column="0"
						   FontWeight="SemiBold"
						   Text="Note" />

				<StackPanel Grid.Row="0"
							Grid.Column="1"
							Orientation="Horizontal"
							Spacing="6">
					<Button Name="BtnDeleteCommunityNote"
							Content="Delete"
							Padding="10,2"
							Focusable="False"
							IsVisible="False"
							ToolTip.Tip="Delete this community note"/>
					<Button Name="BtnCloseNotes"
							Content="✕"
							Padding="8,2"
							Focusable="False"
							ToolTip.Tip="Close the notes panel"/>
				</StackPanel>

				<ScrollViewer Grid.Row="1"
							  Grid.ColumnSpan="2"
							  MaxHeight="160"
							  VerticalScrollBarVisibility="Auto"
							  HorizontalScrollBarVisibility="Disabled">
					<TextBox Name="NotesBody"
							 IsReadOnly="True"
							 AcceptsReturn="True"
							 TextWrapping="Wrap"
							 Background="Transparent"
							 BorderThickness="0"/>
				</ScrollViewer>

				<!-- Footer actions -->
				<StackPanel Grid.Row="2"
							Grid.ColumnSpan="2"
							Orientation="Horizontal"
							HorizontalAlignment="Right"
							Spacing="8"
							Margin="0,8,0,0">
					<Button Name="BtnMoveFootnote"
							Content="Move footnote"
							Padding="10,2"
							Focusable="False"
							IsVisible="False"
							IsEnabled="False"
							ToolTip.Tip="Move this footnote to a new position in the text"/>
				</StackPanel>
			</Grid>

		</Border>

		</StackPanel> <!-- end coding mode + notes wrapper -->

	</Grid>
</UserControl>