<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ReadZen.App.Views"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:vm="using:ReadZen.App.ViewModels"
             x:DataType="vm:ReadableTabViewModel"
             x:Class="ReadZen.App.Views.ReadableTabView">

	<!-- Only local fallback keys that DON'T collide with your global theme tokens -->
	<UserControl.Resources>
		<SolidColorBrush x:Key="SplitterBrush" Color="#FFD1D1D1"/>
		<SolidColorBrush x:Key="PanelBorderFallback" Color="#FFE8E8E8"/>
	</UserControl.Resources>

	<UserControl.Styles>
		<!-- Keep AvaloniaEdit theme include -->
		<StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

		<!-- Inner AvaloniaEdit (inside your wrapper) must use global dynamic tokens -->
		<Style Selector="local|AnnotatedTextEditor ae|TextEditor">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource TextFg}"/>
			<Setter Property="FontFamily" Value="'Noto Serif CJK SC', 'Source Han Serif SC', SimSun, 'Songti SC', serif"/>
			<Setter Property="WordWrap" Value="True"/>
			<Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
			<Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

		<!-- Row 0: Find bar (hidden by default, toggled with Ctrl+F) -->
		<Border Name="FindBar" Grid.Row="0" IsVisible="False"
				Background="{DynamicResource ControlBg}"
				BorderBrush="{DynamicResource BorderBrush}"
				BorderThickness="1"
				CornerRadius="6"
				Padding="6,4"
				Margin="0,0,0,4">
			<DockPanel LastChildFill="True">
				<Button Name="BtnFindClose" Content="✕" Padding="6,2" FontSize="11"
						DockPanel.Dock="Right" Focusable="False" Margin="4,0,0,0"
						ToolTip.Tip="Close find bar (Escape)"/>
				<TextBlock Name="TxtFindCount" Text="" DockPanel.Dock="Right"
						   VerticalAlignment="Center" FontSize="11" Opacity="0.7"
						   Margin="8,0,4,0"/>
				<Button Name="BtnFindNext" Content="▼" Padding="6,2" FontSize="11"
						DockPanel.Dock="Right" Focusable="False" Margin="2,0,0,0"
						ToolTip.Tip="Next match (Enter)"/>
				<Button Name="BtnFindPrev" Content="▲" Padding="6,2" FontSize="11"
						DockPanel.Dock="Right" Focusable="False" Margin="4,0,0,0"
						ToolTip.Tip="Previous match (Shift+Enter)"/>
				<TextBox Name="TxtFindInput" Watermark="Find in text…"
						 FontSize="12" Padding="6,3" Margin="0,0,4,0"/>
			</DockPanel>
		</Border>

		<!-- Row 1: top action bar -->
		<!-- Row 2: Timeline slider (version history) -->
	<local:TimelineSlider Grid.Row="2" Name="TimelineSlider"
	                      IsVisible="False" Margin="0,0,0,4"/>

	<!-- Row 3: Correction time-travel bar (CE editions only, hidden by default) -->
	<local:CorrectionTimelineBar Grid.Row="3" Name="CorrectionTimeline"
	                              IsVisible="False" Margin="0,0,0,4"/>

	<!-- Row 1: top action bar — ONE slim, fixed-height row (a Grid never
	     wraps, so the bar height is stable at any window width).
	     Left: per-minute reading configuration — language view, layout, and
	     the translation-source picker (only visible when the current text has
	     more than one source; code-behind toggles TranslationSourceGroup in
	     SetTranslationSourceOptions). Right: navigation flyouts (Outline,
	     Bookmarks), the "⚙ View" flyout (display + panel toggles and the Zen
	     metadata flag), the "⋯" overflow flyout (one-shot actions + marker
	     legend), and the ambient reading-progress label. -->
	<Grid Grid.Row="1" Margin="0,0,0,8" ColumnDefinitions="Auto,*,Auto">

		<!-- Left: reading configuration -->
		<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
		            VerticalAlignment="Center">
			<ComboBox Name="CmbReadingView"
			          SelectedIndex="{Binding Reading.ViewModeIndex, Mode=TwoWay}"
			          VerticalAlignment="Center"
			          MinWidth="86"
			          FontSize="12"
			          ToolTip.Tip="Choose which language pane(s) to show: Chinese only, both, or English only.">
				<ComboBoxItem>中 ZH</ComboBoxItem>
				<ComboBoxItem>Both</ComboBoxItem>
				<ComboBoxItem>EN</ComboBoxItem>
			</ComboBox>
			<ComboBox Name="CmbReadingLayout"
			          ItemsSource="{Binding Reading.LayoutModeOptions}"
			          SelectedItem="{Binding Reading.SelectedLayoutOption, Mode=TwoWay}"
			          VerticalAlignment="Center"
			          MinWidth="150"
			          ToolTip.Tip="Switch reading layout. Two-pane modes show original and translation side by side; single-column modes stack them. Merged flow requires a segment map for the current text.">
				<ComboBox.Styles>
					<!-- Group-header rows are non-selectable captions. -->
					<Style Selector="ComboBoxItem" x:DataType="vm:LayoutOption">
						<Setter Property="IsEnabled" Value="{Binding !IsHeader}"/>
					</Style>
				</ComboBox.Styles>
				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="vm:LayoutOption">
						<Panel>
							<TextBlock Text="{Binding Label}"
									   IsVisible="{Binding IsHeader}"
									   FontSize="10" FontWeight="SemiBold"
									   Opacity="0.55" Margin="0,2,0,0"/>
							<TextBlock Text="{Binding Label}"
									   IsVisible="{Binding !IsHeader}"
									   FontSize="12" Margin="8,0,0,0"/>
						</Panel>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>

			<!-- Translation source — hidden unless there is an actual choice
			     (more than one source for the current text). -->
			<StackPanel Name="TranslationSourceGroup" Orientation="Horizontal" Spacing="4"
			            VerticalAlignment="Center" IsVisible="False">
				<ComboBox Name="CmbTranslationSource"
				          MinWidth="170"
				          FontSize="12"
				          VerticalAlignment="Center"
				          ToolTip.Tip="Select whose translation to view"/>
				<Button Name="BtnStarTranslation" Content="&#x2606;" FontSize="16"
				        VerticalAlignment="Center" Padding="4,2" MinWidth="28"
				        ToolTip.Tip="Star this translation"/>
			</StackPanel>
		</StackPanel>

		<!-- Right: navigation + disclosure flyouts, then ambient progress -->
		<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
		            VerticalAlignment="Center">

			<!-- Document outline / TOC flyout -->
			<Button Name="BtnOutline" Content="Outline ▾"
			        FontSize="11" Padding="6,2" Background="Transparent"
			        BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
			        ToolTip.Tip="Jump to a heading in the document">
				<Button.Flyout>
					<Flyout Placement="BottomEdgeAlignedRight">
						<ScrollViewer Width="320" MaxHeight="400"
						              VerticalScrollBarVisibility="Auto"
						              HorizontalScrollBarVisibility="Disabled">
							<StackPanel Name="OutlineList" Spacing="2" Margin="4"/>
						</ScrollViewer>
					</Flyout>
				</Button.Flyout>
			</Button>

			<!-- Bookmarks flyout -->
			<Button Name="BtnBookmarks" Content="Bookmarks ▾"
			        FontSize="11" Padding="6,2" Background="Transparent"
			        BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
			        ToolTip.Tip="Manage bookmarks (Ctrl+B to add)">
				<Button.Flyout>
					<Flyout Placement="BottomEdgeAlignedRight">
						<StackPanel Width="280" MaxHeight="360">
							<Button Content="+ Bookmark here"
							        Command="{Binding Reading.AddBookmarkCommand}"
							        HorizontalAlignment="Stretch" Padding="8,6"
							        FontSize="11" Margin="4"/>
							<Separator Margin="0,2"/>
							<TextBlock Text="No bookmarks yet."
							           FontSize="11" Opacity="0.6" Margin="4"
							           IsVisible="{Binding !Reading.HasBookmarks}"/>
							<ScrollViewer MaxHeight="300"
							              VerticalScrollBarVisibility="Auto"
							              HorizontalScrollBarVisibility="Disabled">
								<ItemsControl ItemsSource="{Binding Reading.Bookmarks}" Margin="4">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:ReadableBookmarkItem">
											<DockPanel Margin="2">
												<Button DockPanel.Dock="Right" Content="&#x2715;"
												        Command="{Binding RemoveCommand}"
												        FontSize="10" Padding="4,1"
												        Background="Transparent" BorderThickness="0"
												        Cursor="Hand" VerticalAlignment="Center"/>
												<Button Content="{Binding DisplayLabel}"
												        Command="{Binding NavigateCommand}"
												        FontSize="11" Padding="6,3"
												        Background="Transparent" BorderThickness="0"
												        Cursor="Hand"
												        Opacity="{Binding LabelOpacity}"
												        HorizontalAlignment="Stretch"
												        HorizontalContentAlignment="Left"/>
											</DockPanel>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</StackPanel>
					</Flyout>
				</Button.Flyout>
			</Button>

			<!-- "⚙ View" flyout: low-frequency display + panel toggles.
			     Designated home for future reading options — do not grow the
			     primary row. -->
			<Button Name="BtnViewOptions" Content="⚙ View ▾"
			        FontSize="11" Padding="6,2" Background="Transparent"
			        BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
			        ToolTip.Tip="View options: line IDs, side panels, Zen text flag">
				<Button.Flyout>
					<Flyout Placement="BottomEdgeAlignedRight">
						<StackPanel Spacing="8" Margin="10,8" MinWidth="170">
							<CheckBox Name="ChkShowLineIds"
							          Content="Line IDs"
							          IsChecked="{Binding Reading.ShowLineIds, Mode=TwoWay}"
							          Focusable="False"
							          ToolTip.Tip="Show line-break (lb) ids. Used by the single-column reading modes."/>
							<Separator/>
							<TextBlock Text="Panels" FontSize="10" FontWeight="SemiBold" Opacity="0.55"/>
							<CheckBox Name="ChkProvenance"
							          Content="Provenance"
							          Focusable="False"
							          ToolTip.Tip="Show or hide the provenance panel with source documentation and witness details"/>
							<CheckBox Name="ChkStudyPanel"
							          Content="Study"
							          Focusable="False"
							          ToolTip.Tip="Show or hide the study panel with dictionary terms, translation memory matches, and contextual info"/>
							<Separator/>
							<CheckBox Name="ChkZenText"
							          Content="Zen text"
							          Focusable="False"
							          ToolTip.Tip="Mark this text as a Zen/Chan Buddhist text"/>
						</StackPanel>
					</Flyout>
				</Button.Flyout>
			</Button>

			<!-- "⋯" overflow flyout: one-shot actions + marker legend -->
			<Button Name="BtnOverflow" Content="⋯"
			        FontSize="14" Padding="8,0" Background="Transparent"
			        BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
			        ToolTip.Tip="More actions">
				<Button.Flyout>
					<Flyout Placement="BottomEdgeAlignedRight">
						<StackPanel Spacing="2" Margin="4" MinWidth="210">
							<Button Name="BtnFind"
							        Content="Find in text (Ctrl+F)"
							        FontSize="11" Padding="8,5"
							        HorizontalAlignment="Stretch"
							        HorizontalContentAlignment="Left"
							        Background="Transparent" BorderThickness="0"
							        Cursor="Hand" Focusable="False"
							        ToolTip.Tip="Find in text (Ctrl+F)"/>
							<Button Name="BtnAddCommunityNote"
							        Content="Add community note"
							        FontSize="11" Padding="8,5"
							        HorizontalAlignment="Stretch"
							        HorizontalContentAlignment="Left"
							        Background="Transparent" BorderThickness="0"
							        Cursor="Hand" Focusable="False"
							        ToolTip.Tip="Add a community note at the current cursor position"/>
							<Button Name="BtnSaveToCollection"
							        Content="Save selection to collection"
							        FontSize="11" Padding="8,5"
							        HorizontalAlignment="Stretch"
							        HorizontalContentAlignment="Left"
							        Background="Transparent" BorderThickness="0"
							        Cursor="Hand" Focusable="False"
							        ToolTip.Tip="Save the current passage to your Scholar collection"/>
							<Button Name="BtnCompareTranslations"
							        Content="Compare translations…"
							        FontSize="11" Padding="8,5"
							        HorizontalAlignment="Stretch"
							        HorizontalContentAlignment="Left"
							        Background="Transparent" BorderThickness="0"
							        Cursor="Hand" Focusable="False"
							        ToolTip.Tip="Open a 3-pane window comparing original text with two translation sources"/>
							<Separator Margin="0,4"/>
							<TextBlock Text="Marker legend"
							           FontSize="10" FontWeight="SemiBold"
							           Opacity="0.55" Margin="8,0,0,2"/>
							<StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0,8,0">
								<Border Background="#9A9A9A" Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"/>
								<TextBlock Text="CBETA editorial / apparatus" FontSize="11"/>
							</StackPanel>
							<StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0,8,0">
								<Border Background="#E6C35C" Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"/>
								<TextBlock Text="Master notes" FontSize="11"/>
							</StackPanel>
							<StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0,8,4">
								<Border Background="DodgerBlue" Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"/>
								<TextBlock Text="Community annotations" FontSize="11"/>
							</StackPanel>
						</StackPanel>
					</Flyout>
				</Button.Flyout>
			</Button>

			<!-- Ambient reading progress -->
			<TextBlock Name="TxtReadingProgress"
			           Text="{Binding Reading.ReadingProgressText}"
			           FontSize="11" Opacity="0.6"
			           VerticalAlignment="Center"
			           Margin="8,0,0,0"/>
		</StackPanel>
	</Grid>

		<!-- Row 4: two readable panes + study panel + empty state overlay -->
		<Grid Grid.Row="4">
			<Grid Name="ReaderOuterGrid" ColumnDefinitions="*,0,0">
				<!-- Column 0: existing two-pane content -->
				<Grid Grid.Column="0">
					<Grid Name="TwoPaneGrid" ColumnDefinitions="1*,Auto,2*" Margin="0">

						<Border Grid.Column="0"
								Background="{DynamicResource XmlViewerBg}"
								BorderBrush="{DynamicResource XmlViewerBorder}"
								BorderThickness="1"
								CornerRadius="6">
							<Grid RowDefinitions="Auto,*,Auto">
								<Border Background="{DynamicResource XmlViewerBg}" Padding="8">
									<DockPanel LastChildFill="False">
										<TextBlock DockPanel.Dock="Left" Text="Original (read-only)"
										           Classes="muted" VerticalAlignment="Center"/>
										<!-- Visible always-linked-scroll affordance for SyncedPanes: the mode
										     forces cross-pane scroll sync on regardless of the config toggle, so
										     surface a chip the user can see (bound to the mode-derived observable). -->
										<Border DockPanel.Dock="Right"
										        IsVisible="{Binding Reading.ScrollSync.IsSyncForcedByMode}"
										        Background="{DynamicResource TabAccent}"
										        CornerRadius="9" Padding="7,1" VerticalAlignment="Center"
										        ToolTip.Tip="Synced Panes: the two panes always scroll together. This overrides the global scroll-sync setting.">
											<TextBlock Text="&#x2194; Linked scroll"
											           FontSize="11" FontWeight="SemiBold"
											           Foreground="White"/>
										</Border>
									</DockPanel>
								</Border>

								<local:AnnotatedTextEditor Name="EditorOriginal"
														   Grid.Row="1"/>

								<!-- Footnotes panel - below Chinese text editor -->
								<Border Name="FootnotesPanel" Grid.Row="2" IsVisible="False"
										BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
										BorderThickness="0,1,0,0" Padding="8,4" MaxHeight="200">
									<StackPanel Spacing="2">
										<TextBlock Text="Apparatus Notes" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,2"/>
										<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="170">
											<StackPanel Name="FootnotesHost" Spacing="4"/>
										</ScrollViewer>
									</StackPanel>
								</Border>
							</Grid>
						</Border>

						<GridSplitter Name="PaneSplitter"
									  Grid.Column="1"
									  Width="6"
									  Background="{DynamicResource SplitterBrush}"
									  ResizeDirection="Columns"
									  ResizeBehavior="PreviousAndNext"/>

						<Border Grid.Column="2"
								Background="{DynamicResource XmlViewerBg}"
								BorderBrush="{DynamicResource XmlViewerBorder}"
								BorderThickness="1"
								CornerRadius="6">
							<Grid RowDefinitions="Auto,*">
								<Border Background="{DynamicResource XmlViewerBg}" Padding="8">
									<TextBlock Text="Translated (readable view)" Classes="muted"/>
								</Border>

								<local:AnnotatedTextEditor Name="EditorTranslated"
														   Grid.Row="1"/>
							</Grid>
						</Border>

					</Grid>

					<!-- Wave C row-grid reading surface: shown INSTEAD of TwoPaneGrid for
					     grid modes (AlignedLines in C1). Under the shared DictOverlayCanvas,
					     above the two-pane content. -->
					<local:RowGridSurface Name="RowGridSurface" IsVisible="False"
										  HorizontalAlignment="Stretch"
										  VerticalAlignment="Stretch"/>

					<!-- Empty state overlay -->
					<Border Name="ReadableEmptyState" IsVisible="True"
							IsHitTestVisible="True"
							Background="{DynamicResource AppBg}"
							HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
						<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
							<TextBlock Text="No file loaded" FontSize="18" FontWeight="SemiBold"
									   HorizontalAlignment="Center"/>
							<TextBlock Text="Select a file from the sidebar to begin reading."
									   TextWrapping="Wrap" HorizontalAlignment="Center"
									   TextAlignment="Center" Classes="muted"/>
						</StackPanel>
					</Border>

					<!-- Dictionary hover overlay (hit-test-invisible Canvas prevents flicker) -->
					<Canvas Name="DictOverlayCanvas" IsHitTestVisible="False" ZIndex="500"/>
				</Grid>

				<!-- Column 1: study panel splitter -->
				<GridSplitter Name="StudyPanelSplitter"
							  Grid.Column="1" Width="8"
							  IsVisible="False"
							  ResizeDirection="Columns"
							  ResizeBehavior="PreviousAndNext"
							  Background="Transparent"/>

				<!-- Column 2: right side panels (study + provenance + commentary) -->
				<Grid Name="RightPanelHost" Grid.Column="2" RowDefinitions="*,*,Auto">
					<!-- Row 0: study panel -->
					<Border Name="StudyPanel"
							Grid.Row="0"
							IsVisible="False"
							Padding="8"
							Background="{DynamicResource ControlBg}"
							BorderBrush="{DynamicResource XmlViewerBorder}"
							BorderThickness="1,0,0,0">
						<ScrollViewer HorizontalScrollBarVisibility="Disabled"
									  VerticalScrollBarVisibility="Auto">
							<StackPanel Spacing="10">
								<TextBlock Text="Study Panel" FontWeight="Bold"/>
								<ProgressBar Name="StudyLoadingBar"
											 IsIndeterminate="True"
											 IsVisible="False"
											 Height="3"
											 Margin="0,4,0,0"/>

								<Border Padding="8" CornerRadius="6"
										BorderThickness="1"
										BorderBrush="{DynamicResource BorderBrush}">
									<StackPanel Spacing="4">
										<TextBlock Text="Zen Dictionary" FontWeight="Bold"/>
										<TextBlock Name="TxtStudyDictHeadword" FontSize="18" FontWeight="SemiBold"/>
										<TextBlock Name="TxtStudyDictGloss" FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
										<StackPanel Name="StudyDictSenses" Spacing="2"/>
									</StackPanel>
								</Border>

								<Border Padding="8" CornerRadius="6"
										BorderThickness="1"
										BorderBrush="{DynamicResource BorderBrush}">
									<StackPanel Spacing="6">
										<TextBlock Text="Segment" FontWeight="Bold"/>
										<TextBlock Name="TxtStudySegmentZh"
												   TextWrapping="Wrap" FontSize="13"/>
										<TextBlock Name="TxtStudySegmentEn"
												   TextWrapping="Wrap" FontSize="12"
												   Opacity="0.8"/>
									</StackPanel>
								</Border>

								<Border Padding="8" CornerRadius="6"
										BorderThickness="1"
										BorderBrush="{DynamicResource BorderBrush}">
									<StackPanel Spacing="6">
										<TextBlock Text="Glossary" FontWeight="Bold"/>
										<StackPanel Name="StudyTermHost" Spacing="10"/>
									</StackPanel>
								</Border>

								<Border Padding="8" CornerRadius="6"
										BorderThickness="1"
										BorderBrush="{DynamicResource BorderBrush}">
									<StackPanel Spacing="6">
										<TextBlock Text="Translation Memory" FontWeight="Bold"/>
										<StackPanel Name="StudyTmHost" Spacing="10"/>
									</StackPanel>
								</Border>

								<Border Name="StudyMasterBorder" Padding="8" CornerRadius="6"
										BorderThickness="1"
										BorderBrush="{DynamicResource BorderBrush}"
										IsVisible="False">
									<StackPanel Spacing="4">
										<TextBlock Text="Zen Master" FontWeight="Bold"/>
										<TextBlock Name="TxtStudyMasterName" FontSize="14" FontWeight="SemiBold"/>
										<TextBlock Name="TxtStudyMasterDates" FontSize="11" Opacity="0.7"/>
										<TextBlock Name="TxtStudyMasterSchool" FontSize="11" Opacity="0.8" IsVisible="False"/>
										<TextBlock Name="TxtStudyMasterTeacher" FontSize="11" Opacity="0.8" IsVisible="False"/>
										<TextBlock Name="TxtStudyMasterNotes" FontSize="11" Opacity="0.85"
												   TextWrapping="Wrap" IsVisible="False"/>
										<Button Name="BtnStudyMasterOpen" Content="View Master →"
												FontSize="11" Padding="8,4" Margin="0,4,0,0"
												HorizontalAlignment="Left"/>
									</StackPanel>
								</Border>
							</StackPanel>
						</ScrollViewer>
					</Border>

					<!-- Row 1: provenance panel -->
					<Border Name="ProvenancePanelBorder"
							Grid.Row="1"
							IsVisible="False"
							Background="{DynamicResource ControlBg}"
							BorderBrush="{DynamicResource XmlViewerBorder}"
							BorderThickness="1,1,0,0">
						<local:ProvenancePanel Name="ProvenancePanelView"/>
					</Border>

					<!-- Row 2: Chinese commentary panel (opt-in via manifest.commentary_reader_languages) -->
					<Border Name="CommentaryPanelBorder"
							Grid.Row="2"
							IsVisible="False"
							Background="{DynamicResource ControlBg}"
							BorderBrush="{DynamicResource XmlViewerBorder}"
							BorderThickness="1,1,0,0"
							MaxHeight="280">
						<ScrollViewer HorizontalScrollBarVisibility="Disabled"
									  VerticalScrollBarVisibility="Auto">
							<StackPanel Spacing="6" Margin="8">
								<TextBlock Text="Chinese Commentary" FontWeight="Bold" FontSize="14"/>
								<TextBlock Name="CommentaryEmptyState"
										   Text="No Chinese commentary available for this text yet."
										   Classes="muted"
										   FontSize="11"
										   TextWrapping="Wrap"
										   IsVisible="False"/>
								<StackPanel Name="CommentaryHost" Spacing="6"/>
							</StackPanel>
						</ScrollViewer>
					</Border>
				</Grid>
			</Grid>
		</Grid>

		<!-- Row 3: coding mode bar + notes panel -->

		<!-- Coding Mode toggle button - always visible -->
		<StackPanel Grid.Row="5" Orientation="Vertical" Spacing="0">

			<!-- Code bar - visible only in coding mode -->
			<Border Name="CodeBarPanel" IsVisible="False"
					Background="{DynamicResource ControlBg}"
					BorderBrush="{DynamicResource BorderBrush}"
					BorderThickness="1"
					CornerRadius="6"
					Padding="6,5"
					Margin="0,4,0,0">
				<DockPanel LastChildFill="True">
					<TextBlock Name="TxtCodeBarPage" Text="Page 1"
							   DockPanel.Dock="Left"
							   VerticalAlignment="Center"
							   FontSize="11" FontWeight="SemiBold"
							   Margin="0,0,10,0"
							   Opacity="0.7"/>
					<TextBlock Name="TxtCodeBarStatus" Text=""
							   DockPanel.Dock="Right"
							   VerticalAlignment="Center"
							   FontSize="11"
							   Opacity="0.6"
							   Margin="10,0,0,0"/>
					<Button Name="BtnEditTags"
								Content="&#x270E; Edit Tags"
								DockPanel.Dock="Right"
								Padding="6,2"
								FontSize="11"
								Focusable="False"
								Margin="6,0,0,0"
								ToolTip.Tip="Open tag vocabulary editor to create, edit, and assign tags to code bar slots"/>
					<ToggleButton Name="BtnCodingMode"
								  Content="Tagging (F2)"
								  DockPanel.Dock="Right"
								  Padding="8,2"
								  FontSize="11"
								  Focusable="False"
								  Margin="6,0,0,0"
								  ToolTip.Tip="Toggle coding mode (F2). Keys: W=select block, 1-9=apply tag, E=expand, Q=shrink, Tab=next untagged, hold Space+number=multi-tag"/>
					<Button Name="BtnCompareTags"
							Content="Compare"
							DockPanel.Dock="Right"
							Padding="6,2"
							FontSize="11"
							Focusable="False"
							Margin="4,0,0,0"
							ToolTip.Tip="Open a 3-pane window comparing your tags with the selected user's tags"/>
					<Button Name="BtnAnalytics"
							Content="Analytics &#x25BE;"
							DockPanel.Dock="Right"
							Padding="6,2"
							FontSize="11"
							Focusable="False"
							Margin="4,0,0,0"
							ToolTip.Tip="Qualitative analytics: frequency, co-occurrence, variables, queries, export">
						<Button.Flyout>
							<MenuFlyout>
								<MenuItem Name="MiCodeFrequency" Header="Tag Frequency Report"/>
								<MenuItem Name="MiCooccurrence" Header="Tag Overlap Analysis"/>
								<MenuItem Name="MiDocVariables" Header="Document Variables"/>
								<MenuItem Name="MiQueryBuilder" Header="Query Builder"/>
								<Separator/>
								<MenuItem Name="MiExportQdpx" Header="Export Coding Data"/>
							</MenuFlyout>
						</Button.Flyout>
					</Button>
					<ComboBox Name="CmbTagUser"
							  DockPanel.Dock="Right"
							  MinWidth="120" Padding="4,2"
							  FontSize="11"
							  Focusable="False"
							  Margin="6,0,0,0"
							  ToolTip.Tip="Whose tags to display"/>
					<StackPanel Name="CodeBarSlots" Orientation="Horizontal" Spacing="4"
								VerticalAlignment="Center"/>
				</DockPanel>
			</Border>

			<!-- Coding Mode toggle when NOT in coding mode (compact) -->
			<StackPanel Name="CodingToggleRow" Orientation="Horizontal" Margin="0,4,0,0"
						HorizontalAlignment="Left">
				<ToggleButton Name="BtnCodingModeCompact"
							  Content="Tagging (F2)"
							  Padding="8,2"
							  FontSize="11"
							  Focusable="False"
							  ToolTip.Tip="Toggle coding mode (F2). Keys: W=select block, 1-9=apply tag, E=expand, Q=shrink, Tab=next untagged, hold Space+number=multi-tag"/>
			</StackPanel>

		<!-- Notes panel -->
		<Border Name="NotesPanel"
				IsVisible="False"
				Background="{DynamicResource ControlBg}"
				BorderBrush="{DynamicResource BorderBrush}"
				BorderThickness="1"
				CornerRadius="8"
				Margin="0,8,0,0"
				Padding="10">

			<!-- Added a 3rd row for footer buttons -->
			<Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto">
				<TextBlock Name="NotesHeader"
						   Grid.Row="0"
						   Grid.Column="0"
						   FontWeight="SemiBold"
						   Text="Note" />

				<StackPanel Grid.Row="0"
							Grid.Column="1"
							Orientation="Horizontal"
							Spacing="6">
					<Button Name="BtnDeleteCommunityNote"
							Content="Delete"
							Padding="10,2"
							Focusable="False"
							IsVisible="False"
							ToolTip.Tip="Delete this community note"/>
					<Button Name="BtnCloseNotes"
							Content="✕"
							Padding="8,2"
							Focusable="False"
							ToolTip.Tip="Close the notes panel"/>
				</StackPanel>

				<ScrollViewer Grid.Row="1"
							  Grid.ColumnSpan="2"
							  MaxHeight="160"
							  VerticalScrollBarVisibility="Auto"
							  HorizontalScrollBarVisibility="Disabled">
					<TextBox Name="NotesBody"
							 IsReadOnly="True"
							 AcceptsReturn="True"
							 TextWrapping="Wrap"
							 Background="Transparent"
							 BorderThickness="0"/>
				</ScrollViewer>

				<!-- Footer actions -->
				<StackPanel Grid.Row="2"
							Grid.ColumnSpan="2"
							Orientation="Horizontal"
							HorizontalAlignment="Right"
							Spacing="8"
							Margin="0,8,0,0">
					<Button Name="BtnMoveFootnote"
							Content="Move footnote"
							Padding="10,2"
							Focusable="False"
							IsVisible="False"
							IsEnabled="False"
							ToolTip.Tip="Move this footnote to a new position in the text"/>
				</StackPanel>
			</Grid>

		</Border>

		</StackPanel> <!-- end coding mode + notes wrapper -->

	</Grid>
</UserControl>
