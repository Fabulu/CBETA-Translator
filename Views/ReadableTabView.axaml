<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ReadZen.App.Views"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:vm="using:ReadZen.App.ViewModels"
             x:DataType="vm:ReadableTabViewModel"
             x:Class="ReadZen.App.Views.ReadableTabView">

	<!-- Only local fallback keys that DON'T collide with your global theme tokens -->
	<UserControl.Resources>
		<SolidColorBrush x:Key="SplitterBrush" Color="#FFD1D1D1"/>
		<SolidColorBrush x:Key="PanelBorderFallback" Color="#FFE8E8E8"/>
	</UserControl.Resources>

	<UserControl.Styles>
		<!-- Keep AvaloniaEdit theme include -->
		<StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

		<!-- Inner AvaloniaEdit (inside your wrapper) must use global dynamic tokens -->
		<Style Selector="local|AnnotatedTextEditor ae|TextEditor">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource TextFg}"/>
			<Setter Property="FontFamily" Value="'Noto Serif CJK SC', 'Source Han Serif SC', SimSun, 'Songti SC', serif"/>
			<Setter Property="WordWrap" Value="True"/>
			<Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
			<Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

		<!-- Row 0: Find bar (hidden by default, toggled with Ctrl+F) -->
		<Border Name="FindBar" Grid.Row="0" IsVisible="False"
				Background="{DynamicResource ControlBg}"
				BorderBrush="{DynamicResource BorderBrush}"
				BorderThickness="1"
				CornerRadius="6"
				Padding="6,4"
				Margin="0,0,0,4">
			<DockPanel LastChildFill="True">
				<Button Name="BtnFindClose" Content="✕" Padding="6,2" FontSize="11"
						DockPanel.Dock="Right" Focusable="False" Margin="4,0,0,0"
						ToolTip.Tip="Close find bar (Escape)"/>
				<TextBlock Name="TxtFindCount" Text="" DockPanel.Dock="Right"
						   VerticalAlignment="Center" FontSize="11" Opacity="0.7"
						   Margin="8,0,4,0"/>
				<Button Name="BtnFindNext" Content="▼" Padding="6,2" FontSize="11"
						DockPanel.Dock="Right" Focusable="False" Margin="2,0,0,0"
						ToolTip.Tip="Next match (Enter)"/>
				<Button Name="BtnFindPrev" Content="▲" Padding="6,2" FontSize="11"
						DockPanel.Dock="Right" Focusable="False" Margin="4,0,0,0"
						ToolTip.Tip="Previous match (Shift+Enter)"/>
				<TextBox Name="TxtFindInput" Watermark="Find in text…"
						 FontSize="12" Padding="6,3" Margin="0,0,4,0"/>
			</DockPanel>
		</Border>

		<!-- Row 1: top action bar -->
		<!-- Row 2: Timeline slider (version history) -->
	<local:TimelineSlider Grid.Row="2" Name="TimelineSlider"
	                      IsVisible="False" Margin="0,0,0,4"/>

	<!-- Row 3: Correction time-travel bar (CE editions only, hidden by default) -->
	<local:CorrectionTimelineBar Grid.Row="3" Name="CorrectionTimeline"
	                              IsVisible="False" Margin="0,0,0,4"/>

	<DockPanel Grid.Row="1"
				   Margin="0,0,0,8"
				   LastChildFill="True">

			<StackPanel Orientation="Horizontal"
						Spacing="8"
						DockPanel.Dock="Left">
				<Button Name="BtnAddCommunityNote"
						Content="Add community note"
						Focusable="False"
						ToolTip.Tip="Add a community note at the current cursor position"/>
				<Button Name="BtnDictionary"
						Content="Dictionary"
						Padding="6,2"
						FontSize="11"
						Focusable="False"
						ToolTip.Tip="Open the Zen Dictionary (Ctrl+D)"/>
				<Button Name="BtnFind"
						Content="🔍 Find"
						Padding="6,2"
						FontSize="11"
						Focusable="False"
						ToolTip.Tip="Find in text (Ctrl+F)"/>
				<Button Name="BtnSaveToCollection"
						Content="📥 Save to Collection"
						Padding="6,2"
						FontSize="11"
						Focusable="False"
						ToolTip.Tip="Save the current passage to your Scholar collection"/>
			</StackPanel>

			<Button Name="BtnCompareTranslations"
					DockPanel.Dock="Right"
					Content="Compare Translations"
					Padding="6,2"
					FontSize="11"
					Focusable="False"
					Margin="4,0,0,0"
					ToolTip.Tip="Open a 3-pane window comparing original text with two translation sources"/>

			<!-- Version picker ComboBox (hidden, still used as fallback data carrier) -->
			<ComboBox Name="CmbVersionPicker"
					  DockPanel.Dock="Right"
					  MinWidth="120"
					  FontSize="11"
					  Margin="4,0,0,0"
					  IsVisible="False"
					  ToolTip.Tip="View an older version of this translation (git history)"/>
			<Button Name="BtnStarTranslation" Content="&#x2606;" FontSize="16"
					DockPanel.Dock="Right" Margin="4,0,0,0"
					ToolTip.Tip="Star this translation" Padding="4,2" MinWidth="28"/>
			<ComboBox Name="CmbTranslationSource"
					  DockPanel.Dock="Right"
					  MinWidth="170"
					  FontSize="12"
					  Margin="8,0,0,0"
					  ToolTip.Tip="Select whose translation to view"/>
			<TextBlock DockPanel.Dock="Right" Text="Source:" VerticalAlignment="Center"
					   FontSize="11" Margin="8,0,4,0" Opacity="0.7"/>

			<CheckBox Name="ChkProvenance"
					  DockPanel.Dock="Right"
					  Content="Provenance"
					  VerticalAlignment="Center"
					  Focusable="False"
					  Margin="8,0,0,0"
					  ToolTip.Tip="Show or hide the provenance panel with source documentation and witness details"/>

			<CheckBox Name="ChkStudyPanel"
					  DockPanel.Dock="Right"
					  Content="Study"
					  VerticalAlignment="Center"
					  Focusable="False"
					  Margin="8,0,0,0"
					  ToolTip.Tip="Show or hide the study panel with dictionary terms, translation memory matches, and contextual info"/>

			<CheckBox Name="ChkZenText"
					  DockPanel.Dock="Right"
					  Content="Zen"
					  VerticalAlignment="Center"
					  Focusable="False"
					  ToolTip.Tip="Mark this text as a Zen/Chan Buddhist text"/>

			<!-- License chip lives in the top bar now (next to the corpus
			     badge) so the action row stays uncluttered. -->

			<!-- Annotation legend (collapsible flyout) -->
			<Button Name="BtnMarkersLegend" Content="Legend ▾"
			        FontSize="11" Padding="6,2" Background="Transparent"
			        BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
			        Margin="16,0,0,0">
				<Button.Flyout>
					<Flyout Placement="BottomEdgeAlignedLeft">
						<StackPanel Spacing="6" Margin="8">
							<StackPanel Orientation="Horizontal" Spacing="4">
								<Border Background="Gray" Width="10" Height="10" CornerRadius="2"/>
								<TextBlock Text="Source text editorial markers" FontSize="11"/>
							</StackPanel>
							<StackPanel Orientation="Horizontal" Spacing="4">
								<Border Background="DarkOrange" Width="10" Height="10" CornerRadius="2"/>
								<TextBlock Text="Footnotes" FontSize="11"/>
							</StackPanel>
							<StackPanel Orientation="Horizontal" Spacing="4">
								<Border Background="DodgerBlue" Width="10" Height="10" CornerRadius="2"/>
								<TextBlock Text="Community annotations" FontSize="11"/>
							</StackPanel>
						</StackPanel>
					</Flyout>
				</Button.Flyout>
			</Button>

			<!-- Bookmarks flyout -->
			<Button Name="BtnBookmarks" Content="Bookmarks ▾"
			        FontSize="11" Padding="6,2" Background="Transparent"
			        BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
			        Margin="8,0,0,0"
			        ToolTip.Tip="Manage bookmarks (Ctrl+B to add)">
				<Button.Flyout>
					<Flyout Placement="BottomEdgeAlignedLeft">
						<StackPanel Width="280" MaxHeight="360">
							<Button Name="BtnAddBookmark" Content="+ Bookmark here"
							        HorizontalAlignment="Stretch" Padding="8,6"
							        FontSize="11" Margin="4"/>
							<Separator Margin="0,2"/>
							<ScrollViewer MaxHeight="300"
							              VerticalScrollBarVisibility="Auto"
							              HorizontalScrollBarVisibility="Disabled">
								<StackPanel Name="BookmarkList" Spacing="2" Margin="4"/>
							</ScrollViewer>
						</StackPanel>
					</Flyout>
				</Button.Flyout>
			</Button>

			<!-- Document outline / TOC flyout -->
			<Button Name="BtnOutline" Content="Outline ▾"
			        FontSize="11" Padding="6,2" Background="Transparent"
			        BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
			        Margin="8,0,0,0"
			        ToolTip.Tip="Jump to a heading in the document">
				<Button.Flyout>
					<Flyout Placement="BottomEdgeAlignedLeft">
						<ScrollViewer Width="320" MaxHeight="400"
						              VerticalScrollBarVisibility="Auto"
						              HorizontalScrollBarVisibility="Disabled">
							<StackPanel Name="OutlineList" Spacing="2" Margin="4"/>
						</ScrollViewer>
					</Flyout>
				</Button.Flyout>
			</Button>

			<TextBlock Name="TxtReadingProgress" Text=""
			           FontSize="11" Opacity="0.6"
			           VerticalAlignment="Center"
			           Margin="12,0,0,0"/>
			<Border/>
		</DockPanel>

		<!-- Row 4: two readable panes + study panel + empty state overlay -->
		<Grid Grid.Row="4">
			<Grid Name="ReaderOuterGrid" ColumnDefinitions="*,0,0">
				<!-- Column 0: existing two-pane content -->
				<Grid Grid.Column="0">
					<Grid Name="TwoPaneGrid" ColumnDefinitions="1*,Auto,2*" Margin="0">

						<Border Grid.Column="0"
								Background="{DynamicResource XmlViewerBg}"
								BorderBrush="{DynamicResource XmlViewerBorder}"
								BorderThickness="1"
								CornerRadius="6">
							<Grid RowDefinitions="Auto,*">
								<Border Background="{DynamicResource XmlViewerBg}" Padding="8">
									<TextBlock Text="Original (read-only)" Classes="muted"/>
								</Border>

								<local:AnnotatedTextEditor Name="EditorOriginal"
														   Grid.Row="1"/>
							</Grid>
						</Border>

						<GridSplitter Grid.Column="1"
									  Width="6"
									  Background="{DynamicResource SplitterBrush}"
									  ResizeDirection="Columns"
									  ResizeBehavior="PreviousAndNext"/>

						<Border Grid.Column="2"
								Background="{DynamicResource XmlViewerBg}"
								BorderBrush="{DynamicResource XmlViewerBorder}"
								BorderThickness="1"
								CornerRadius="6">
							<Grid RowDefinitions="Auto,*">
								<Border Background="{DynamicResource XmlViewerBg}" Padding="8">
									<TextBlock Text="Translated (readable view)" Classes="muted"/>
								</Border>

								<local:AnnotatedTextEditor Name="EditorTranslated"
														   Grid.Row="1"/>
							</Grid>
						</Border>

					</Grid>

					<!-- Empty state overlay -->
					<Border Name="ReadableEmptyState" IsVisible="True"
							IsHitTestVisible="True"
							Background="{DynamicResource AppBg}"
							HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
						<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
							<TextBlock Text="No file loaded" FontSize="18" FontWeight="SemiBold"
									   HorizontalAlignment="Center"/>
							<TextBlock Text="Select a file from the sidebar to begin reading."
									   TextWrapping="Wrap" HorizontalAlignment="Center"
									   TextAlignment="Center" Classes="muted"/>
						</StackPanel>
					</Border>

					<!-- Dictionary hover overlay (hit-test-invisible Canvas prevents flicker) -->
					<Canvas Name="DictOverlayCanvas" IsHitTestVisible="False" ZIndex="500"/>
				</Grid>

				<!-- Column 1: study panel splitter -->
				<GridSplitter Name="StudyPanelSplitter"
							  Grid.Column="1" Width="8"
							  IsVisible="False"
							  ResizeDirection="Columns"
							  ResizeBehavior="PreviousAndNext"
							  Background="Transparent"/>

				<!-- Column 2: right side panels (study + provenance) -->
				<Grid Name="RightPanelHost" Grid.Column="2" RowDefinitions="*,*">
					<!-- Row 0: study panel -->
					<Border Name="StudyPanel"
							Grid.Row="0"
							IsVisible="False"
							Padding="8"
							Background="{DynamicResource ControlBg}"
							BorderBrush="{DynamicResource XmlViewerBorder}"
							BorderThickness="1,0,0,0">
						<ScrollViewer HorizontalScrollBarVisibility="Disabled"
									  VerticalScrollBarVisibility="Auto">
							<StackPanel Spacing="10">
								<TextBlock Text="Study Panel" FontWeight="Bold"/>
								<ProgressBar Name="StudyLoadingBar"
											 IsIndeterminate="True"
											 IsVisible="False"
											 Height="3"
											 Margin="0,4,0,0"/>

								<Border Padding="8" CornerRadius="6"
										BorderThickness="1"
										BorderBrush="{DynamicResource BorderBrush}">
									<StackPanel Spacing="4">
										<TextBlock Text="Dictionary" FontWeight="Bold"/>
										<TextBlock Name="TxtStudyDictHeadword" FontSize="18" FontWeight="SemiBold"/>
										<TextBlock Name="TxtStudyDictPinyin" FontSize="12" Opacity="0.8"/>
										<StackPanel Name="StudyDictSenses" Spacing="2"/>
									</StackPanel>
								</Border>

								<Border Padding="8" CornerRadius="6"
										BorderThickness="1"
										BorderBrush="{DynamicResource BorderBrush}">
									<StackPanel Spacing="6">
										<TextBlock Text="Segment" FontWeight="Bold"/>
										<TextBlock Name="TxtStudySegmentZh"
												   TextWrapping="Wrap" FontSize="13"/>
										<TextBlock Name="TxtStudySegmentEn"
												   TextWrapping="Wrap" FontSize="12"
												   Opacity="0.8"/>
									</StackPanel>
								</Border>

								<Border Padding="8" CornerRadius="6"
										BorderThickness="1"
										BorderBrush="{DynamicResource BorderBrush}">
									<StackPanel Spacing="6">
										<TextBlock Text="Glossary" FontWeight="Bold"/>
										<StackPanel Name="StudyTermHost" Spacing="10"/>
									</StackPanel>
								</Border>

								<Border Padding="8" CornerRadius="6"
										BorderThickness="1"
										BorderBrush="{DynamicResource BorderBrush}">
									<StackPanel Spacing="6">
										<TextBlock Text="Translation Memory" FontWeight="Bold"/>
										<StackPanel Name="StudyTmHost" Spacing="10"/>
									</StackPanel>
								</Border>

								<Border Name="StudyMasterBorder" Padding="8" CornerRadius="6"
										BorderThickness="1"
										BorderBrush="{DynamicResource BorderBrush}"
										IsVisible="False">
									<StackPanel Spacing="4">
										<TextBlock Text="Zen Master" FontWeight="Bold"/>
										<TextBlock Name="TxtStudyMasterName" FontSize="14" FontWeight="SemiBold"/>
										<TextBlock Name="TxtStudyMasterDates" FontSize="11" Opacity="0.7"/>
										<TextBlock Name="TxtStudyMasterSchool" FontSize="11" Opacity="0.8" IsVisible="False"/>
										<TextBlock Name="TxtStudyMasterTeacher" FontSize="11" Opacity="0.8" IsVisible="False"/>
										<TextBlock Name="TxtStudyMasterNotes" FontSize="11" Opacity="0.85"
												   TextWrapping="Wrap" IsVisible="False"/>
										<Button Name="BtnStudyMasterOpen" Content="View Master →"
												FontSize="11" Padding="8,4" Margin="0,4,0,0"
												HorizontalAlignment="Left"/>
									</StackPanel>
								</Border>
							</StackPanel>
						</ScrollViewer>
					</Border>

					<!-- Row 1: provenance panel -->
					<Border Name="ProvenancePanelBorder"
							Grid.Row="1"
							IsVisible="False"
							Background="{DynamicResource ControlBg}"
							BorderBrush="{DynamicResource XmlViewerBorder}"
							BorderThickness="1,1,0,0">
						<local:ProvenancePanel Name="ProvenancePanelView"/>
					</Border>
				</Grid>
			</Grid>
		</Grid>

		<!-- Row 3: coding mode bar + notes panel -->

		<!-- Coding Mode toggle button - always visible -->
		<StackPanel Grid.Row="5" Orientation="Vertical" Spacing="0">

			<!-- Code bar - visible only in coding mode -->
			<Border Name="CodeBarPanel" IsVisible="False"
					Background="{DynamicResource ControlBg}"
					BorderBrush="{DynamicResource BorderBrush}"
					BorderThickness="1"
					CornerRadius="6"
					Padding="6,5"
					Margin="0,4,0,0">
				<DockPanel LastChildFill="True">
					<TextBlock Name="TxtCodeBarPage" Text="Page 1"
							   DockPanel.Dock="Left"
							   VerticalAlignment="Center"
							   FontSize="11" FontWeight="SemiBold"
							   Margin="0,0,10,0"
							   Opacity="0.7"/>
					<TextBlock Name="TxtCodeBarStatus" Text=""
							   DockPanel.Dock="Right"
							   VerticalAlignment="Center"
							   FontSize="11"
							   Opacity="0.6"
							   Margin="10,0,0,0"/>
					<Button Name="BtnEditTags"
								Content="&#x270E; Edit Tags"
								DockPanel.Dock="Right"
								Padding="6,2"
								FontSize="11"
								Focusable="False"
								Margin="6,0,0,0"
								ToolTip.Tip="Open tag vocabulary editor to create, edit, and assign tags to code bar slots"/>
					<ToggleButton Name="BtnCodingMode"
								  Content="Tagging (F2)"
								  DockPanel.Dock="Right"
								  Padding="8,2"
								  FontSize="11"
								  Focusable="False"
								  Margin="6,0,0,0"
								  ToolTip.Tip="Toggle coding mode (F2). Keys: W=select block, 1-9=apply tag, E=expand, Q=shrink, Tab=next untagged, hold Space+number=multi-tag"/>
					<Button Name="BtnCompareTags"
							Content="Compare"
							DockPanel.Dock="Right"
							Padding="6,2"
							FontSize="11"
							Focusable="False"
							Margin="4,0,0,0"
							ToolTip.Tip="Open a 3-pane window comparing your tags with the selected user's tags"/>
					<Button Name="BtnAnalytics"
							Content="Analytics &#x25BE;"
							DockPanel.Dock="Right"
							Padding="6,2"
							FontSize="11"
							Focusable="False"
							Margin="4,0,0,0"
							ToolTip.Tip="Qualitative analytics: frequency, co-occurrence, variables, queries, export">
						<Button.Flyout>
							<MenuFlyout>
								<MenuItem Name="MiCodeFrequency" Header="Tag Frequency Report"/>
								<MenuItem Name="MiCooccurrence" Header="Tag Overlap Analysis"/>
								<MenuItem Name="MiDocVariables" Header="Document Variables"/>
								<MenuItem Name="MiQueryBuilder" Header="Query Builder"/>
								<Separator/>
								<MenuItem Name="MiExportQdpx" Header="Export Coding Data"/>
							</MenuFlyout>
						</Button.Flyout>
					</Button>
					<ComboBox Name="CmbTagUser"
							  DockPanel.Dock="Right"
							  MinWidth="120" Padding="4,2"
							  FontSize="11"
							  Focusable="False"
							  Margin="6,0,0,0"
							  ToolTip.Tip="Whose tags to display"/>
					<StackPanel Name="CodeBarSlots" Orientation="Horizontal" Spacing="4"
								VerticalAlignment="Center"/>
				</DockPanel>
			</Border>

			<!-- Coding Mode toggle when NOT in coding mode (compact) -->
			<StackPanel Name="CodingToggleRow" Orientation="Horizontal" Margin="0,4,0,0"
						HorizontalAlignment="Left">
				<ToggleButton Name="BtnCodingModeCompact"
							  Content="Tagging (F2)"
							  Padding="8,2"
							  FontSize="11"
							  Focusable="False"
							  ToolTip.Tip="Toggle coding mode (F2). Keys: W=select block, 1-9=apply tag, E=expand, Q=shrink, Tab=next untagged, hold Space+number=multi-tag"/>
			</StackPanel>

		<!-- Notes panel -->
		<Border Name="NotesPanel"
				IsVisible="False"
				Background="{DynamicResource ControlBg}"
				BorderBrush="{DynamicResource BorderBrush}"
				BorderThickness="1"
				CornerRadius="8"
				Margin="0,8,0,0"
				Padding="10">

			<!-- Added a 3rd row for footer buttons -->
			<Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto">
				<TextBlock Name="NotesHeader"
						   Grid.Row="0"
						   Grid.Column="0"
						   FontWeight="SemiBold"
						   Text="Note" />

				<StackPanel Grid.Row="0"
							Grid.Column="1"
							Orientation="Horizontal"
							Spacing="6">
					<Button Name="BtnDeleteCommunityNote"
							Content="Delete"
							Padding="10,2"
							Focusable="False"
							IsVisible="False"
							ToolTip.Tip="Delete this community note"/>
					<Button Name="BtnCloseNotes"
							Content="✕"
							Padding="8,2"
							Focusable="False"
							ToolTip.Tip="Close the notes panel"/>
				</StackPanel>

				<ScrollViewer Grid.Row="1"
							  Grid.ColumnSpan="2"
							  MaxHeight="160"
							  VerticalScrollBarVisibility="Auto"
							  HorizontalScrollBarVisibility="Disabled">
					<TextBox Name="NotesBody"
							 IsReadOnly="True"
							 AcceptsReturn="True"
							 TextWrapping="Wrap"
							 Background="Transparent"
							 BorderThickness="0"/>
				</ScrollViewer>

				<!-- Footer actions -->
				<StackPanel Grid.Row="2"
							Grid.ColumnSpan="2"
							Orientation="Horizontal"
							HorizontalAlignment="Right"
							Spacing="8"
							Margin="0,8,0,0">
					<Button Name="BtnMoveFootnote"
							Content="Move footnote"
							Padding="10,2"
							Focusable="False"
							IsVisible="False"
							IsEnabled="False"
							ToolTip.Tip="Move this footnote to a new position in the text"/>
				</StackPanel>
			</Grid>

		</Border>

		</StackPanel> <!-- end coding mode + notes wrapper -->

	</Grid>
</UserControl>
