<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ReadZen.App.Views.ResearchGraphWindow"
        x:CompileBindings="False"
        Title="Research Graph"
        Width="1100" Height="650"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual"
        CanResize="True">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ROW 0: Toolbar -->
    <Border Grid.Row="0" Padding="8,6" BorderThickness="0,0,0,1"
            BorderBrush="#3A3A42" Background="#252529">
      <DockPanel LastChildFill="False">
        <!-- Left: Collection + Add nodes -->
        <ComboBox DockPanel.Dock="Left" Name="CmbCollection" MinWidth="200" Margin="0,0,12,0">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button DockPanel.Dock="Left" Name="BtnBack" Content="&#x2190; Back" Padding="6,3"
                Margin="0,0,12,0" FontSize="11" IsVisible="False"
                ToolTip.Tip="Return to previous collection"/>
        <Border DockPanel.Dock="Left" Width="1" Height="20" Background="#3A3A42" Margin="0,0,12,0"/>
        <Button DockPanel.Dock="Left" Name="BtnAddPassage" Content="+ Passage" Padding="6,3" Margin="0,0,2,0" FontSize="11"
                Background="#3A3520" Foreground="#FFD700" BorderBrush="#5A5530" BorderThickness="1"/>
        <Button DockPanel.Dock="Left" Name="BtnAddConcept" Content="+ Concept" Padding="6,3" Margin="0,0,2,0" FontSize="11"
                ToolTip.Tip="Add Concept (Ctrl+Shift+C)"/>
        <Button DockPanel.Dock="Left" Name="BtnAddMaster" Content="+ Master" Padding="6,3" Margin="0,0,2,0" FontSize="11"/>
        <Button DockPanel.Dock="Left" Name="BtnAddTerm" Content="+ Term" Padding="6,3" Margin="0,0,2,0" FontSize="11"/>
        <Button DockPanel.Dock="Left" Name="BtnAddCollection" Content="+ Collection" Padding="6,3" Margin="0,0,12,0" FontSize="11"/>
        <Border DockPanel.Dock="Left" Width="1" Height="20" Background="#3A3A42" Margin="0,0,12,0"/>

        <!-- Center: Layout controls -->
        <Button DockPanel.Dock="Left" Name="BtnRelayout" Content="Relayout" Padding="6,3" Margin="0,0,4,0" FontSize="11"
                Background="#2A2A35" Foreground="#B8B8C8"/>
        <Button DockPanel.Dock="Left" Name="BtnFitView" Content="Fit" Padding="6,3" Margin="0,0,12,0" FontSize="11"
                ToolTip.Tip="Fit all nodes to view"/>
        <Border DockPanel.Dock="Left" Width="1" Height="20" Background="#3A3A42" Margin="0,0,12,0"/>
        <ToggleButton DockPanel.Dock="Left" Name="BtnLinkMode" Content="Link Mode" Padding="6,3" Margin="0,0,4,0" FontSize="11"/>
        <ToggleButton DockPanel.Dock="Left" Name="BtnPhysics" Content="Physics" IsChecked="False"
                      Padding="6,3" Margin="0,0,4,0" FontSize="11"
                      ToolTip.Tip="Toggle continuous physics simulation"/>
        <ToggleButton DockPanel.Dock="Left" Name="BtnLabels" Content="Labels" IsChecked="True"
                      Padding="6,3" Margin="0,0,4,0" FontSize="11"
                      ToolTip.Tip="Show/hide node labels"/>
        <ToggleButton DockPanel.Dock="Left" Name="BtnMinimap" Content="Minimap" IsChecked="True"
                      Padding="6,3" Margin="0,0,4,0" FontSize="11"
                      ToolTip.Tip="Show/hide minimap overlay"/>
        <ToggleButton DockPanel.Dock="Left" Name="BtnClusters" Content="Clusters" IsChecked="False"
                      Padding="6,3" Margin="0,0,12,0" FontSize="11"
                      ToolTip.Tip="Show type-based cluster backgrounds"/>
        <Border DockPanel.Dock="Left" Width="1" Height="20" Background="#3A3A42" Margin="0,0,12,0"/>

        <!-- Right: Search + Overflow -->
        <Button DockPanel.Dock="Right" Name="BtnOverflow" Content="&#x22EF;" Padding="8,3"/>
        <TextBox DockPanel.Dock="Right" Name="TxtSearch" Watermark="Search nodes..." Width="180" Margin="0,0,8,0" FontSize="11"
                 ToolTip.Tip="Search nodes (Ctrl+F)"/>

        <!-- Undo/Redo -->
        <Button DockPanel.Dock="Right" Name="BtnRedo" Content="&#x21B7;" Padding="6,3" Margin="0,0,2,0" ToolTip.Tip="Redo (Ctrl+Y)"/>
        <Button DockPanel.Dock="Right" Name="BtnUndo" Content="&#x21B6;" Padding="6,3" Margin="0,0,8,0" ToolTip.Tip="Undo (Ctrl+Z)"/>
      </DockPanel>
    </Border>

    <!-- ROW 1: Main Content -->
    <Grid Grid.Row="1" ColumnDefinitions="240,Auto,*,Auto,320">

      <!-- Left: Filters/Stats/Legend tabs -->
      <Border Grid.Column="0" BorderThickness="0,0,1,0"
              BorderBrush="#3A3A42" Background="#1E1E23">
        <TabControl Name="LeftTabs" TabStripPlacement="Top">
          <TabItem Header="Filters">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
              <StackPanel Name="FilterPanel" Spacing="8"/>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Stats">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
              <StackPanel Name="StatsPanel" Spacing="8"/>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Legend">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
              <StackPanel Name="LegendPanel" Spacing="8"/>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Border>

      <!-- Splitter -->
      <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns"/>

      <!-- Center: Graph Canvas -->
      <Grid Grid.Column="2" ClipToBounds="True" Name="CanvasHost">
        <!-- Canvas control will be added in code-behind -->

        <!-- Empty state overlay (shown when graph is empty) -->
        <Border Name="EmptyStateOverlay" IsVisible="True" Padding="40"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="16" MaxWidth="500" HorizontalAlignment="Center">
            <TextBlock Text="Research Graph" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FFD700"/>
            <TextBlock Text="Build a disciplined knowledge graph over your Zen text research. Connect passages to concepts, trace lineages, and discover patterns."
                       TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7"/>

            <StackPanel Spacing="10" Margin="0,12,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="22" Height="22" CornerRadius="11" Background="#3A3520" VerticalAlignment="Center">
                  <TextBlock Text="1" FontSize="11" Foreground="#FFD700" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Add passages from your collection to the graph" Opacity="0.8" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="22" Height="22" CornerRadius="11" Background="#3A3520" VerticalAlignment="Center">
                  <TextBlock Text="2" FontSize="11" Foreground="#FFD700" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Create concepts &#x2014; name the patterns you see" Opacity="0.8" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="22" Height="22" CornerRadius="11" Background="#3A3520" VerticalAlignment="Center">
                  <TextBlock Text="3" FontSize="11" Foreground="#FFD700" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Draw edges between nodes to build your meaning web" Opacity="0.8" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,12,0,0">
              <Button Name="BtnEmptyAddPassages" Content="Add Passages" Padding="12,6"/>
              <Button Name="BtnEmptyAddConcept" Content="Create First Concept" Padding="12,6"/>
            </StackPanel>

            <Border Margin="0,16,0,0" Padding="12" CornerRadius="6" Opacity="0.8"
                    BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}">
              <StackPanel Spacing="4">
                <TextBlock Text="No passages yet? No problem." FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Text="Browse community collections in the Scholar tab &#x2014; view other scholars' research graphs, passages, and concept maps. The Scholar tab works even without your own snippets."
                           TextWrapping="Wrap" FontSize="11" Opacity="0.8"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Splitter -->
      <GridSplitter Grid.Column="3" Width="6" ResizeDirection="Columns"/>

      <!-- Right: Inspector -->
      <Border Grid.Column="4" BorderThickness="1,0,0,0"
              BorderBrush="#3A3A42" Background="#1E1E23">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border Grid.Row="0" Padding="12,8" BorderThickness="0,0,0,1"
                  BorderBrush="#3A3A42" Background="#252529">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Name="InspectorTitle" Text="Inspector" FontWeight="SemiBold" Foreground="#FFD700"/>
            </DockPanel>
          </Border>
          <ScrollViewer Grid.Row="1" Padding="12">
            <StackPanel Name="InspectorContent" Spacing="8">
              <!-- Empty state -->
              <TextBlock Name="InspectorEmpty" Text="Click a node to inspect" Opacity="0.5"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40"/>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Name="InspectorActions" Orientation="Horizontal" Spacing="4" Margin="12,4"/>
        </Grid>
      </Border>
    </Grid>

    <!-- ROW 2: Status Bar -->
    <Border Grid.Row="2" Padding="8,4" BorderThickness="0,1,0,0"
            BorderBrush="#3A3A42" Background="#1A1A1F">
      <DockPanel LastChildFill="False">
        <TextBlock DockPanel.Dock="Left" Name="TxtStatus" Text="Ready" FontSize="11" Opacity="0.7"/>
        <TextBlock DockPanel.Dock="Right" Name="TxtNodeCount" Text="0 nodes, 0 edges" FontSize="11" Opacity="0.7"/>
        <TextBlock DockPanel.Dock="Right" Name="TxtQuality" Text="" FontSize="11" Opacity="0.7" Margin="0,0,16,0"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
