<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ReadZen.App.ViewModels"
             x:Class="ReadZen.App.Views.GitTabView"
             x:DataType="vm:GitTabViewModel">

	<UserControl.Styles>
		<!-- Panic button styling -->
		<Style Selector="Button.panic">
			<Setter Property="Background" Value="#FF3A0F0F"/>
			<Setter Property="BorderBrush" Value="#FF6B1A1A"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="#FFF2EAEA"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="12,7"/>
			<Setter Property="FontFamily" Value="Space Mono, Consolas, Menlo, Courier New"/>
		</Style>

		<Style Selector="Button.panic:pointerover /template/ ContentPresenter">
			<Setter Property="Opacity" Value="0.95"/>
		</Style>

		<Style Selector="Button.panic:pressed /template/ ContentPresenter">
			<Setter Property="Opacity" Value="0.90"/>
		</Style>

	</UserControl.Styles>

	<Grid RowDefinitions="Auto,Auto,Auto,8,*,Auto"
		  ColumnDefinitions="*,Auto"
		  Margin="8"
		  RowSpacing="4"
		  ColumnSpacing="8">

		<!-- Row 0: Repo location + Pick Location (small, unobtrusive) -->
		<TextBlock Grid.Row="0"
				   Grid.Column="0"
				   Text="{Binding DestText}"
				   VerticalAlignment="Center"/>

		<Button Grid.Row="0"
				Grid.Column="1"
				Content="Pick Location"
				Command="{Binding PickDestCommand}"
				IsEnabled="{Binding IsNotBusy}"
				Padding="8,3"/>

		<!-- Row 1: ONE BIG SYNC BUTTON + small Cancel -->
		<StackPanel Grid.Row="1" Grid.ColumnSpan="2"
					Orientation="Horizontal"
					HorizontalAlignment="Center"
					Spacing="8"
					Margin="0,8">
			<Button Name="BtnGitSync"
					Content="Sync"
					Command="{Binding SyncCommand}"
					IsEnabled="{Binding IsNotBusy}"
					FontSize="20"
					FontWeight="Bold"
					Padding="48,14"
					ToolTip.Tip="One click: updates texts, shares your work (translations, termbase, collections, reviews), and pulls the latest from other contributors. If no repo exists, clones it first."/>
			<Button Content="Cancel"
					Command="{Binding CancelCommand}"
					IsEnabled="{Binding IsBusy}"
					Padding="8,6"
					VerticalAlignment="Center"
					ToolTip.Tip="Cancel the running sync operation"/>
		</StackPanel>

		<!-- Row 2: Advanced (collapsed by default) -->
		<Expander Grid.Row="2" Grid.ColumnSpan="2" IsExpanded="False" Margin="0,2">
			<Expander.Header>
				<TextBlock Text="Advanced" FontWeight="SemiBold"/>
			</Expander.Header>
			<StackPanel Spacing="6" Margin="0,4,0,0">
				<WrapPanel Orientation="Horizontal">
					<Button Classes="panic"
							Content="Reset to Last Sync"
							Command="{Binding PanicResetCommand}"
							IsEnabled="{Binding IsNotBusy}"
							Padding="8,3"
							ToolTip.Tip="Permanently discard all unsaved local changes. This cannot be undone."/>
				</WrapPanel>
			</StackPanel>
		</Expander>
		<!-- Row 3: GridSplitter -->
		<GridSplitter Grid.Row="3" Grid.ColumnSpan="2" Height="8"
					  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
					  Background="Transparent" Cursor="SizeNorthSouth"
					  ToolTip.Tip="Drag to resize log area"/>

		<!-- Row 4: Log -->
		<Border Grid.Row="4"
				Grid.ColumnSpan="2"
				CornerRadius="6"
				BorderThickness="1"
				Background="{DynamicResource PanelBg}"
				BorderBrush="{DynamicResource PanelBorder}">
			<ScrollViewer HorizontalScrollBarVisibility="Auto"
						  VerticalScrollBarVisibility="Auto">
				<TextBox Name="TxtLog"
						 AcceptsReturn="True"
						 IsReadOnly="True"
						 TextWrapping="NoWrap"
						 MinHeight="240"
						 Padding="8"
						 Background="Transparent"
						 BorderThickness="0"
						 FontFamily="Consolas, Menlo, 'DejaVu Sans Mono', 'Liberation Mono', monospace"
						 Text="{Binding LogText}"/>
			</ScrollViewer>
		</Border>

		<!-- Empty state overlay -->
		<Panel Grid.Row="4" Grid.ColumnSpan="2"
			   IsVisible="{Binding !LogText.Length}"
			   IsHitTestVisible="False">
			<TextBlock Text="Open a text corpus folder to get started.&#x0a;Use the Community tab to share your work."
					   HorizontalAlignment="Center"
					   VerticalAlignment="Center"
					   TextAlignment="Center"
					   Opacity="0.5"
					   FontSize="14"
					   Margin="0,40,0,0"/>
		</Panel>

		<!-- Row 5: Progress -->
		<TextBlock Grid.Row="5"
				   Grid.ColumnSpan="2"
				   Text="{Binding ProgressText}"
				   Opacity="0.8"
				   Classes="muted"/>

	</Grid>
</UserControl>

