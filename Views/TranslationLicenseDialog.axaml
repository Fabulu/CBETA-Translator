<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ReadZen.App.Views.TranslationLicenseDialog"
        Title="License Your Translation"
        Width="560" Height="600"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource BarBg}">
            <StackPanel Spacing="4">
                <TextBlock Name="TxtHeader" FontWeight="Bold" FontSize="15"
                           Text="License Your Translation"/>
                <TextBlock Name="TxtSourceInfo" FontSize="11" Opacity="0.8" TextWrapping="Wrap"/>
                <TextBlock FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                           Text="As the translator, you hold copyright over your creative work. The source license determines which licenses you can choose."/>
            </StackPanel>
        </Border>

        <!-- License options -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Name="OptionsHost" Spacing="4" Margin="12,8"/>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="12,8">
            <Button Name="BtnDecideLater" Content="I'll decide later"
                    FontSize="11" Padding="10,5" Opacity="0.7"/>
            <Button Name="BtnChoose" Content="Choose This License"
                    FontSize="12" Padding="14,6" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
