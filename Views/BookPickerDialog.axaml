<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ReadZen.App.Views"
        x:Class="ReadZen.App.Views.BookPickerDialog"
        Title="Add Book to Graph"
        Width="420" Height="500"
        WindowStartupLocation="CenterOwner" CanResize="False">
  <Grid RowDefinitions="Auto,*,Auto" Margin="12">
    <TextBox Grid.Row="0" Name="TxtSearch" Watermark="Search texts (English or Chinese)..." Margin="0,0,0,8"/>
    <ListBox Grid.Row="1" Name="LstBooks" SelectionMode="Single">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="views:BookPickerDialog+BookEntry">
          <StackPanel Spacing="1" Margin="4,3">
            <TextBlock Text="{Binding DisplayShort}" FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="10" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button Name="BtnCancel" Content="Cancel" Padding="12,6"/>
      <Button Name="BtnOk" Content="OK" Padding="12,6"/>
    </StackPanel>
  </Grid>
</Window>
