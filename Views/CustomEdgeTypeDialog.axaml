<!-- Views/CustomEdgeTypeDialog.axaml -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ReadZen.App.Views.CustomEdgeTypeDialog"
        Width="380" Height="320"
        Background="{DynamicResource AppBg}"
        Title="Create Custom Edge Type"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

	<Window.Styles>
		<Style Selector="Button.primary">
			<Setter Property="Background" Value="{DynamicResource SelectionBg}"/>
			<Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
		</Style>
		<Style Selector="Button">
			<Setter Property="Background" Value="{DynamicResource BtnBg}"/>
			<Setter Property="Foreground" Value="{DynamicResource BtnFg}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="20">

		<!-- Name -->
		<StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
			<TextBlock Text="Name"
			           FontSize="12" FontWeight="SemiBold"
			           Foreground="{DynamicResource TextFg}"/>
			<TextBox Name="TxtName"
			         Watermark="e.g. inspired-by, responds-to..."
			         FontSize="13"/>
		</StackPanel>

		<!-- Color swatches -->
		<StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,12">
			<TextBlock Text="Color"
			           FontSize="12" FontWeight="SemiBold"
			           Foreground="{DynamicResource TextFg}"/>
			<StackPanel Name="SwatchPanel" Orientation="Horizontal" Spacing="8"/>
		</StackPanel>

		<!-- Directional toggle -->
		<StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,12">
			<CheckBox Name="ChkDirectional"
			          IsChecked="True"
			          FontSize="13"
			          Foreground="{DynamicResource TextFg}">
				<TextBlock Text="Directional (A -> B, not A -- B)" FontSize="13"/>
			</CheckBox>
		</StackPanel>

		<!-- Spacer -->
		<Panel Grid.Row="3"/>

		<!-- Buttons -->
		<StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
			<Button Content="Cancel"
			        Width="80" Height="32"
			        Name="BtnCancel"/>
			<Button Content="OK"
			        Width="80" Height="32"
			        Classes="primary"
			        IsDefault="True"
			        Name="BtnOk"/>
		</StackPanel>
	</Grid>

</Window>
