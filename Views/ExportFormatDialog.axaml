<!-- Views/ExportFormatDialog.axaml -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ReadZen.App.Views.ExportFormatDialog"
        Width="360" Height="760"
        Background="{DynamicResource AppBg}"
        Title="Export Scholar Data"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

	<Window.Styles>
		<Style Selector="Button.primary">
			<Setter Property="Background" Value="{DynamicResource SelectionBg}"/>
			<Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
		</Style>
		<Style Selector="Button">
			<Setter Property="Background" Value="{DynamicResource BtnBg}"/>
			<Setter Property="Foreground" Value="{DynamicResource BtnFg}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20">

		<TextBlock Grid.Row="0"
				   Text="Choose export format"
				   FontSize="15"
				   FontWeight="SemiBold"
				   Foreground="{DynamicResource TextFg}"
				   Margin="0,0,0,14"/>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
			<StackPanel Spacing="10">
				<RadioButton Name="RbHtml"
						 IsChecked="True"
						 GroupName="Format"
						 Foreground="{DynamicResource TextFg}">
					<StackPanel Spacing="2">
						<TextBlock Text="HTML" FontWeight="SemiBold"/>
						<TextBlock Text="Rich formatted document with bilingual layout and cross-reference graph"
								   FontSize="11"
								   Foreground="{DynamicResource TextMutedFg}"
								   TextWrapping="Wrap"/>
					</StackPanel>
				</RadioButton>

				<RadioButton Name="RbMarkdown"
						 GroupName="Format"
						 Foreground="{DynamicResource TextFg}">
					<StackPanel Spacing="2">
						<TextBlock Text="Markdown" FontWeight="SemiBold"/>
						<TextBlock Text="Academic writing format, easy to paste into papers"
								   FontSize="11"
								   Foreground="{DynamicResource TextMutedFg}"
								   TextWrapping="Wrap"/>
					</StackPanel>
				</RadioButton>

				<RadioButton Name="RbPlainText"
						 GroupName="Format"
						 Foreground="{DynamicResource TextFg}">
					<StackPanel Spacing="2">
						<TextBlock Text="Plain Text" FontWeight="SemiBold"/>
						<TextBlock Text="Simple text, no formatting"
								   FontSize="11"
								   Foreground="{DynamicResource TextMutedFg}"
								   TextWrapping="Wrap"/>
					</StackPanel>
				</RadioButton>

				<RadioButton Name="RbCsv"
						 GroupName="Format"
						 Foreground="{DynamicResource TextFg}">
					<StackPanel Spacing="2">
						<TextBlock Text="CSV" FontWeight="SemiBold"/>
						<TextBlock Text="Spreadsheet export with one row per passage"
								   FontSize="11"
								   Foreground="{DynamicResource TextMutedFg}"
								   TextWrapping="Wrap"/>
					</StackPanel>
				</RadioButton>

				<RadioButton Name="RbTsv"
						 GroupName="Format"
						 Foreground="{DynamicResource TextFg}">
					<StackPanel Spacing="2">
						<TextBlock Text="TSV" FontWeight="SemiBold"/>
						<TextBlock Text="Tab-separated export for research tools and spreadsheet cleanup"
								   FontSize="11"
								   Foreground="{DynamicResource TextMutedFg}"
								   TextWrapping="Wrap"/>
					</StackPanel>
				</RadioButton>

				<RadioButton Name="RbReaderTagBundle"
						 GroupName="Format"
						 Foreground="{DynamicResource TextFg}">
					<StackPanel Spacing="2">
						<TextBlock Text="Reader Tags Bundle (.json)" FontWeight="SemiBold"/>
						<TextBlock Text="Structured Reader tag interchange for the selected collection, with vocabulary and skipped-item report"
								   FontSize="11"
								   Foreground="{DynamicResource TextMutedFg}"
								   TextWrapping="Wrap"/>
					</StackPanel>
				</RadioButton>

				<RadioButton Name="RbReaderTagTsv"
						 GroupName="Format"
						 Foreground="{DynamicResource TextFg}">
					<StackPanel Spacing="2">
						<TextBlock Text="Reader Tags TSV (.tsv)" FontWeight="SemiBold"/>
						<TextBlock Text="Reader-oriented tag rows plus a companion vocabulary JSON sidecar in the same folder"
								   FontSize="11"
								   Foreground="{DynamicResource TextMutedFg}"
								   TextWrapping="Wrap"/>
					</StackPanel>
				</RadioButton>

				<RadioButton Name="RbPaperDraft"
						 GroupName="Format"
						 Foreground="{DynamicResource TextFg}">
					<StackPanel Spacing="2">
						<TextBlock Text="Paper Draft (.md)" FontWeight="SemiBold"/>
						<TextBlock Text="Editable research draft scaffold from the selected collection, not a finished paper"
								   FontSize="11"
								   Foreground="{DynamicResource TextMutedFg}"
								   TextWrapping="Wrap"/>
					</StackPanel>
				</RadioButton>

				<RadioButton Name="RbBibTex"
						 GroupName="Format"
						 Foreground="{DynamicResource TextFg}">
					<StackPanel Spacing="2">
						<TextBlock Text="BibTeX (.bib)" FontWeight="SemiBold"/>
						<TextBlock Text="One entry per passage; uses @incollection for CBETA texts with Taisho metadata"
								   FontSize="11"
								   Foreground="{DynamicResource TextMutedFg}"
								   TextWrapping="Wrap"/>
					</StackPanel>
				</RadioButton>

				<RadioButton Name="RbRis"
						 GroupName="Format"
						 Foreground="{DynamicResource TextFg}">
					<StackPanel Spacing="2">
						<TextBlock Text="RIS (.ris)" FontWeight="SemiBold"/>
						<TextBlock Text="Reference manager import format for Zotero, Mendeley, and EndNote"
								   FontSize="11"
								   Foreground="{DynamicResource TextMutedFg}"
								   TextWrapping="Wrap"/>
					</StackPanel>
				</RadioButton>

				<RadioButton Name="RbCslJson"
						 GroupName="Format"
						 Foreground="{DynamicResource TextFg}">
					<StackPanel Spacing="2">
						<TextBlock Text="CSL-JSON (.json)" FontWeight="SemiBold"/>
						<TextBlock Text="Citation-manager export with one item per passage in the selected collection"
								   FontSize="11"
								   Foreground="{DynamicResource TextMutedFg}"
								   TextWrapping="Wrap"/>
					</StackPanel>
				</RadioButton>

				<RadioButton Name="RbJson"
						 GroupName="Format"
						 Foreground="{DynamicResource TextFg}">
					<StackPanel Spacing="2">
						<TextBlock Text="JSON (all collections)" FontWeight="SemiBold"/>
						<TextBlock Text="Structured archive export of every collection"
								   FontSize="11"
								   Foreground="{DynamicResource TextMutedFg}"
								   TextWrapping="Wrap"/>
					</StackPanel>
				</RadioButton>
			</StackPanel>
		</ScrollViewer>

		<StackPanel Grid.Row="2" Margin="0,14,0,0" Spacing="4"
					Name="CitationStylePanel">
			<TextBlock Text="Citation style"
					   FontSize="12"
					   FontWeight="SemiBold"
					   Foreground="{DynamicResource TextFg}"/>
			<ComboBox Name="CbCitationStyle"
					  SelectedIndex="1"
					  Width="200"
					  HorizontalAlignment="Left">
				<ComboBoxItem Content="Plain"/>
				<ComboBoxItem Content="Chicago (default)"/>
				<ComboBoxItem Content="APA"/>
				<ComboBoxItem Content="MLA"/>
				<ComboBoxItem Content="SBL"/>
				<ComboBoxItem Content="CBETA Reference"/>
			</ComboBox>
			<TextBlock Text="Applied to inline citations in the export"
					   FontSize="11"
					   Foreground="{DynamicResource TextMutedFg}"/>
		</StackPanel>

		<StackPanel Grid.Row="3"
					Orientation="Horizontal"
					HorizontalAlignment="Right"
					Spacing="10"
					Margin="0,14,0,0">
			<Button Content="Cancel"
					Width="90" Height="32"
					Name="BtnCancel"
					ToolTip.Tip="Cancel export"/>
			<Button Content="Export"
					Width="90" Height="32"
					Classes="primary"
					Name="BtnOk"
					ToolTip.Tip="Export in the selected format"/>
		</StackPanel>
	</Grid>

</Window>
