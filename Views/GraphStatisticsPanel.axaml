<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ReadZen.App.Views.GraphStatisticsPanel">
  <StackPanel Spacing="8" Margin="4">
    <TextBlock Text="Research Quality" FontWeight="SemiBold" FontSize="12"/>
    <TextBlock Name="TxtOrphans" Text="Orphan passages: 0" FontSize="11"/>
    <TextBlock Name="TxtOrphanConcepts" Text="Orphan concepts: 0" FontSize="11"/>
    <TextBlock Name="TxtOverloaded" Text="Overloaded concepts: 0" FontSize="11"/>
    <TextBlock Name="TxtWeak" Text="Weak concepts: 0" FontSize="11"/>
    <ProgressBar Name="QualityBar" Value="100" Maximum="100" Height="8" Margin="0,8,0,0"/>
    <TextBlock Name="TxtQuality" Text="Quality: 100%" FontSize="11" FontWeight="SemiBold"/>
  </StackPanel>
</UserControl>
