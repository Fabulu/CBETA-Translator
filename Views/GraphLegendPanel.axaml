<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ReadZen.App.Views.GraphLegendPanel">
  <StackPanel Spacing="12" Margin="4">
    <TextBlock Text="Node Types" FontWeight="SemiBold" FontSize="12"/>

    <StackPanel Orientation="Horizontal" Spacing="6">
      <Ellipse Width="12" Height="12" Fill="#6EAFF8"/>
      <TextBlock Text="Passage — source text" FontSize="10" VerticalAlignment="Center"/>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="6">
      <Border Width="12" Height="12" Background="#FF8A65" CornerRadius="2">
        <Border.RenderTransform>
          <RotateTransform Angle="45"/>
        </Border.RenderTransform>
      </Border>
      <TextBlock Text="Concept — thematic node" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"/>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="6">
      <Polygon Points="6,0 12,4 10,11 2,11 0,4" Fill="#64B5F6" Width="12" Height="12"/>
      <TextBlock Text="Master — Zen teacher" FontSize="10" VerticalAlignment="Center"/>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="6">
      <Border Width="16" Height="10" Background="#81C784" CornerRadius="3"/>
      <TextBlock Text="Term — termbase entry" FontSize="10" VerticalAlignment="Center"/>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="6">
      <Border Width="12" Height="12" Background="#AB47BC" CornerRadius="1"/>
      <TextBlock Text="Collection — passage group" FontSize="10" VerticalAlignment="Center"/>
    </StackPanel>

    <TextBlock Text="Edge Colors" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0"/>
    <StackPanel Name="EdgeLegendPanel" Spacing="4"/>
  </StackPanel>
</UserControl>
