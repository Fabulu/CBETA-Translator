      "sourceTerm": "即心是佛",
      "senseIndex": 1,
      "occurrenceIndex": 3,
      "relPath": "J/J23/J23nB134.xml",
      "kind": "headword-free-kwic",
      "kwic": "若言即心即佛，權且認奴作郎；生死涅槃，恰似斬頭覓活。"
    },
    {
      "origin": "termbase",
