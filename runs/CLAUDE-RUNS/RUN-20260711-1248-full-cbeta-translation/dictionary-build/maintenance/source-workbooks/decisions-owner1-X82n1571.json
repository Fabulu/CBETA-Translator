      "sourceTerm": "念佛是誰",
      "RelPath": "X/X82/X82n1571.xml",
      "FromLb": "0248c17",
      "Kwic": "法舟掩室於天寧，師往參叩，示以念佛是誰話。一日齋次，食器墜地，豁然有省。",
      "caseClusterId": "X/X82/X82n1571.xml:1786059:1787071",
      "Decision": {
        "MasterName": "Fazhou Daoji",
        "ActorAttribution": null,
        "ContextMasters": [
          {
            "MasterName": "Yungu Fahui",
            "Roles": [
              "recipient",
              "student",
              "section-subject"
            ]
          }
        ],
